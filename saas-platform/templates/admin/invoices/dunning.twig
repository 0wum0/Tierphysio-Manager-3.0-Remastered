{% extends 'layouts/base.twig' %}

{% block content %}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/invoices/{{ invoice.id }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Zurück</a>
    <div>
        <h5 class="mb-0 fw-700">Mahnwesen</h5>
        <div class="text-muted fs-sm">Rechnung <strong>{{ invoice.invoice_number }}</strong> –
            {% set statusLabels = {'draft':'Entwurf','open':'Offen','paid':'Bezahlt','overdue':'Überfällig','cancelled':'Storniert'} %}
            <span class="badge-inv badge-inv-{{ invoice.status }}">{{ statusLabels[invoice.status] ?? invoice.status }}</span>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">

        {# Mahnhistorie #}
        <div class="card mb-4">
            <div class="card-header px-4 py-3 d-flex justify-content-between align-items-center">
                <span class="fw-600"><i class="bi bi-exclamation-triangle me-2 text-warning"></i>Mahnhistorie</span>
                <span class="badge bg-secondary">{{ dunnings|length }} Mahnung(en)</span>
            </div>
            {% if dunnings %}
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="fs-xs text-muted">
                        <tr>
                            <th class="px-4">Stufe</th>
                            <th>Fälligkeitsdatum</th>
                            <th>Mahngebühr</th>
                            <th>Gesendet am</th>
                            <th>Gesendet an</th>
                            <th>Erstellt</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for d in dunnings %}
                        {% set levelColors = {1: 'warning', 2: 'orange', 3: 'danger'} %}
                        <tr>
                            <td class="px-4">
                                <span class="badge bg-{{ levelColors[d.level] ?? 'secondary' }}">
                                    Stufe {{ d.level }}
                                    {% if d.level == 1 %}(Erinnerung)
                                    {% elseif d.level == 2 %}(1. Mahnung)
                                    {% else %}(Letzte Mahnung){% endif %}
                                </span>
                            </td>
                            <td class="fs-sm">{{ d.due_date ? d.due_date|date('d.m.Y') : '—' }}</td>
                            <td class="fs-sm">
                                {% if d.fee > 0 %}
                                    <span class="text-warning">{{ d.fee|number_format(2,',','.') }} €</span>
                                {% else %}
                                    <span class="text-muted">0,00 €</span>
                                {% endif %}
                            </td>
                            <td class="fs-sm">
                                {% if d.sent_at %}
                                    <span class="text-success"><i class="bi bi-check-circle me-1"></i>{{ d.sent_at|date('d.m.Y H:i') }}</span>
                                {% else %}
                                    <span class="text-muted">Nicht gesendet</span>
                                {% endif %}
                            </td>
                            <td class="text-muted fs-xs">{{ d.sent_to ?? '—' }}</td>
                            <td class="text-muted fs-xs">{{ d.created_at|date('d.m.Y H:i') }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="card-body px-4 py-4 text-center text-muted fs-sm">
                <i class="bi bi-inbox fs-3 d-block mb-2 opacity-25"></i>
                Noch keine Mahnungen für diese Rechnung.
            </div>
            {% endif %}
        </div>

        {# Neue Mahnung erstellen #}
        {% if invoice.status not in ['paid','cancelled'] %}
        <div class="card">
            <div class="card-header px-4 py-3">
                <span class="fw-600"><i class="bi bi-plus-circle me-2"></i>Neue Mahnung erstellen</span>
            </div>
            <div class="card-body px-4 py-3">
                <form method="POST" action="/admin/invoices/{{ invoice.id }}/dunning">
                    {{ csrf_field()|raw }}

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-600">Mahnungsstufe</label>
                            <select name="level" class="form-select">
                                <option value="1">Stufe 1 – Zahlungserinnerung</option>
                                <option value="2">Stufe 2 – 1. Mahnung</option>
                                <option value="3">Stufe 3 – Letzte Mahnung</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-600">Mahngebühr (€)</label>
                            <input type="number" name="fee" class="form-control" step="0.01" min="0" value="0.00">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-600">Fällig bis</label>
                            <input type="date" name="due_date" class="form-control"
                                value="{{ 'now'|date('Y-m-d', '+7 days') ?? '' }}"
                                min="{{ 'now'|date('Y-m-d') }}">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="send_email" id="sendEmail" value="1">
                                <label class="form-check-label fs-sm" for="sendEmail">Per E-Mail senden</label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2 justify-content-end">
                        <a href="/admin/invoices/{{ invoice.id }}" class="btn btn-outline-secondary">Abbrechen</a>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-exclamation-triangle me-1"></i>Mahnung erstellen
                        </button>
                    </div>
                </form>
            </div>
        </div>
        {% endif %}

    </div>

    <div class="col-lg-4">

        {# Rechnungsinfo #}
        <div class="card mb-3">
            <div class="card-header px-4 py-3">
                <span class="text-muted fs-xs fw-700 text-uppercase" style="letter-spacing:.08em;"><i class="bi bi-receipt me-1"></i>Rechnung</span>
            </div>
            <div class="card-body px-4 py-3">
                <div class="d-flex justify-content-between py-2 border-bottom fs-sm"><span class="text-muted">Nr.</span><strong>{{ invoice.invoice_number }}</strong></div>
                <div class="d-flex justify-content-between py-2 border-bottom fs-sm"><span class="text-muted">Betrag</span><span class="fw-700 text-danger">{{ invoice.total_gross|number_format(2,',','.') }} €</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom fs-sm"><span class="text-muted">Fällig</span>
                    <span class="{% if invoice.status == 'overdue' %}text-danger{% endif %}">
                        {{ invoice.due_date ? invoice.due_date|date('d.m.Y') : '—' }}
                    </span>
                </div>
                <div class="d-flex justify-content-between py-2 fs-sm"><span class="text-muted">Kunde</span><span>{{ invoice.tenant_name ?? invoice.owner_name }}</span></div>
            </div>
        </div>

        {# Aktionen #}
        <div class="card">
            <div class="card-body px-4 py-3">
                <div class="d-grid gap-2">
                    <a href="/admin/invoices/{{ invoice.id }}/pdf" target="_blank" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-file-pdf me-1"></i>PDF herunterladen
                    </a>
                    <form method="POST" action="/admin/invoices/{{ invoice.id }}/send-email">
                        {{ csrf_field()|raw }}
                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                            <i class="bi bi-envelope me-1"></i>Rechnung per E-Mail senden
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

{% endblock %}
