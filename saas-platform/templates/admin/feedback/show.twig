{% extends 'layouts/base.twig' %}

{% block content %}
{% set statusLabels = {'open':'Offen','in_progress':'In Bearbeitung','resolved':'Erledigt','closed':'Geschlossen'} %}
{% set statusColors = {'open':'warning','in_progress':'primary','resolved':'success','closed':'secondary'} %}
{% set typeIcons    = {'bug':'🐛','feature':'💡','support':'🆘','question':'❓','praise':'⭐','other':'💬'} %}
{% set prioColors   = {'low':'secondary','normal':'info','high':'warning','critical':'danger'} %}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a href="/admin/feedback" class="btn btn-sm btn-outline-secondary">← Zurück</a>
            <h5 class="mb-0 fw-semibold">Feedback #{{ item.id }}</h5>
            <span class="badge bg-{{ statusColors[item.status ?? 'open'] ?? 'secondary' }}">
                {{ statusLabels[item.status ?? 'open'] ?? item.status }}
            </span>
            {% if item.priority and item.priority != 'normal' %}
            <span class="badge bg-{{ prioColors[item.priority] ?? 'secondary' }} bg-opacity-75">{{ item.priority }}</span>
            {% endif %}
        </div>

        <div class="card mb-3">
            <div class="card-header py-3 px-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary bg-opacity-75">
                            {{ typeIcons[item.type ?? item.category] ?? '💬' }} {{ item.type ?? item.category }}
                        </span>
                        {% if item.rating %}
                        <span class="text-warning">{% for s in 1..item.rating %}★{% endfor %}<span class="text-muted">{% for s in 1..(5 - item.rating) %}★{% endfor %}</span></span>
                        {% endif %}
                    </div>
                    <span class="text-muted fs-sm">{{ item.created_at|date('d.m.Y H:i') }}</span>
                </div>
            </div>
            <div class="card-body px-4 py-3">
                {% if item.subject %}
                <div class="fw-semibold fs-sm mb-2">{{ item.subject }}</div>
                {% endif %}

                <div class="row g-3 mb-3">
                    <div class="col-sm-4">
                        <div class="text-muted fs-xs mb-1">Von</div>
                        <div class="fw-600 fs-sm">{{ item.practice_name ?? item.tenant_name ?? 'Anonym' }}</div>
                        {% if item.user_name %}<div class="text-muted fs-xs">{{ item.user_name }}</div>{% endif %}
                        {% if item.tenant_email or item.email %}
                        <div class="text-muted fs-xs">{{ item.tenant_email ?? item.email }}</div>
                        {% endif %}
                    </div>
                    <div class="col-sm-3">
                        <div class="text-muted fs-xs mb-1">Plattform</div>
                        <div class="fs-sm">{{ item.platform ?? 'web' }}</div>
                        {% if item.app_version %}<div class="text-muted fs-xs">v{{ item.app_version }}</div>{% endif %}
                    </div>
                    <div class="col-sm-5">
                        <div class="text-muted fs-xs mb-1">Seite</div>
                        <div class="fs-xs text-muted text-truncate" title="{{ item.current_url }}">{{ item.current_url ?? '–' }}</div>
                        {% if item.user_agent %}
                        <div class="fs-xs text-muted text-truncate mt-1" title="{{ item.user_agent }}" style="opacity:.6;">{{ item.user_agent|slice(0,60) }}…</div>
                        {% endif %}
                    </div>
                </div>

                <hr class="border-secondary">
                <div class="text-muted lh-lg" style="white-space:pre-wrap;">{{ item.message }}</div>

                {% if item.attachment_path %}
                <div class="mt-3">
                    <div class="text-muted fs-xs mb-1">Anhang</div>
                    <a href="/{{ item.attachment_path }}" target="_blank" class="btn btn-sm btn-outline-secondary">📎 Anhang öffnen</a>
                </div>
                {% endif %}
            </div>
        </div>

        {# ── Status & Admin-Notiz ── #}
        <div class="card mb-3">
            <div class="card-header py-2 px-4">
                <span class="fw-semibold fs-sm">Status & interne Notiz</span>
            </div>
            <div class="card-body px-4 py-3">
                <form method="POST" action="/admin/feedback/{{ item.id }}/status">
                    {{ csrf_field()|raw }}
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <label class="form-label fw-500 fs-sm" for="fb-status">Status</label>
                            <select class="form-select form-select-sm" id="fb-status" name="status">
                                <option value="open"        {% if (item.status ?? 'open') == 'open' %}selected{% endif %}>Offen</option>
                                <option value="in_progress" {% if (item.status ?? '') == 'in_progress' %}selected{% endif %}>In Bearbeitung</option>
                                <option value="resolved"    {% if (item.status ?? '') == 'resolved' %}selected{% endif %}>Erledigt</option>
                                <option value="closed"      {% if (item.status ?? '') == 'closed' %}selected{% endif %}>Geschlossen</option>
                            </select>
                        </div>
                        <div class="col-sm-8">
                            <label class="form-label fw-500 fs-sm" for="fb-note">Interne Notiz</label>
                            <input type="text" class="form-control form-control-sm" id="fb-note" name="admin_note"
                                   value="{{ item.admin_note ?? '' }}" placeholder="Interne Bemerkung für das Team…">
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-sm btn-primary">Speichern</button>
                        {% if item.resolved_at %}
                        <span class="text-muted fs-xs ms-3">Erledigt am {{ item.resolved_at|date('d.m.Y H:i') }}</span>
                        {% endif %}
                    </div>
                </form>
            </div>
        </div>

        <div class="d-flex gap-2">
            <form method="POST" action="/admin/feedback/{{ item.id }}/delete" onsubmit="return confirm('Feedback wirklich löschen?')">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <button class="btn btn-sm btn-outline-danger">🗑 Löschen</button>
            </form>
        </div>
    </div>
</div>

{% endblock %}
