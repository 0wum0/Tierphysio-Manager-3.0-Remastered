{% extends 'layouts/base.twig' %}

{% block content %}
{% set statusLabels = {'open':'Offen','in_progress':'In Bearbeitung','resolved':'Erledigt','closed':'Geschlossen'} %}
{% set statusColors = {'open':'warning','in_progress':'primary','resolved':'success','closed':'secondary'} %}
{% set typeIcons    = {'bug':'🐛','feature':'💡','support':'🆘','question':'❓','praise':'⭐','other':'💬'} %}
{% set prioColors   = {'low':'secondary','normal':'info','high':'warning','critical':'danger'} %}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a href="/admin/feedback" class="btn btn-sm btn-outline-secondary">← Zurück</a>
            <h5 class="mb-0 fw-semibold">Feedback #{{ item.id }}</h5>
            <span class="badge bg-{{ statusColors[item.status ?? 'open'] ?? 'secondary' }}">
                {{ statusLabels[item.status ?? 'open'] ?? item.status }}
            </span>
            {% if item.priority and item.priority != 'normal' %}
            <span class="badge bg-{{ prioColors[item.priority] ?? 'secondary' }} bg-opacity-75">{{ item.priority }}</span>
            {% endif %}
        </div>

        <div class="card mb-3">
            <div class="card-header py-3 px-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary bg-opacity-75">
                            {{ typeIcons[item.type ?? item.category] ?? '💬' }} {{ item.type ?? item.category }}
                        </span>
                        {% if item.rating %}
                        <span class="text-warning">{% for s in 1..item.rating %}★{% endfor %}<span class="text-muted">{% for s in 1..(5 - item.rating) %}★{% endfor %}</span></span>
                        {% endif %}
                    </div>
                    <span class="text-muted fs-sm">{{ item.created_at|date('d.m.Y H:i') }}</span>
                </div>
            </div>
            <div class="card-body px-4 py-3">
                {% if item.subject %}
                <div class="fw-semibold fs-sm mb-2">{{ item.subject }}</div>
                {% endif %}

                <div class="row g-3 mb-3">
                    <div class="col-sm-4">
                        <div class="text-muted fs-xs mb-1">Von</div>
                        <div class="fw-600 fs-sm">{{ item.practice_name ?? item.tenant_name ?? 'Anonym' }}</div>
                        {% if item.user_name %}<div class="text-muted fs-xs">{{ item.user_name }}</div>{% endif %}
                        {% if item.tenant_email or item.email %}
                        <div class="text-muted fs-xs">{{ item.tenant_email ?? item.email }}</div>
                        {% endif %}
                    </div>
                    <div class="col-sm-3">
                        <div class="text-muted fs-xs mb-1">Plattform</div>
                        <div class="fs-sm">{{ item.platform ?? 'web' }}</div>
                        {% if item.app_version %}<div class="text-muted fs-xs">v{{ item.app_version }}</div>{% endif %}
                    </div>
                    <div class="col-sm-5">
                        <div class="text-muted fs-xs mb-1">Seite</div>
                        {% if item.current_url %}
                        <a href="https://app.therapano.de{{ item.current_url }}" target="_blank"
                           class="fs-xs text-info text-truncate d-block" title="{{ item.current_url }}" style="max-width:100%;overflow:hidden;">{{ item.current_url }}</a>
                        {% else %}
                        <div class="fs-xs text-muted">–</div>
                        {% endif %}
                        {% if item.user_agent %}
                        <div class="fs-xs text-muted text-truncate mt-1" title="{{ item.user_agent }}" style="opacity:.6;">{{ item.user_agent|slice(0,60) }}…</div>
                        {% endif %}
                    </div>
                </div>

                <hr class="border-secondary">
                <div class="text-muted lh-lg" style="white-space:pre-wrap;">{{ item.message }}</div>

                {% if item.attachment_path %}
                {% set attExt = item.attachment_path|split('.')|last|lower %}
                {% set attIsImage = attExt in ['jpg','jpeg','png','gif','webp'] %}
                {% set attUrl = '/admin/feedback/' ~ item.id ~ '/anhang' %}
                <div class="mt-3">
                    <div class="text-muted fs-xs mb-2">📎 Anhang</div>
                    {% if attIsImage %}
                    <a href="#" role="button" data-bs-toggle="modal" data-bs-target="#attachmentModal"
                       class="d-inline-block" style="cursor:zoom-in;" title="Zum Vergrößern klicken">
                        <img src="{{ attUrl }}" alt="Anhang zu Feedback #{{ item.id }}" loading="lazy"
                             class="rounded border" style="max-width:220px;max-height:160px;object-fit:cover;">
                    </a>
                    {% else %}
                    <a href="#" role="button" data-bs-toggle="modal" data-bs-target="#attachmentModal"
                       class="btn btn-sm btn-outline-secondary">📄 PDF-Anhang ansehen</a>
                    {% endif %}
                </div>

                {# Anhang-Modal — direkt im SaaS-Admin authentifiziert ausgeliefert
                   (siehe FeedbackController::attachment()), kein Login in der
                   Praxis-App mehr nötig, kein erzwungener neuer Tab. #}
                <div class="modal fade" id="attachmentModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header py-2">
                                <h6 class="modal-title fs-sm mb-0">📎 Anhang — Feedback #{{ item.id }}</h6>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
                            </div>
                            <div class="modal-body text-center p-3" style="background:rgba(0,0,0,.25);">
                                {% if attIsImage %}
                                <img src="{{ attUrl }}" alt="Anhang zu Feedback #{{ item.id }}" class="img-fluid rounded" style="max-height:75vh;">
                                {% else %}
                                <iframe src="{{ attUrl }}" title="PDF-Anhang" style="width:100%;height:75vh;border:0;background:#fff;"></iframe>
                                {% endif %}
                            </div>
                            <div class="modal-footer py-2">
                                <a href="{{ attUrl }}" target="_blank" class="btn btn-sm btn-outline-secondary">↗ In neuem Tab öffnen</a>
                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Schließen</button>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        {# ── Status ── #}
        <div class="card mb-3">
            <div class="card-header py-2 px-4">
                <span class="fw-semibold fs-sm">Status & interne Notiz</span>
            </div>
            <div class="card-body px-4 py-3">
                <form method="POST" action="/admin/feedback/{{ item.id }}/status">
                    {{ csrf_field()|raw }}
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <label class="form-label fw-500 fs-sm" for="fb-status">Status</label>
                            <select class="form-select form-select-sm" id="fb-status" name="status">
                                <option value="open"        {% if (item.status ?? 'open') == 'open' %}selected{% endif %}>Offen</option>
                                <option value="in_progress" {% if (item.status ?? '') == 'in_progress' %}selected{% endif %}>In Bearbeitung</option>
                                <option value="resolved"    {% if (item.status ?? '') == 'resolved' %}selected{% endif %}>Erledigt</option>
                                <option value="closed"      {% if (item.status ?? '') == 'closed' %}selected{% endif %}>Geschlossen</option>
                            </select>
                        </div>
                        <div class="col-sm-8">
                            <label class="form-label fw-500 fs-sm" for="fb-note">Interne Notiz</label>
                            <input type="text" class="form-control form-control-sm" id="fb-note" name="admin_note"
                                   value="{{ item.admin_note ?? '' }}" placeholder="Interne Bemerkung für das Team…">
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-sm btn-primary">Speichern</button>
                        {% if item.resolved_at %}
                        <span class="text-muted fs-xs ms-3">Erledigt am {{ item.resolved_at|date('d.m.Y H:i') }}</span>
                        {% endif %}
                    </div>
                </form>
            </div>
        </div>

        {# ── Support-Chat ── #}
        <div class="card mb-3">
            <div class="card-header py-2 px-4 d-flex align-items-center justify-content-between">
                <span class="fw-semibold fs-sm">💬 Support-Chat mit der Praxis</span>
                <span class="text-muted fs-xs">{{ (replies|length) + 1 }} Nachricht(en)</span>
            </div>
            <div class="card-body p-0">
                <div id="support-chat-thread" style="max-height:420px;overflow-y:auto;padding:1rem 1.25rem;display:flex;flex-direction:column;gap:.75rem;">

                    {# Original message from practice #}
                    <div class="d-flex gap-2 align-items-start">
                        <div class="flex-shrink-0 rounded-circle d-flex align-items-center justify-content-center fw-700"
                             style="width:32px;height:32px;background:var(--bs-primary);color:#fff;font-size:.7rem;">
                            {{ (item.practice_name ?? item.tenant_name ?? 'P')|first|upper }}
                        </div>
                        <div style="max-width:80%;">
                            <div class="fs-xs text-muted mb-1">
                                <strong>{{ item.practice_name ?? item.tenant_name ?? 'Praxis' }}</strong>
                                {% if item.user_name %} · {{ item.user_name }}{% endif %}
                                · {{ item.created_at|date('d.m.Y H:i') }}
                            </div>
                            <div class="rounded-3 px-3 py-2 fs-sm" style="background:rgba(255,255,255,.07);white-space:pre-wrap;">{{ item.message }}</div>
                        </div>
                    </div>

                    {# Replies #}
                    {% for reply in replies %}
                    {% if reply.sender_type == 'admin' %}
                    <div class="d-flex gap-2 align-items-start flex-row-reverse">
                        <div class="flex-shrink-0 rounded-circle d-flex align-items-center justify-content-center fw-700"
                             style="width:32px;height:32px;background:#7c3aed;color:#fff;font-size:.7rem;">S</div>
                        <div style="max-width:80%;text-align:right;">
                            <div class="fs-xs text-muted mb-1">
                                <strong>{{ reply.sender_name ?? 'Support' }}</strong> · {{ reply.created_at|date('d.m.Y H:i') }}
                            </div>
                            <div class="rounded-3 px-3 py-2 fs-sm" style="background:rgba(124,58,237,.2);white-space:pre-wrap;">{{ reply.message }}</div>
                        </div>
                    </div>
                    {% else %}
                    <div class="d-flex gap-2 align-items-start">
                        <div class="flex-shrink-0 rounded-circle d-flex align-items-center justify-content-center fw-700"
                             style="width:32px;height:32px;background:var(--bs-primary);color:#fff;font-size:.7rem;">
                            {{ (item.practice_name ?? 'P')|first|upper }}
                        </div>
                        <div style="max-width:80%;">
                            <div class="fs-xs text-muted mb-1">
                                <strong>{{ reply.sender_name ?? (item.practice_name ?? 'Praxis') }}</strong> · {{ reply.created_at|date('d.m.Y H:i') }}
                            </div>
                            <div class="rounded-3 px-3 py-2 fs-sm" style="background:rgba(255,255,255,.07);white-space:pre-wrap;">{{ reply.message }}</div>
                        </div>
                    </div>
                    {% endif %}
                    {% endfor %}

                </div>

                {# Reply input #}
                <div class="border-top px-4 py-3">
                    <form method="POST" action="/admin/feedback/{{ item.id }}/reply">
                        {{ csrf_field()|raw }}
                        <div class="d-flex gap-2 align-items-end">
                            <textarea class="form-control form-control-sm flex-1" name="reply_message"
                                      rows="2" placeholder="Antwort an die Praxis schreiben…" required
                                      style="resize:none;"></textarea>
                            <button type="submit" class="btn btn-sm btn-primary flex-shrink-0">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="22" y1="2" x2="11" y2="13"/>
                                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                                </svg>
                                Senden
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <script>
        (function(){
            var t = document.getElementById('support-chat-thread');
            if (t) t.scrollTop = t.scrollHeight;
        })();
        </script>

        <div class="d-flex gap-2">
            <form method="POST" action="/admin/feedback/{{ item.id }}/delete" onsubmit="return confirm('Feedback wirklich löschen?')">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <button class="btn btn-sm btn-outline-danger">🗑 Löschen</button>
            </form>
        </div>
    </div>
</div>

{% endblock %}
