Options -Indexes
RewriteEngine On

RewriteRule ^favicon\.ico$ /themes/smart-tierphysio/img/favicon-32x32.png [L,R=301]

# Disable ModSecurity scanning for patient media serving routes to prevent
# WAF false-positives on invite_* / intake_* filenames (causes HTTP 422).
# SecRule with ctl:ruleEngine=Off is the .htaccess-compatible way.
<IfModule mod_security2.c>
    SecRule REQUEST_URI "^/(patienten/[0-9]+/(foto|dokumente)|patient-timeline|patient-photos)/" \
        "id:1001,phase:1,pass,nolog,ctl:ruleEngine=Off"
</IfModule>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

<FilesMatch "\.(env|json|lock|md|sql|sh|bat)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

Header always set X-Content-Type-Options nosniff
Header always set X-Frame-Options SAMEORIGIN
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy strict-origin-when-cross-origin
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set Content-Security-Policy "default-src 'self' blob:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net blob:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com blob:; img-src 'self' data: blob:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://cdn.jsdelivr.net blob:; worker-src blob:; frame-ancestors 'self'"
