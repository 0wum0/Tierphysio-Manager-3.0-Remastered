{% extends active_theme_layout ?? 'layouts/base.twig' %}

{% block content %}
<style>
.wa-wrap{display:flex;flex-direction:column;height:calc(100vh - 260px);min-height:480px;max-height:780px;border-radius:12px;overflow:hidden;border:1px solid var(--bs-border-color);box-shadow:0 2px 12px rgba(0,0,0,.07);}
.wa-header{display:flex;align-items:center;gap:.75rem;padding:.65rem 1rem;background:var(--bs-secondary-bg);border-bottom:1px solid var(--bs-border-color);flex-shrink:0;}
.wa-body{flex:1;overflow-y:auto;padding:1rem;display:flex;flex-direction:column;gap:.5rem;background:#c9d3dc;}
.wa-footer{padding:.5rem .75rem;background:var(--bs-secondary-bg);border-top:1px solid var(--bs-border-color);flex-shrink:0;}
.wa-input-row{display:flex;align-items:flex-end;gap:.5rem;}
.wa-input-box{flex:1;background:var(--bs-body-bg);border:1px solid var(--bs-border-color);border-radius:22px;padding:.5rem .9rem;display:flex;align-items:flex-end;gap:.5rem;}
.wa-input-box textarea{flex:1;border:none;outline:none;resize:none;background:transparent;color:var(--bs-body-color);font-size:.9rem;font-family:inherit;line-height:1.45;max-height:120px;overflow-y:auto;padding:0;}
.wa-btn-send{width:42px;height:42px;border-radius:50%;background:#4f7cff;border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:background .15s;}
.wa-btn-send:hover{background:#3a6be0;}
.wa-btn-send:disabled{background:#94a3b8;cursor:not-allowed;}
.wa-clip{width:32px;height:32px;border-radius:50%;background:transparent;border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--bs-secondary-color);flex-shrink:0;transition:color .15s;}
.wa-clip:hover{color:var(--bs-body-color);}
.wa-bubble{max-width:72%;padding:.45rem .7rem .35rem;border-radius:8px;box-shadow:0 1px 1px rgba(0,0,0,.08);position:relative;word-break:break-word;color:#1a1a1a !important;}
.wa-bubble-own{background:#dde8ff;border:1px solid rgba(79,124,255,.25);border-radius:8px 0 8px 8px;margin-left:auto;}
.wa-bubble-them{background:#fff;border:1px solid rgba(0,0,0,.07);border-radius:0 8px 8px 8px;margin-right:auto;}
.wa-bubble-own::before{content:'';position:absolute;top:0;right:-7px;border-style:solid;border-width:7px 7px 0 0;border-color:#dde8ff transparent transparent transparent;}
.wa-bubble-them::before{content:'';position:absolute;top:0;left:-7px;border-style:solid;border-width:7px 0 0 7px;border-color:#fff transparent transparent transparent;}
.wa-time{font-size:.62rem;color:#555 !important;white-space:nowrap;}
.wa-body-text{font-size:.875rem;line-height:1.45;color:#1a1a1a !important;}
.wa-sender{font-size:.72rem;font-weight:700;color:#16a34a;margin-bottom:.15rem;}
.wa-attach{color:#1a1a1a !important;}
.wa-meta{display:flex;align-items:center;justify-content:flex-end;gap:.2rem;margin-top:.2rem;float:right;clear:both;margin-left:.5rem;}
.wa-attach{display:flex;align-items:center;gap:.5rem;background:rgba(0,0,0,.04);border-radius:8px;padding:.45rem .6rem;margin-bottom:.35rem;text-decoration:none;color:inherit;border:1px solid rgba(0,0,0,.06);}
.wa-attach:hover{background:rgba(0,0,0,.09);}
.wa-attach-icon{width:32px;height:32px;border-radius:6px;background:#e2e8f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.wa-file-preview{display:flex;align-items:center;gap:.35rem;background:rgba(79,124,255,.08);border:1px solid rgba(79,124,255,.2);border-radius:8px;padding:.4rem .65rem;margin-bottom:.4rem;font-size:.8rem;}
.wa-img-wrap{display:block;margin-bottom:.35rem;border-radius:8px;overflow:hidden;max-width:260px;cursor:pointer;}
.wa-img-wrap img{display:block;width:100%;height:auto;max-height:260px;object-fit:cover;border-radius:8px;}
.wa-fmt-menu{position:fixed;display:none;background:var(--bs-body-bg);border:1px solid var(--bs-border-color);border-radius:10px;box-shadow:0 6px 20px rgba(0,0,0,.18);overflow:hidden;z-index:99999;min-width:170px;}
.wa-fmt-item{display:flex;align-items:center;gap:.6rem;width:100%;border:none;background:none;padding:.55rem .85rem;font-size:.84rem;color:var(--bs-body-color);cursor:pointer;text-align:left;transition:background .1s;}
.wa-fmt-item:hover{background:var(--bs-secondary-bg);}
.wa-fmt-item span.wa-fmt-key{margin-left:auto;font-size:.68rem;color:var(--bs-secondary-color);font-family:monospace;background:var(--bs-secondary-bg);border-radius:4px;padding:1px 5px;}
</style>

<div class="page-header" style="margin-bottom:.75rem;">
    <div style="min-width:0;flex:1;">
        <h1 class="page-title" style="margin-bottom:.2rem;">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" class="me-2"><path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            {{ thread.subject }}
        </h1>
        <p class="page-subtitle mb-0">Mit <strong>{{ thread.owner_name }}</strong></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-sm btn-outline-secondary" id="btnToggleStatus" data-status="{{ thread.status }}" data-thread="{{ thread.id }}">
            {% if thread.status == 'closed' %}Wieder öffnen{% else %}Als erledigt markieren{% endif %}
        </button>
        <a href="/portal-admin/nachrichten" class="btn btn-outline-secondary btn-sm">← Zurück</a>
    </div>
</div>

{% if success %}<div class="alert alert-success mb-2">{{ success }}</div>{% endif %}
{% if error %}<div class="alert alert-danger mb-2">{{ error }}</div>{% endif %}

<div class="wa-wrap">
    {# ── Header ── #}
    <div class="wa-header">
        <div style="width:38px;height:38px;border-radius:50%;background:rgba(34,197,94,.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24"><path stroke="#22c55e" stroke-width="2" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </div>
        <div style="flex:1;">
            <div style="font-weight:700;font-size:.9rem;">{{ thread.owner_name }}</div>
            <div style="font-size:.7rem;color:var(--bs-secondary-color);">{{ thread.owner_email }}</div>
        </div>
        <span class="badge" style="background:{% if thread.status == 'closed' %}rgba(148,163,184,.2);color:#94a3b8{% else %}rgba(34,197,94,.15);color:#16a34a{% endif %};font-size:.7rem;padding:3px 8px;">
            {{ thread.status == 'closed' ? 'Geschlossen' : 'Offen' }}
        </span>
    </div>

    {# ── Messages ── #}
    <div id="msg-list" class="wa-body">
        {% for msg in messages %}
        {% set isAdmin = msg.sender_type == 'admin' %}
        <div style="display:flex;justify-content:{% if isAdmin %}flex-end{% else %}flex-start{% endif %};" data-msg-id="{{ msg.id }}">
            <div class="wa-bubble {% if isAdmin %}wa-bubble-own{% else %}wa-bubble-them{% endif %}">
                {% if not isAdmin %}
                <div class="wa-sender">{{ msg.sender_name }}</div>
                {% endif %}

                {% if msg.attachment_name %}
                {% set _ext = msg.attachment_name|split('.')|last|lower %}
                {% if _ext in ['jpg','jpeg','png','gif','webp','avif','bmp'] %}
                <a href="/api/portal-admin/nachrichten/{{ thread.id }}/anhang/{{ msg.id }}" target="_blank" class="wa-img-wrap">
                    <img src="/api/portal-admin/nachrichten/{{ thread.id }}/anhang/{{ msg.id }}" alt="{{ msg.attachment_name }}" loading="lazy">
                </a>
                {% else %}
                <a href="/api/portal-admin/nachrichten/{{ thread.id }}/anhang/{{ msg.id }}" class="wa-attach" download>
                    <div class="wa-attach-icon">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24"><path stroke="#4f7cff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline stroke="#4f7cff" stroke-width="2" stroke-linecap="round" points="14 2 14 8 20 8"/></svg>
                    </div>
                    <div style="min-width:0;">
                        <div style="font-size:.8rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px;">{{ msg.attachment_name }}</div>
                        <div style="font-size:.65rem;color:#555;">{{ msg.size_label }}</div>
                    </div>
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" style="flex-shrink:0;color:#555;"><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline stroke="currentColor" stroke-width="2" stroke-linecap="round" points="7 10 12 15 17 10"/><line stroke="currentColor" stroke-width="2" stroke-linecap="round" x1="12" y1="15" x2="12" y2="3"/></svg>
                </a>
                {% endif %}
                {% endif %}

                {% if msg.body_html %}
                <div class="wa-body-text">{{ msg.body_html|raw }}</div>
                {% endif %}

                <div class="wa-meta">
                    <span class="wa-time">{{ msg.created_at|date('H:i') }}</span>
                    {% if isAdmin %}
                    <span data-status-id="{{ msg.id }}" style="display:flex;align-items:center;">
                        {% if msg.read_at %}
                        <svg width="18" height="9" viewBox="0 0 18 9" fill="none" title="Gelesen"><polyline points="1,4.5 4.5,8 12,1" stroke="#4f7cff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><polyline points="5.5,4.5 9,8 16.5,1" stroke="#4f7cff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {% else %}
                        <svg width="12" height="9" viewBox="0 0 12 9" fill="none" title="Gesendet"><polyline points="1,4.5 4.5,8 11,1" stroke="#999" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {% endif %}
                    </span>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    {# ── Input area ── #}
    {% if thread.status != 'closed' %}
    <div class="wa-footer">
        <div id="filePreview" style="display:none;" class="wa-file-preview">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><path stroke="#4f7cff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline stroke="#4f7cff" stroke-width="2" stroke-linecap="round" points="14 2 14 8 20 8"/></svg>
            <span id="fileName" style="font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:200px;"></span>
            <span id="fileSize" style="color:var(--bs-secondary-color);"></span>
            <button onclick="clearFile()" style="margin-left:auto;background:none;border:none;cursor:pointer;color:#ef4444;font-size:.8rem;padding:0 2px;">✕</button>
        </div>
        <div id="sendError" class="alert alert-danger d-none mb-1" style="font-size:.8rem;padding:.35rem .65rem;"></div>
        <div class="wa-input-row">
            <label for="fileInput" class="wa-clip" title="Datei anhängen (PDF, Word, Excel, TXT)">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                <input type="file" id="fileInput" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.csv,.jpg,.jpeg,.png,.gif,.webp,.avif,.bmp" style="display:none;">
            </label>
            <div class="wa-input-box">
                <textarea id="replyBody" placeholder="Nachricht an {{ thread.owner_name }}" rows="1"></textarea>
            </div>
            <button class="wa-btn-send" id="btnSend" title="Senden">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13" stroke="#fff" stroke-width="2" stroke-linecap="round"/><polygon points="22 2 15 22 11 13 2 9 22 2" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
            </button>
        </div>
    </div>
    {% else %}
    <div style="padding:.75rem 1rem;background:var(--bs-secondary-bg);border-top:1px solid var(--bs-border-color);text-align:center;font-size:.8rem;color:var(--bs-secondary-color);">
        Konversation geschlossen — <button id="btnReopen" class="btn btn-link btn-sm p-0" style="font-size:.8rem;">Wieder öffnen</button>
    </div>
    {% endif %}
</div>

<!-- Rechtsklick-Formatierungsmenü -->
<div id="fmtMenu" class="wa-fmt-menu">
    <button class="wa-fmt-item" data-fmt="bold">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M6 4h8a4 4 0 0 1 0 8H6z"/><path stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M6 12h9a4 4 0 0 1 0 8H6z"/></svg>
        <strong>Fett</strong><span class="wa-fmt-key">*text*</span>
    </button>
    <button class="wa-fmt-item" data-fmt="italic">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><line x1="19" y1="4" x2="10" y2="4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="14" y1="20" x2="5" y2="20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="15" y1="4" x2="9" y2="20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <em>Kursiv</em><span class="wa-fmt-key">_text_</span>
    </button>
    <button class="wa-fmt-item" data-fmt="strike">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M17.3 6.7a4 4 0 0 0-5.6 0 4 4 0 0 0 0 5.6"/><line x1="4" y1="12" x2="20" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6.7 17.3a4 4 0 0 0 5.6 0 4 4 0 0 0 0-5.6"/></svg>
        <s>Durchgestrichen</s><span class="wa-fmt-key">~text~</span>
    </button>
    <button class="wa-fmt-item" data-fmt="code">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><polyline stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="16 18 22 12 16 6"/><polyline stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="8 6 2 12 8 18"/></svg>
        <code>Code</code><span class="wa-fmt-key">```text```</span>
    </button>
</div>
{% endblock %}

{% block scripts %}
<script>
(function() {
    var threadId     = {{ thread.id }};
    var list         = document.getElementById('msg-list');
    var ta           = document.getElementById('replyBody');
    var btnSend      = document.getElementById('btnSend');
    var fileInput    = document.getElementById('fileInput');
    var selectedFile = null;
    var lastId       = 0;

    document.querySelectorAll('#msg-list [data-msg-id]').forEach(function(el) {
        var id = parseInt(el.dataset.msgId, 10);
        if (id > lastId) lastId = id;
    });

    if (list) list.scrollTop = list.scrollHeight;

    /* ── Auto-resize textarea ── */
    if (ta) {
        ta.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
        });
        ta.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); if (btnSend) btnSend.click(); }
        });
    }

    /* ── Rechtsklick-Formatierungsmenü ── */
    var fmtMenu = document.getElementById('fmtMenu');
    if (ta && fmtMenu) {
        ta.addEventListener('contextmenu', function(e) {
            e.preventDefault();
            fmtMenu.style.display = 'block';
            var x = e.clientX, y = e.clientY;
            fmtMenu.style.left = x + 'px';
            fmtMenu.style.top  = y + 'px';
            var r = fmtMenu.getBoundingClientRect();
            if (r.right  > window.innerWidth)  fmtMenu.style.left = (x - r.width)  + 'px';
            if (r.bottom > window.innerHeight) fmtMenu.style.top  = (y - r.height) + 'px';
        });
        document.addEventListener('click', function() { fmtMenu.style.display = 'none'; });
        document.addEventListener('keydown', function(e) { if (e.key === 'Escape') fmtMenu.style.display = 'none'; });
        fmtMenu.querySelectorAll('[data-fmt]').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                applyFmt(this.dataset.fmt);
                fmtMenu.style.display = 'none';
                ta.focus();
            });
        });
    }
    function applyFmt(fmt) {
        var s = ta.selectionStart, e2 = ta.selectionEnd;
        var sel = ta.value.substring(s, e2);
        var open, close, ph;
        switch (fmt) {
            case 'bold':   open='*';   close='*';   ph='fetter Text'; break;
            case 'italic': open='_';   close='_';   ph='kursiver Text'; break;
            case 'strike': open='~';   close='~';   ph='Text'; break;
            case 'code':   open='```'; close='```'; ph='code'; break;
            default: return;
        }
        var inner   = sel || ph;
        var wrapped = open + inner + close;
        ta.value    = ta.value.substring(0, s) + wrapped + ta.value.substring(e2);
        ta.selectionStart = s + open.length;
        ta.selectionEnd   = s + open.length + inner.length;
        ta.dispatchEvent(new Event('input'));
    }

    /* ── File selection ── */
    if (fileInput) {
        fileInput.addEventListener('change', function() {
            var f = this.files[0];
            if (!f) return;
            if (f.size > 10 * 1024 * 1024) { showError('Datei zu groß (max. 10 MB).'); this.value = ''; return; }
            selectedFile = f;
            document.getElementById('fileName').textContent = f.name;
            document.getElementById('fileSize').textContent = formatSize(f.size);
            document.getElementById('filePreview').style.display = 'flex';
        });
    }

    window.clearFile = function() {
        selectedFile = null;
        if (fileInput) fileInput.value = '';
        document.getElementById('filePreview').style.display = 'none';
    };

    function formatSize(b) {
        if (b < 1024) return b + ' B';
        if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
        return (b / 1048576).toFixed(1) + ' MB';
    }

    function showError(msg) {
        var el = document.getElementById('sendError');
        if (!el) return;
        el.textContent = msg;
        el.classList.remove('d-none');
        setTimeout(function() { el.classList.add('d-none'); }, 4000);
    }

    /* ── WhatsApp text formatter ── */
    function waFormat(text) {
        var s = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        s = s.replace(/```([\s\S]+?)```/g, '<code style="font-family:monospace;background:rgba(0,0,0,.06);padding:1px 4px;border-radius:3px;">$1</code>');
        s = s.replace(/\*([^\*\n]+)\*/g, '<strong>$1</strong>');
        s = s.replace(/_([^_\n]+)_/g, '<em>$1</em>');
        s = s.replace(/~([^~\n]+)~/g, '<s>$1</s>');
        return s.replace(/\n/g, '<br>');
    }

    /* ── Tick helpers ── */
    function tickSingle() { return '<svg width="12" height="9" viewBox="0 0 12 9" fill="none"><polyline points="1,4.5 4.5,8 11,1" stroke="#999" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>'; }
    function tickDouble() { return '<svg width="18" height="9" viewBox="0 0 18 9" fill="none"><polyline points="1,4.5 4.5,8 12,1" stroke="#4f7cff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><polyline points="5.5,4.5 9,8 16.5,1" stroke="#4f7cff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>'; }

    function setRead(msgId) {
        var el = document.querySelector('[data-status-id="' + msgId + '"]');
        if (el && !el.classList.contains('read')) { el.innerHTML = tickDouble(); el.classList.add('read'); }
    }

    function isImg(name) { return /\.(jpg|jpeg|png|gif|webp|avif|bmp)$/i.test(name || ''); }

    /* ── Build bubble ── */
    function buildBubble(d, isAdmin) {
        var attach = '';
        if (d.attachment_name) {
            var url = '/api/portal-admin/nachrichten/' + threadId + '/anhang/' + d.id;
            if (isImg(d.attachment_name)) {
                attach = '<a href="' + url + '" target="_blank" class="wa-img-wrap">'
                    + '<img src="' + url + '" alt="' + d.attachment_name + '" loading="lazy"></a>';
            } else {
                attach = '<a href="' + url + '" class="wa-attach" download>'
                    + '<div class="wa-attach-icon"><svg width="16" height="16" fill="none" viewBox="0 0 24 24"><path stroke="#4f7cff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline stroke="#4f7cff" stroke-width="2" stroke-linecap="round" points="14 2 14 8 20 8"/></svg></div>'
                    + '<div style="min-width:0;"><div style="font-size:.8rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px;">' + d.attachment_name + '</div>'
                    + (d.size_label ? '<div style="font-size:.65rem;color:#555;">' + d.size_label + '</div>' : '')
                    + '</div></a>';
            }
        }
        var bodyHtml = d.body_html || waFormat(d.body || '');
        var bodyPart = bodyHtml ? '<div class="wa-body-text">' + bodyHtml + '</div>' : '';
        var senderPart = !isAdmin ? '<div class="wa-sender">' + (d.sender_name || '') + '</div>' : '';
        var tick = isAdmin ? '<span data-status-id="' + d.id + '" style="display:flex;align-items:center;">' + tickSingle() + '</span>' : '';
        var meta = '<div class="wa-meta"><span class="wa-time">' + d.created_at + '</span>' + tick + '</div>';

        var wrapper = document.createElement('div');
        wrapper.style.cssText = 'display:flex;justify-content:' + (isAdmin ? 'flex-end' : 'flex-start') + ';';
        wrapper.dataset.msgId = d.id;
        var bubble = document.createElement('div');
        bubble.className = 'wa-bubble ' + (isAdmin ? 'wa-bubble-own' : 'wa-bubble-them');
        bubble.innerHTML = senderPart + attach + bodyPart + meta;
        wrapper.appendChild(bubble);
        return wrapper;
    }

    function appendMsg(d, isAdmin) {
        list.appendChild(buildBubble(d, isAdmin));
        list.scrollTop = list.scrollHeight;
    }

    /* ── Send ── */
    if (btnSend) {
        btnSend.addEventListener('click', function() {
            var body = ta ? ta.value.trim() : '';
            if (!body && !selectedFile) { showError('Bitte Nachricht eingeben oder Datei auswählen.'); return; }
            btnSend.disabled = true;

            var endpoint, headers = {}, bodyData;
            if (selectedFile) {
                var fd = new FormData();
                if (body) fd.append('body', body);
                fd.append('file', selectedFile);
                endpoint = '/api/portal-admin/nachrichten/' + threadId + '/anhang';
                bodyData = fd;
            } else {
                endpoint = '/api/portal-admin/nachrichten/' + threadId + '/antworten';
                headers = { 'Content-Type': 'application/x-www-form-urlencoded' };
                bodyData = new URLSearchParams({ body: body });
            }

            fetch(endpoint, { method: 'POST', headers: headers, body: bodyData })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.ok) {
                    appendMsg(d, true);
                    if (parseInt(d.id, 10) > lastId) lastId = parseInt(d.id, 10);
                    if (ta) { ta.value = ''; ta.style.height = 'auto'; }
                    clearFile();
                } else {
                    showError(d.error || 'Fehler beim Senden.');
                }
                btnSend.disabled = false;
            })
            .catch(function() { showError('Verbindungsfehler.'); btnSend.disabled = false; });
        });
    }

    /* ── Toggle status ── */
    var btnStatus = document.getElementById('btnToggleStatus');
    if (btnStatus) {
        btnStatus.addEventListener('click', function() {
            var next = btnStatus.dataset.status === 'closed' ? 'open' : 'closed';
            fetch('/api/portal-admin/nachrichten/' + threadId + '/status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ status: next })
            }).then(function(r) { return r.json(); }).then(function(d) { if (d.ok) location.reload(); });
        });
    }

    var btnReopen = document.getElementById('btnReopen');
    if (btnReopen) {
        btnReopen.addEventListener('click', function() {
            fetch('/api/portal-admin/nachrichten/' + threadId + '/status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ status: 'open' })
            }).then(function(r) { return r.json(); }).then(function(d) { if (d.ok) location.reload(); });
        });
    }

    /* ── Polling ── */
    var pollTimer;
    function poll() {
        fetch('/api/portal-admin/nachrichten/' + threadId + '/poll?after=' + lastId)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.messages && data.messages.length) {
                data.messages.forEach(function(m) {
                    if (parseInt(m.id, 10) > lastId) lastId = parseInt(m.id, 10);
                    if (m.sender_type === 'owner') appendMsg(m, false);
                });
            }
            if (data.read_updates && data.read_updates.length) {
                data.read_updates.forEach(function(id) { setRead(id); });
            }
        })
        .catch(function() {})
        .finally(function() { pollTimer = setTimeout(poll, 4000); });
    }
    pollTimer = setTimeout(poll, 4000);
    document.addEventListener('visibilitychange', function() {
        if (document.hidden) { clearTimeout(pollTimer); }
        else { clearTimeout(pollTimer); pollTimer = setTimeout(poll, 500); }
    });
})();
</script>
{% endblock %}
