{% extends active_theme_layout ?? 'layouts/base.twig' %}

{% block content %}

{# ── Page Header (page-header class is visible in bridge.css) ── #}
<div class="page-header">
    <div>
        <h1 class="page-title">{% if is_trainer ?? false %}Halter{% else %}{{ t('owners.title') }}{% endif %}</h1>
        <p class="page-subtitle">{{ pagination.total }} {{ t('common.entries') }}</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modal-wizard-patient">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        {% if is_trainer ?? false %}Neuen Halter + Tier anlegen{% else %}Neuen Tierhalter + Tier anlegen{% endif %}
    </button>
</div>

{# ── Panel ── #}
<div class="panel">

    {# Panel Header mit Suche #}
    <div class="panel-hdr">
        <h2>{% if is_trainer ?? false %}Halter{% else %}{{ t('owners.title') }}{% endif %} <span class="fw-300"><i>{{ pagination.total }} Einträge</i></span></h2>
        <div class="panel-toolbar">
            <form method="GET" action="/tierhalter" class="d-flex align-items-center gap-2 mb-0">
                <div class="input-group input-group-sm" style="width:240px;">
                    <span class="input-group-text">
                        <svg width="13" height="13" fill="none" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </span>
                    <input type="text" name="search" class="form-control form-control-sm"
                           placeholder="{{ t('owners.search_placeholder') }}" value="{{ search }}">
                </div>
                <button type="submit" class="btn btn-sm btn-secondary">Suchen</button>
                {% if search %}<a href="/tierhalter" class="btn btn-sm btn-outline-secondary">✕</a>{% endif %}
            </form>
        </div>
    </div>

    <div class="panel-container show">
        <div class="panel-content p-0">

        {% if owners %}
            <div class="table-responsive">
            <table class="table table-hover table-striped table-bordered mb-0">
                <thead>
                    <tr>
                        <th style="width:35%;">{{ t('owners.last_name') }}, {{ t('owners.first_name') }}</th>
                        <th>{{ t('owners.email') }}</th>
                        <th>{{ t('owners.phone') }}</th>
                        <th>{{ t('owners.city') }}</th>
                        <th class="text-center" style="width:70px;">Tiere</th>
                        <th class="text-end" style="width:130px;">{{ t('common.actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for owner in owners %}
                    <tr style="vertical-align:middle;">
                        <td>
                            <a href="/tierhalter/{{ owner.id }}" class="d-flex align-items-center gap-3 text-decoration-none text-body">
                                <span class="avatar-placeholder flex-shrink-0"
                                      style="width:36px;height:36px;font-size:0.78rem;">
                                    {{ owner.first_name|first|upper }}{{ owner.last_name|first|upper }}
                                </span>
                                <div>
                                    <div class="fw-500 d-flex align-items-center gap-2">
                                        {{ owner.last_name }}, {{ owner.first_name }}
                                        <span class="badge bg-primary fs-nano">#{{ '%04d'|format(owner.id) }}</span>
                                    </div>
                                    {% if owner.street %}
                                    <div class="fs-nano text-muted">{{ owner.street }}</div>
                                    {% endif %}
                                </div>
                            </a>
                        </td>
                        <td class="fs-sm">
                            {% if owner.email %}
                                <a href="mailto:{{ owner.email }}" class="text-primary">{{ owner.email }}</a>
                            {% else %}<span class="text-muted">—</span>{% endif %}
                        </td>
                        <td class="fs-sm">{{ owner.phone ?: '<span class="text-muted">—</span>' }}</td>
                        <td class="fs-sm">
                            {{ owner.zip ? owner.zip ~ ' ' ~ owner.city : (owner.city ?: '<span class="text-muted">—</span>') }}
                        </td>
                        <td class="text-center">
                            {% set cnt = owner.animal_count ?? 0 %}
                            <span class="badge {% if cnt > 0 %}bg-success{% else %}bg-secondary{% endif %}">{{ cnt }}</span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex align-items-center justify-content-end gap-1">
                                <a href="/tierhalter/{{ owner.id }}" class="btn btn-xs btn-secondary" title="Ansehen">
                                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
                                </a>
                                <a href="/rechnungen/erstellen?owner_id={{ owner.id }}" class="btn btn-xs btn-primary" title="Rechnung erstellen">
                                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline stroke="currentColor" stroke-width="2" stroke-linecap="round" points="14 2 14 8 20 8"/></svg>
                                </a>
                                <div class="dropdown">
                                    <button class="btn btn-xs btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        <svg width="13" height="13" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5" fill="currentColor"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/><circle cx="12" cy="19" r="1.5" fill="currentColor"/></svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-animated">
                                        <li><a class="dropdown-item" href="/tierhalter/{{ owner.id }}">
                                            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" class="me-2 text-muted"><path stroke="currentColor" stroke-width="2" d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
                                            Profil anzeigen
                                        </a></li>
                                        <li><a class="dropdown-item" href="/rechnungen/erstellen?owner_id={{ owner.id }}">
                                            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" class="me-2 text-muted"><path stroke="currentColor" stroke-width="2" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline stroke="currentColor" stroke-width="2" stroke-linecap="round" points="14 2 14 8 20 8"/></svg>
                                            Rechnung erstellen
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="/einladungen?prefill_owner={{ owner.id }}">
                                            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" class="me-2 text-muted"><line x1="22" y1="2" x2="11" y2="13" stroke="currentColor" stroke-width="2"/><polygon points="22 2 15 22 11 13 2 9 22 2" stroke="currentColor" stroke-width="2" fill="none"/></svg>
                                            Einladung senden
                                        </a></li>
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>

            {# Pagination #}
            {% if pagination.last_page > 1 %}
            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-top">
                <span class="fs-sm text-muted">Seite {{ pagination.page }} / {{ pagination.last_page }} &middot; {{ pagination.total }} Einträge</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item {% if not pagination.has_prev %}disabled{% endif %}">
                            <a class="page-link" href="?page={{ pagination.page - 1 }}&search={{ search }}">‹</a>
                        </li>
                        {% for p in 1..pagination.last_page %}
                            {% if p == pagination.page %}
                                <li class="page-item active"><span class="page-link">{{ p }}</span></li>
                            {% elseif p == 1 or p == pagination.last_page or (p >= pagination.page - 2 and p <= pagination.page + 2) %}
                                <li class="page-item"><a class="page-link" href="?page={{ p }}&search={{ search }}">{{ p }}</a></li>
                            {% elseif p == pagination.page - 3 or p == pagination.page + 3 %}
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            {% endif %}
                        {% endfor %}
                        <li class="page-item {% if not pagination.has_next %}disabled{% endif %}">
                            <a class="page-link" href="?page={{ pagination.page + 1 }}&search={{ search }}">›</a>
                        </li>
                    </ul>
                </nav>
            </div>
            {% endif %}

        {% else %}
            <div class="text-center py-5">
                <svg width="48" height="48" fill="none" viewBox="0 0 24 24" class="mb-3 text-muted" style="opacity:.3;"><path stroke="currentColor" stroke-width="1.5" d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/><path stroke="currentColor" stroke-width="1.5" d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <h5 class="text-muted fw-400">{{ t('owners.no_owners') }}</h5>
                <p class="text-muted fs-sm mb-4">{{ search ? 'Keine Ergebnisse für "' ~ search ~ '"' : (is_trainer ?? false ? 'Noch keine Halter angelegt.' : 'Noch keine Tierhalter angelegt.') }}</p>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modal-wizard-patient">
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    {% if is_trainer ?? false %}Neuen Halter + Tier anlegen{% else %}Neuen Tierhalter + Tier anlegen{% endif %}
                </button>
            </div>
        {% endif %}

        </div>
    </div>

</div>{# end panel #}

{# ══════════ Wizard Modal (gleich wie in patients/index) ══════════ #}
<div class="modal fade" id="modal-wizard-patient" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" style="max-width:780px;">
        <div class="modal-content">

            <div class="modal-header" style="flex-shrink:0;border-bottom:1px solid var(--bs-border-color);padding:1rem 1.5rem;">
                <h4 class="modal-title fw-700" style="font-size:1rem;">
                    {% if is_trainer ?? false %}Neuen Halter + Hund anlegen{% else %}Neuen Tierhalter + Tier anlegen{% endif %}
                </h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="owiz.reset()" aria-label="Schließen"></button>
            </div>

            <div style="padding:.75rem 1.5rem 0;flex-shrink:0;">
                <div class="d-flex align-items-center" id="owiz-steps">
                    <div class="owizstep active" id="owizstep-1" style="flex:1;display:flex;flex-direction:column;align-items:center;position:relative;">
                        <div class="owizstep-circle">1</div>
                        <div class="owizstep-label">Tierhalter</div>
                    </div>
                    <div class="owizstep" id="owizstep-2" style="flex:1;display:flex;flex-direction:column;align-items:center;position:relative;">
                        <div class="owizstep-circle">2</div>
                        <div class="owizstep-label">Tier</div>
                    </div>
                    <div class="owizstep" id="owizstep-3" style="flex:1;display:flex;flex-direction:column;align-items:center;position:relative;">
                        <div class="owizstep-circle">3</div>
                        <div class="owizstep-label">Bestätigung</div>
                    </div>
                </div>
            </div>

            <form action="/patienten/wizard" method="POST" id="owiz-form" enctype="multipart/form-data">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="owner_mode" id="owiz_owner_mode" value="new">
                <input type="hidden" name="owner_id" id="owiz_owner_id" value="">
                <input type="hidden" name="species" id="owiz_species" value="">

                <div class="modal-body" style="padding:1.25rem 1.5rem;">

                    {# Panel 1: Tierhalter #}
                    <div class="owizpanel" id="owizpanel-1">
                        <h5 class="fw-700 mb-1" style="font-size:.95rem;">Tierhalter</h5>
                        <p class="text-muted" style="font-size:.8rem;margin-bottom:1rem;">Bestehenden suchen oder neuen anlegen.</p>

                        <div class="d-flex gap-2 mb-3">
                            <button type="button" class="btn btn-sm owtab" id="owtab-existing" onclick="owiz.setMode('existing')">🔍 Bestehenden suchen</button>
                            <button type="button" class="btn btn-sm owtab active" id="owtab-new" onclick="owiz.setMode('new')">+ Neuen anlegen</button>
                        </div>

                        <div id="ow-panel-existing" style="display:none;">
                            <div style="position:relative;">
                                <input type="text" id="ow-owner-search" class="form-control" placeholder="Name oder E-Mail…" autocomplete="off">
                                <div id="ow-owner-results" style="position:absolute;top:calc(100%+4px);left:0;right:0;background:var(--bs-tertiary-bg);border:1px solid var(--bs-border-color);border-radius:10px;z-index:200;max-height:220px;overflow-y:auto;box-shadow:0 8px 24px rgba(0,0,0,.18);display:none;"></div>
                            </div>
                            <div id="ow-selected-owner" style="display:none;margin-top:.75rem;background:color-mix(in srgb,var(--bs-primary) 8%,transparent);border:1px solid color-mix(in srgb,var(--bs-primary) 25%,transparent);border-radius:10px;padding:.75rem 1rem;align-items:center;gap:.75rem;">
                                <div id="owso-avatar" style="width:36px;height:36px;border-radius:50%;background:var(--bs-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;flex-shrink:0;"></div>
                                <div style="flex:1;"><div class="fw-700" id="owso-name" style="font-size:.88rem;"></div><div class="text-muted" id="owso-meta" style="font-size:.75rem;"></div></div>
                                <button type="button" class="btn btn-sm btn-secondary" onclick="owiz.clearOwner()">Ändern</button>
                            </div>
                        </div>

                        <div id="ow-panel-new">
                            <div class="row g-2">
                                <div class="col-md-6"><label class="form-label">Vorname *</label><input type="text" name="owner_first_name" id="owiz_owner_fn" class="form-control" placeholder="Max"></div>
                                <div class="col-md-6"><label class="form-label">Nachname *</label><input type="text" name="owner_last_name" id="owiz_owner_ln" class="form-control" placeholder="Mustermann"></div>
                                <div class="col-md-6"><label class="form-label">E-Mail</label><input type="email" name="owner_email" class="form-control"></div>
                                <div class="col-md-6"><label class="form-label">Telefon</label><input type="tel" name="owner_phone" class="form-control"></div>
                                <div class="col-md-6"><label class="form-label">Geburtsdatum</label><input type="date" name="owner_birth_date" class="form-control"></div>
                                <div class="col-md-6"></div>
                                <div class="col-12"><label class="form-label">Straße &amp; Hausnummer</label><input type="text" name="owner_street" class="form-control"></div>
                                <div class="col-md-4"><label class="form-label">PLZ</label><input type="text" name="owner_zip" class="form-control"></div>
                                <div class="col-md-8"><label class="form-label">Stadt</label><input type="text" name="owner_city" class="form-control"></div>
                            </div>
                        </div>
                    </div>

                    {# Panel 2: Tier #}
                    <div class="owizpanel" id="owizpanel-2" style="display:none;">
                        <h5 class="fw-700 mb-1" style="font-size:.95rem;">Tier-Daten</h5>
                        <p class="text-muted" style="font-size:.8rem;margin-bottom:1rem;">Alle Angaben außer Name sind optional.</p>
                        <label class="form-label">Tierart</label>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary ow-species-btn" onclick="owiz.pickSpecies('Hund',this)">🐕 Hund</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary ow-species-btn" onclick="owiz.pickSpecies('Katze',this)">🐈 Katze</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary ow-species-btn" onclick="owiz.pickSpecies('Pferd',this)">🐎 Pferd</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary ow-species-btn" onclick="owiz.pickSpecies('Kaninchen',this)">🐇 Kaninchen</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary ow-species-btn" onclick="owiz.pickSpecies('Vogel',this)">🐦 Vogel</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary ow-species-btn" onclick="owiz.pickSpecies('Reptil',this)">🦎 Reptil</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary ow-species-btn" onclick="owiz.pickSpecies('Nager',this)">🐹 Nager</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary ow-species-btn" onclick="owiz.pickSpecies('',this,'other')">🐾 Andere</button>
                        </div>
                        <div id="ow-species-other" style="display:none;margin-bottom:.75rem;">
                            <input type="text" id="ow-species-other-input" class="form-control" placeholder="Tierart eingeben…" oninput="document.getElementById('owiz_species').value=this.value">
                        </div>
                        <div class="row g-2">
                            <div class="col-12"><label class="form-label">Name *</label><input type="text" name="name" id="owiz_name" class="form-control" placeholder="Bello"></div>
                            <div class="col-md-6"><label class="form-label">Rasse</label><input type="text" name="breed" class="form-control" placeholder="z.B. Labrador"></div>
                            <div class="col-md-6"><label class="form-label">Geschlecht</label><select name="gender" class="form-control"><option value="">— wählen —</option><option>männlich</option><option>weiblich</option><option>kastriert</option><option>sterilisiert</option><option>unbekannt</option></select></div>
                            <div class="col-md-6"><label class="form-label">Geburtsdatum</label><input type="date" name="birth_date" class="form-control"></div>
                            <div class="col-md-6"><label class="form-label">Farbe / Fellfarbe</label><input type="text" name="color" class="form-control"></div>
                            <div class="col-md-6"><label class="form-label">Chip-Nummer</label><input type="text" name="chip_number" class="form-control" placeholder="15-stellige Nr."></div>
                            <div class="col-md-6"><label class="form-label">Gewicht (kg)</label><input type="number" name="weight" class="form-control" step="0.1" min="0"></div>
                            <div class="col-md-6"><label class="form-label">Impfpass-Nummer</label><input type="text" name="passport_number" class="form-control"></div>
                            <div class="col-md-6"><label class="form-label">Versicherungsart</label><select name="insurance_type" class="form-control"><option value="">— keine —</option><option>Tierkrankenversicherung</option><option>Tier-OP-Versicherung</option><option>Tierhaftpflicht</option><option>Sonstige</option></select></div>
                            <div class="col-md-6"><label class="form-label">Versicherungsgesellschaft</label><input type="text" name="insurance_company" class="form-control"></div>
                            <div class="col-md-6"><label class="form-label">Police-Nr.</label><input type="text" name="insurance_policy" class="form-control"></div>
                            <div class="col-12"><label class="form-label">Foto</label><input type="file" name="photo" id="owiz_photo" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif"><div id="owiz-photo-preview" style="display:none;margin-top:.4rem;"><img id="owiz-photo-img" src="" alt="" style="max-height:100px;border-radius:8px;"></div></div>
                            <div class="col-12"><label class="form-label">Notizen</label><textarea name="notes" class="form-control" rows="2" placeholder="Besonderheiten, Allergien…"></textarea></div>
                        </div>
                    </div>

                    {# Panel 3: Bestätigung #}
                    <div class="owizpanel" id="owizpanel-3" style="display:none;">
                        <h5 class="fw-700 mb-3" style="font-size:.95rem;">Zusammenfassung</h5>
                        <p class="text-muted fw-600 mb-1" style="font-size:.72rem;text-transform:uppercase;">Tierhalter</p>
                        <div id="owizsum-owner" class="mb-3 p-3" style="background:var(--bs-secondary-bg);border-radius:10px;">—</div>
                        <p class="text-muted fw-600 mb-1" style="font-size:.72rem;text-transform:uppercase;">Patient</p>
                        <div id="owizsum-patient" style="background:var(--bs-secondary-bg);border-radius:10px;padding:.75rem 1rem;"></div>
                    </div>

                </div>

                <div class="modal-footer" style="flex-shrink:0;justify-content:space-between;">
                    <button type="button" class="btn btn-secondary" id="owiz-back" style="display:none;" onclick="owiz.go(owiz.step-1)">← Zurück</button>
                    <button type="button" class="btn btn-secondary ms-auto" data-bs-dismiss="modal" onclick="owiz.reset()">Abbrechen</button>
                    <button type="button" class="btn btn-primary ms-2" id="owiz-next" onclick="owiz.go(owiz.step+1)">Weiter: Tier →</button>
                    <button type="submit" class="btn btn-primary ms-2" id="owiz-submit" style="display:none;">✓ Anlegen</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<style>
.owizstep-circle{width:32px;height:32px;border-radius:50%;border:2px solid var(--bs-border-color);background:var(--bs-body-bg);display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;color:var(--bs-secondary-color);position:relative;z-index:1;transition:all .25s;}
.owizstep.active .owizstep-circle{border-color:var(--bs-primary);background:var(--bs-primary);color:#fff;}
.owizstep.done .owizstep-circle{border-color:#22c55e;background:#22c55e;color:#fff;}
.owizstep-label{font-size:.7rem;margin-top:.3rem;color:var(--bs-secondary-color);font-weight:500;}
.owizstep.active .owizstep-label{color:var(--bs-primary);font-weight:700;}
.owizstep.done .owizstep-label{color:#22c55e;}
#owiz-steps>div:not(:last-child)::after{content:'';position:absolute;top:16px;left:50%;width:100%;height:2px;background:var(--bs-border-color);z-index:0;}
#owiz-steps>.owizstep.done:not(:last-child)::after{background:var(--bs-primary);}
.owtab{border:2px solid var(--bs-border-color);background:transparent;color:var(--bs-secondary-color);}
.owtab.active{border-color:var(--bs-primary);color:var(--bs-primary);background:color-mix(in srgb,var(--bs-primary) 10%,transparent);}
.ow-species-btn{border:2px solid var(--bs-border-color);}
.ow-species-btn.active{border-color:var(--bs-primary);background:color-mix(in srgb,var(--bs-primary) 12%,transparent);color:var(--bs-primary);}
</style>
<script>
(function(){
    const owiz = window.owiz = {
        step:1, mode:'new', owner:null, searchTimer:null,
        go(step){
            if(step===2&&!this.validateStep1())return;
            if(step===3&&!this.validateStep2())return;
            if(step===3)this.buildSummary();
            document.getElementById('owizpanel-'+this.step).style.display='none';
            document.getElementById('owizpanel-'+step).style.display='';
            this.step=step;
            this.updateIndicator();
            this.updateNav();
        },
        updateIndicator(){
            for(let i=1;i<=3;i++){
                const el=document.getElementById('owizstep-'+i);
                el.className='owizstep'+(i<this.step?' done':i===this.step?' active':'');
            }
        },
        updateNav(){
            document.getElementById('owiz-back').style.display=this.step>1?'':'none';
            const next=document.getElementById('owiz-next');
            next.style.display=this.step<3?'':'none';
            document.getElementById('owiz-submit').style.display=this.step===3?'':'none';
            next.textContent=this.step===2?'Weiter: Prüfen →':'Weiter: Tier →';
        },
        validateStep1(){
            if(this.mode==='existing'){if(!this.owner){alert('Bitte einen Tierhalter auswählen.');return false;}}
            else{const fn=document.getElementById('owiz_owner_fn').value.trim();const ln=document.getElementById('owiz_owner_ln').value.trim();if(!fn||!ln){alert('Bitte Vor- und Nachname angeben.');return false;}}
            return true;
        },
        validateStep2(){
            const name=document.getElementById('owiz_name').value.trim();
            if(!name){alert('Bitte einen Namen für das Tier angeben.');document.getElementById('owiz_name').focus();return false;}
            return true;
        },
        setMode(mode){
            this.mode=mode;
            document.getElementById('owiz_owner_mode').value=mode;
            document.getElementById('owtab-existing').classList.toggle('active',mode==='existing');
            document.getElementById('owtab-new').classList.toggle('active',mode==='new');
            document.getElementById('ow-panel-existing').style.display=mode==='existing'?'':'none';
            document.getElementById('ow-panel-new').style.display=mode==='new'?'':'none';
        },
        pickSpecies(val,btn,type){
            document.querySelectorAll('.ow-species-btn').forEach(b=>b.classList.remove('active'));
            btn.classList.add('active');
            const ow=document.getElementById('ow-species-other');
            if(type==='other'){ow.style.display='';document.getElementById('owiz_species').value=document.getElementById('ow-species-other-input').value;}
            else{ow.style.display='none';document.getElementById('owiz_species').value=val;}
        },
        selectOwner(o){
            this.owner=o;
            document.getElementById('owiz_owner_id').value=o.id;
            document.getElementById('ow-owner-results').style.display='none';
            const inp=document.getElementById('ow-owner-search');
            inp.value=o.first_name+' '+o.last_name;inp.style.display='none';
            const card=document.getElementById('ow-selected-owner');card.style.display='flex';
            document.getElementById('owso-avatar').textContent=(o.first_name[0]+o.last_name[0]).toUpperCase();
            document.getElementById('owso-name').textContent=o.first_name+' '+o.last_name;
            document.getElementById('owso-meta').textContent=[o.phone,o.email].filter(Boolean).join(' · ');
        },
        clearOwner(){
            this.owner=null;document.getElementById('owiz_owner_id').value='';
            document.getElementById('ow-selected-owner').style.display='none';
            const inp=document.getElementById('ow-owner-search');inp.style.display='';inp.value='';inp.focus();
        },
        buildSummary(){
            let ownerHtml='';
            if(this.mode==='existing'&&this.owner){
                const o=this.owner;ownerHtml=`<strong>${o.first_name} ${o.last_name}</strong>`;
                if(o.email)ownerHtml+=`<br><small class="text-muted">${o.email}</small>`;
            }else{
                const fn=document.getElementById('owiz_owner_fn').value;
                const ln=document.getElementById('owiz_owner_ln').value;
                ownerHtml=`<strong>${fn} ${ln}</strong> <span class="badge bg-success ms-1">Neu</span>`;
            }
            document.getElementById('owizsum-owner').innerHTML=ownerHtml;
            const form=document.getElementById('owiz-form');
            const get=n=>form.querySelector('[name="'+n+'"]')?.value||'';
            const species=document.getElementById('owiz_species').value;
            const photoFile=document.getElementById('owiz_photo')?.files[0];
            const rows=[['Name',get('name')],['Tierart',species],['Rasse',get('breed')],['Chip-Nr.',get('chip_number')],['Foto',photoFile?'📷 '+photoFile.name:'']].filter(([,v])=>v);
            document.getElementById('owizsum-patient').innerHTML=rows.map(([l,v])=>`<div style="display:flex;justify-content:space-between;padding:.35rem 0;border-bottom:1px solid var(--bs-border-color);font-size:.85rem;"><span class="text-muted">${l}</span><span>${v}</span></div>`).join('');
        },
        reset(){
            this.step=1;this.mode='new';this.owner=null;
            document.querySelectorAll('.owizpanel').forEach((p,i)=>p.style.display=i===0?'':'none');
            this.updateIndicator();this.updateNav();this.setMode('new');
            document.getElementById('owiz-form').reset();
            document.getElementById('owiz_species').value='';
            document.querySelectorAll('.ow-species-btn').forEach(b=>b.classList.remove('active'));
            document.getElementById('owiz-photo-preview').style.display='none';
        }
    };
    // Owner search
    const si=document.getElementById('ow-owner-search');
    si.addEventListener('input',function(){
        clearTimeout(owiz.searchTimer);const q=this.value.trim();
        const res=document.getElementById('ow-owner-results');
        if(q.length<2){res.style.display='none';return;}
        owiz.searchTimer=setTimeout(()=>{
            fetch('/api/tierhalter/suche?q='+encodeURIComponent(q)).then(r=>r.json()).then(data=>{
                if(!data.length){res.innerHTML='<div style="padding:.6rem 1rem;font-size:.82rem;color:var(--bs-secondary-color);">Keine Ergebnisse</div>';}
                else{res.innerHTML=data.map(o=>{const ini=((o.first_name||'')[0]+(o.last_name||'')[0]).toUpperCase();const meta=[o.phone,o.email].filter(Boolean).join(' · ');return`<div onclick='owiz.selectOwner(${JSON.stringify(o).replace(/"/g,"&quot;")})'style="padding:.6rem .9rem;cursor:pointer;border-bottom:1px solid var(--bs-border-color);display:flex;gap:.6rem;align-items:center;"onmouseenter="this.style.background='var(--bs-secondary-bg)'"onmouseleave="this.style.background=''"><div style="width:32px;height:32px;border-radius:50%;background:var(--bs-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;flex-shrink:0;">${ini}</div><div><div style="font-weight:600;font-size:.85rem;">${o.first_name} ${o.last_name}</div>${meta?`<div style="font-size:.72rem;color:var(--bs-secondary-color);">${meta}</div>`:''}</div></div>`;}).join('');}
                res.style.display='block';
            });
        },250);
    });
    document.addEventListener('click',e=>{if(!e.target.closest('#ow-owner-search')&&!e.target.closest('#ow-owner-results'))document.getElementById('ow-owner-results').style.display='none';});
    si.addEventListener('keydown',e=>{if(e.key==='Enter')e.preventDefault();});
    document.getElementById('owiz_photo')?.addEventListener('change',function(){
        const file=this.files[0];if(!file)return;
        const reader=new FileReader();
        reader.onload=e=>{document.getElementById('owiz-photo-img').src=e.target.result;document.getElementById('owiz-photo-preview').style.display='';};
        reader.readAsDataURL(file);
    });
    document.getElementById('modal-wizard-patient')?.addEventListener('hidden.bs.modal',()=>owiz.reset());
    owiz.setMode('new');
    owiz.updateNav();
})();
</script>
{% endblock %}
