{% extends active_theme_layout ?? 'layouts/base.twig' %}
{% set active_nav = 'packages' %}

{% block content %}
<div class="page-header">
    <div>
        <a href="/pakete" class="btn btn-link btn-sm mb-2">← Zurück</a>
        <h1 class="page-title">{% if is_new %}Neues Paket{% else %}Paket bearbeiten{% endif %}</h1>
    </div>
</div>

{% if is_new %}
<div class="card mb-3" style="max-width:720px;border-color:rgba(99,102,241,.3);background:rgba(99,102,241,.04);">
    <div class="card-body px-4 py-3">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span style="font-size:1.2rem;">🤖</span>
            <span class="fw-semibold">KI-Assistent</span>
            <span class="badge" style="background:rgba(99,102,241,.15);color:#6366f1;font-size:.7rem;">Beta</span>
        </div>
        <div class="d-flex gap-2">
            <input type="text" id="ki-prompt" class="form-control" placeholder="z.B. 10er-Karte für Welpentraining, 12 Monate gültig, 149 €">
            <button type="button" id="ki-btn" class="btn btn-outline-primary" onclick="kiGenerieren('paket')">Ausfüllen</button>
        </div>
        <div id="ki-error" class="text-danger mt-2" style="display:none;font-size:.875rem;"></div>
    </div>
</div>
{% endif %}

<form method="POST" action="{% if is_new %}/pakete{% else %}/pakete/{{ package.id }}{% endif %}" style="max-width:720px;">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

    <div class="card mb-3">
        <div class="card-body px-4 py-3">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">Name <span style="color:#ef4444;">*</span></label>
                    <input type="text" name="name" value="{{ package.name|default('') }}" required class="form-control">
                </div>
                <div class="col-12">
                    <label class="form-label">Beschreibung</label>
                    <textarea name="description" rows="2" class="form-control">{{ package.description|default('') }}</textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Typ</label>
                    <select name="type" class="form-select">
                        <option value="single"       {% if package.type == 'single' %}selected{% endif %}>Einzelstunde</option>
                        <option value="multi"        {% if package.type == 'multi' %}selected{% endif %}>Mehrfachkarte</option>
                        <option value="subscription" {% if package.type == 'subscription' %}selected{% endif %}>Abo</option>
                        <option value="unlimited"    {% if package.type == 'unlimited' %}selected{% endif %}>Flatrate</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Einheiten</label>
                    <input type="number" name="total_units" min="1" value="{{ package.total_units|default(10) }}" class="form-control">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Gültigkeit (Tage)</label>
                    <input type="number" name="valid_days" min="0" value="{{ package.valid_days|default(365) }}" class="form-control">
                    <div class="form-text">0 = unbegrenzt</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Preis (EUR)</label>
                    <input type="number" step="0.01" name="price_eur" value="{{ ((package.price_cents|default(0)) / 100)|number_format(2, '.', '') }}" class="form-control">
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check">
                        <input type="checkbox" name="is_active" value="1" {% if package.is_active %}checked{% endif %} id="is_active" class="form-check-input">
                        <label for="is_active" class="form-check-label">Aktiv (zum Verkauf anbieten)</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <div></div>
        <div class="d-flex gap-2">
            <a href="/pakete" class="btn btn-secondary">Abbrechen</a>
            <button type="submit" class="btn btn-primary">Speichern</button>
        </div>
    </div>
</form>
{% if not is_new %}
<form action="/pakete/{{ package.id }}/loeschen" method="POST" style="max-width:720px;margin-top:-2.5rem;" onsubmit="return confirm('Paket wirklich löschen? Bestehende Kontostände bleiben erhalten.');">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
    <button type="submit" class="btn btn-outline-danger btn-sm">Paket löschen</button>
</form>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
async function kiGenerieren(type) {
    const prompt = document.getElementById('ki-prompt')?.value?.trim();
    if (!prompt) return;
    const btn = document.getElementById('ki-btn');
    const errEl = document.getElementById('ki-error');
    btn.disabled = true; btn.textContent = 'Generiere…'; errEl.style.display = 'none';
    try {
        const res = await fetch('/api/ki/generieren', {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: new URLSearchParams({type, prompt, _csrf_token: document.querySelector('input[name=_csrf_token]')?.value ?? ''})
        });
        const data = await res.json();
        if (!data.ok) throw new Error(data.error ?? 'KI-Fehler');
        if (data.name) document.querySelector('[name=name]').value = data.name;
        if (data.type) { const s = document.querySelector('[name=type]'); if(s) s.value = data.type; }
        if (data.total_units) document.querySelector('[name=total_units]').value = data.total_units;
        if (data.valid_days !== undefined) document.querySelector('[name=valid_days]').value = data.valid_days;
        if (data.price_eur) document.querySelector('[name=price_eur]').value = data.price_eur;
        if (data.description) document.querySelector('[name=description]').value = data.description;
    } catch(e) { errEl.textContent = e.message; errEl.style.display = ''; }
    finally { btn.disabled = false; btn.textContent = 'Ausfüllen'; }
}
</script>
{% endblock %}
