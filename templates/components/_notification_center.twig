{#
  Push Notification Center — Dropdown Component
  Usage: {% include 'components/_notification_center.twig' %}
  Requires push_config to be set in the global context.
#}
{% if push_config is defined and push_config.server_url %}
<div class="push-notification-btn" style="position:relative;display:inline-flex;align-items:center;">
    <button
        type="button"
        class="btn btn-icon btn-ghost"
        data-push-open-center
        aria-label="Benachrichtigungen"
        onclick="document.getElementById('push-notification-dropdown').classList.toggle('is-open')"
        style="position:relative;"
    >
        {# Bell icon #}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        <span class="push-badge" style="position:absolute;top:2px;right:2px;display:none;" aria-label="Ungelesene Benachrichtigungen"></span>
    </button>

    <div id="push-notification-dropdown" class="push-dropdown" style="display:none;position:absolute;top:calc(100% + .5rem);right:0;z-index:1050;min-width:340px;max-width:420px;background:var(--color-surface,#fff);border:1px solid var(--color-border,#e5e7eb);border-radius:.75rem;box-shadow:0 8px 32px rgba(0,0,0,.15);overflow:hidden;">

        <style>
        .push-dropdown.is-open { display:block !important; }
        </style>

        <div class="push-center__header" style="display:flex;align-items:center;justify-content:space-between;padding:.75rem 1rem;border-bottom:1px solid var(--color-border,#e5e7eb);background:var(--color-surface,#fff);">
            <span class="push-center__title" style="font-size:.9rem;font-weight:600;">Benachrichtigungen</span>
            <button
                type="button"
                class="btn btn-xs btn-ghost"
                data-push-mark-all-read
                style="font-size:.75rem;color:var(--color-primary,#4f7cff);"
            >Alle gelesen</button>
        </div>

        <div id="push-notification-list" class="push-center" style="max-height:400px;overflow-y:auto;">
            <div class="push-center__empty" style="padding:2rem 1rem;text-align:center;color:var(--color-text-muted,#6b7280);font-size:.875rem;">
                Laden…
            </div>
        </div>
    </div>
</div>

<script>
// Close notification dropdown when clicking outside
document.addEventListener('click', function(e) {
    const dropdown = document.getElementById('push-notification-dropdown');
    const btn = e.target.closest('[data-push-open-center]');
    if (!btn && dropdown && !dropdown.contains(e.target)) {
        dropdown.classList.remove('is-open');
    }
});
</script>
{% endif %}
