{# ═══════════════════════════════════════════════════════════
   GLOBAL PATIENT DETAIL MODAL — v2.0
   Eingebunden in layout.twig — steht auf jeder Seite bereit.
   Geöffnet via: window._gsOpenPatient(id) / window.showPatientModal(id)

   TABS IM MODAL:
   - Akte          (Timeline + neuer Eintrag)
   - Hausaufgaben
   - Befundbögen
   - Therapiebericht
   - Fortschritt   (TCP)
   - Portal-Check  (TCP)
   ═══════════════════════════════════════════════════════════ #}

{# ── importmap für Three.js ES-Module — muss VOR dem ersten <script type="module"> stehen ── #}
<script type="importmap">
{"imports":{"three":"/assets/js/vendor/three/three.module.min.js"}}
</script>

{# ── Inline CSS für Modal-spezifische Styles ──────────────── #}
<style>
/* ── Mobile Header-Dropdown ─────────────────────────── */
.pd-header-actions {
    display: none;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    margin-left: auto;
}
@media (min-width: 900px) {
    .pd-header-actions {
        display: flex !important;
        flex-direction: row;
        flex-wrap: nowrap;
        position: static;
        background: transparent;
        border: none;
        box-shadow: none;
        padding: 0;
        min-width: 0;
    }
    .pd-mobile-menu-btn { display: none !important; }
}
.pd-header-actions.mobile-open {
    display: flex !important;
    flex-direction: column;
    align-items: stretch;
    position: absolute;
    top: 52px;
    right: 8px;
    z-index: 200;
    background: var(--bs-tertiary-bg, #1e2228);
    border: 1px solid var(--bs-border-color, rgba(255,255,255,0.15));
    border-radius: 10px;
    padding: 0.35rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    min-width: 200px;
    gap: 0.2rem;
}
.pd-header-actions.mobile-open .btn {
    font-size: 0.8rem;
    justify-content: flex-start;
    text-align: left;
    width: 100%;
}
.pd-mobile-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    border: 1px solid var(--bs-border-color, rgba(255,255,255,0.2));
    border-radius: 8px;
    background: transparent;
    color: var(--bs-body-color);
    cursor: pointer;
    flex-shrink: 0;
    margin-left: auto;
}
.pd-btn-label { font-size: 0.8rem; white-space: nowrap; }
@media (min-width: 900px) and (max-width: 1100px) {
    .pd-btn-label { display: none; }
}

/* ── Modal Tab Navigation ───────────────────────────── */
#pd-tab-nav {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    width: 100% !important;
    flex-shrink: 0 !important;
    border-bottom: 1px solid var(--bs-border-color, rgba(255,255,255,0.12));
    background: var(--bs-body-bg);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    position: relative;
    z-index: 10;
}
#pd-tab-nav::-webkit-scrollbar { display: none; }
#pd-tab-nav .pd-tab,
#pd-tab-nav button {
    display: flex !important;
    flex-direction: row !important;
    flex-shrink: 0 !important;
    width: auto !important;
    min-width: max-content !important;
    align-items: center !important;
    gap: 0.35rem;
    padding: 0.6rem 0.9rem;
    border: none;
    background: transparent;
    color: var(--bs-secondary-color, rgba(255,255,255,0.5));
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    white-space: nowrap !important;
    touch-action: manipulation;
}
#pd-tab-nav .pd-tab:hover { color: var(--bs-body-color); }
#pd-tab-nav .pd-tab.active {
    color: var(--bs-primary, #4f7cff);
    border-bottom-color: var(--bs-primary, #4f7cff);
    font-weight: 600;
}
.pd-tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    border-radius: 8px;
    background: var(--bs-primary, #4f7cff);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0 4px;
}

/* ── Tab Panels ─────────────────────────────────────── */
.pd-tab-panel { display: none; }
.pd-tab-panel.active { display: block; }

/* ── Info Card im Modal ─────────────────────────────── */
.pd-info-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--bs-secondary-bg, rgba(255,255,255,0.04));
    border-radius: 10px;
    padding: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
}
.pd-info-photo {
    width: 90px;
    aspect-ratio: 3/4;
    border-radius: 10px;
    overflow: hidden;
    background: var(--bs-tertiary-bg, rgba(255,255,255,0.08));
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    align-self: stretch;
}
.pd-info-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
.pd-info-divider {
    width: 1px; background: var(--bs-border-color, rgba(255,255,255,0.1));
    align-self: stretch; flex-shrink: 0; margin: 0 0.25rem;
}
@media (max-width: 560px) { .pd-info-divider { display: none; } }
.pd-info-col { min-width: 0; flex: 1; }
.pd-info-col-label { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--bs-secondary-color); margin-bottom: 0.4rem; }
.pd-info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem 1rem; font-size: 0.78rem; }
.pd-info-grid > div span:first-child { color: var(--bs-secondary-color); display: block; font-size: 0.68rem; }
.pd-owner-link { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: inherit; }
.pd-owner-avatar { width: 32px; height: 32px; border-radius: 50%; background: rgba(79,124,255,0.2); color: var(--bs-primary); font-size: 0.7rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.pd-owner-name { font-weight: 600; font-size: 0.82rem; }
.pd-owner-meta { font-size: 0.72rem; color: var(--bs-secondary-color); }

/* ── Entry Form ─────────────────────────────────────── */
.pd-entry-section { margin-bottom: 1.25rem; }
.pd-section-label { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--bs-secondary-color); margin-bottom: 0.6rem; }
.pd-entry-form { display: flex; flex-direction: column; gap: 0.6rem; }
.pd-form-grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
@media (max-width: 600px) { .pd-form-grid4 { grid-template-columns: 1fr 1fr; } }
.pd-field label.pd-label { font-size: 0.72rem; color: var(--bs-secondary-color); display: block; margin-bottom: 3px; }
.pd-input, .pd-select { width: 100%; font-size: 0.82rem; }
.pd-file { font-size: 0.8rem; }
.pd-form-footer { display: flex; gap: 0.75rem; align-items: flex-end; flex-wrap: wrap; }
.pd-submit-btn { flex-shrink: 0; }

/* ── Timeline ───────────────────────────────────────── */
.timeline { display: flex; flex-direction: column; gap: 0.5rem; }
.timeline-item { display: flex; gap: 0.75rem; position: relative; }
.timeline-dot { width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--bs-border-color); background: var(--bs-body-bg); flex-shrink: 0; margin-top: 0.35rem; }
.timeline-dot-note     { border-color: #4f7cff; background: rgba(79,124,255,0.3); }
.timeline-dot-treatment{ border-color: #22c55e; background: rgba(34,197,94,0.3); }
.timeline-dot-photo    { border-color: #f59e0b; background: rgba(245,158,11,0.3); }
.timeline-dot-document { border-color: #a855f7; background: rgba(168,85,247,0.3); }
.timeline-dot-other    { border-color: #94a3b8; background: rgba(148,163,184,0.3); }
.timeline-card { flex: 1; min-width: 0; background: var(--bs-secondary-bg, rgba(255,255,255,0.04)); border: 1px solid var(--bs-border-color, rgba(255,255,255,0.08)); border-radius: 8px; padding: 0.6rem 0.75rem; }
.timeline-meta { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.3rem; flex-wrap: wrap; gap: 0.25rem; }
.timeline-date { font-size: 0.68rem; color: var(--bs-secondary-color); }
.timeline-author { font-size: 0.68rem; color: var(--bs-secondary-color); }
.timeline-title { font-weight: 600; font-size: 0.82rem; margin-bottom: 0.25rem; }
.timeline-content { font-size: 0.8rem; line-height: 1.55; color: var(--bs-body-color); }
.ql-view p { margin: 0 0 0.25rem; }
.ql-view ul, .ql-view ol { padding-left: 1.25rem; margin: 0 0 0.25rem; }

/* ── Therapiebericht Tab ────────────────────────────── */
.vr-card { display: flex; align-items: center; gap: 0.65rem; padding: 0.6rem 0.85rem; border-radius: 8px; background: var(--bs-secondary-bg, rgba(255,255,255,0.04)); border: 1px solid var(--bs-border-color, rgba(255,255,255,0.08)); margin-bottom: 0.4rem; }
.vr-card:last-child { margin-bottom: 0; }

/* ── Fortschritt Tab (TCP) ──────────────────────────── */
.tcp-progress-bar { height: 6px; background: var(--bs-tertiary-bg, rgba(255,255,255,0.1)); border-radius: 999px; margin-top: 4px; overflow: hidden; }
.tcp-progress-bar-fill { height: 100%; border-radius: 999px; }

/* ── Befundbögen Tab ────────────────────────────────── */
.bf-card { display: flex; align-items: center; gap: 0.65rem; padding: 0.6rem 0.85rem; border-radius: 8px; background: var(--bs-secondary-bg, rgba(255,255,255,0.04)); border: 1px solid var(--bs-border-color, rgba(255,255,255,0.08)); margin-bottom: 0.4rem; }

/* ── Spin ───────────────────────────────────────────── */
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes a3d-spin { to { transform: rotate(360deg); } }
.pd-spinner { width: 32px; height: 32px; border: 3px solid var(--bs-border-color, rgba(255,255,255,0.12)); border-top-color: var(--bs-primary, #4f7cff); border-radius: 50%; animation: spin 0.8s linear infinite; }
</style>

{# ── Patient Detail Modal ─────────────────────────────── #}
<div class="modal fade" id="modal-patient-detail" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" style="--bs-modal-height: 92vh;">
        <div class="modal-content" style="display: flex; flex-direction: column; max-height: 92vh;">

            {# ── Header ─────────────────────────────────────────── #}
            <div id="pd-header" style="padding: 0.6rem 0.85rem; border-bottom: 1px solid var(--bs-border-color, rgba(255,255,255,0.12)); flex-shrink: 0; display: flex; align-items: center; gap: 0.55rem; position: relative;">

                {# Foto mini #}
                <div id="pd-photo" style="width: 36px; height: 36px; border-radius: 50%; overflow: hidden; background: var(--bs-tertiary-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" style="opacity: 0.3;"><path stroke="currentColor" stroke-width="1.5" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </div>

                {# Name + Badge #}
                <div style="min-width: 0; flex-shrink: 1; flex-grow: 0; max-width: 180px;">
                    <div style="display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap;">
                        <span id="pd-name" style="font-size: 0.9rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"></span>
                        <span id="pd-badge" class="badge" style="display: none; font-size: 0.6rem;"></span>
                    </div>
                    <div id="pd-species" style="font-size: 0.68rem; color: var(--bs-secondary-color); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"></div>
                </div>

                {# ── Action Buttons (Desktop: inline row, Mobile: dropdown) ── #}

                {# Mobile toggle button #}
                <button type="button" class="pd-mobile-menu-btn" id="pd-mobile-menu-btn" aria-label="Aktionen" >
                    <svg width="15" height="15" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5" fill="currentColor"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/><circle cx="12" cy="19" r="1.5" fill="currentColor"/></svg>
                </button>

                {# Action buttons — einzeln feature-gated, damit Basic-Tenants
                   keine Termine/Rechnungen/Tierarztberichte öffnen können #}
                <div class="pd-header-actions" id="pd-header-actions">
                    {% if features.calendar ?? false %}
                    <button id="pd-new-apt-btn" type="button" class="btn btn-secondary btn-sm" style="padding: 0.3rem 0.55rem;" title="Neuer Termin">
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><line x1="16" y1="2" x2="16" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="8" y1="2" x2="8" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="3" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="2"/><line x1="12" y1="14" x2="12" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="10" y1="16" x2="14" y2="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        <span class="pd-btn-label">Termin</span>
                    </button>
                    {% endif %}
                    {% if features.invoices ?? false %}
                    <button id="pd-invoice-btn" type="button" class="btn btn-secondary btn-sm" style="padding: 0.3rem 0.55rem;">
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline stroke="currentColor" stroke-width="2" stroke-linecap="round" points="14 2 14 8 20 8"/></svg>
                        <span class="pd-btn-label">Rechnung</span>
                    </button>
                    {% endif %}
                    <button type="button" class="btn btn-secondary btn-sm" onclick="exportPatientPDF()" style="padding: 0.3rem 0.55rem;">
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        <span class="pd-btn-label">PDF</span>
                    </button>
                    {% if features.vet_report ?? false %}
                    <a id="pd-vet-report-btn" href="#" target="_blank" class="btn btn-secondary btn-sm" style="padding: 0.3rem 0.55rem;" title="Tierarztbericht">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink: 0;"><ellipse cx="6" cy="5.5" rx="2" ry="2.5"/><ellipse cx="12" cy="4" rx="2" ry="2.5"/><ellipse cx="18" cy="5.5" rx="2" ry="2.5"/><ellipse cx="3.5" cy="11" rx="1.7" ry="2.2"/><path d="M12 9c-3.5 0-7 2.5-7 5.5 0 2 1.2 3.5 3 4 .8.2 1.6.5 2.5.5h3c.9 0 1.7-.3 2.5-.5 1.8-.5 3-2 3-4C19 11.5 15.5 9 12 9z"/></svg>
                        <span class="pd-btn-label">Tier-Bericht</span>
                    </a>
                    {% endif %}
                    <button id="pd-edit-btn" type="button" class="btn btn-primary btn-sm" style="padding: 0.3rem 0.55rem;">
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        <span class="pd-btn-label">Bearbeiten</span>
                    </button>
                    <button id="pd-delete-btn" type="button" class="btn btn-danger btn-sm" onclick="deletePatient()" style="padding: 0.3rem 0.55rem;">
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><polyline stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="3 6 5 6 21 6"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 11v6M14 11v6"/></svg>
                        <span class="pd-btn-label">Löschen</span>
                    </button>
                </div>

                {# Close #}
                <button type="button" class="btn-close ms-1" data-bs-dismiss="modal" aria-label="Schließen" style="flex-shrink: 0;"></button>
            </div>

            {# ── Loading ─────────────────────────────────────────── #}
            <div id="pd-loading" style="display: flex; align-items: center; justify-content: center; padding: 3rem; flex: 1;">
                <div class="pd-spinner"></div>
            </div>

            {# ── Body (hidden until data loaded) ──────────────────── #}
            <div id="pd-body" style="display: none; flex: 1; flex-direction: column; min-height: 0; overflow: hidden;">

                {# ── Tab Navigation ── #}
                <div class="pd-tabs" id="pd-tab-nav" style="display:flex!important;flex-direction:row!important;flex-wrap:nowrap!important;overflow-x:auto!important;overflow-y:hidden!important;width:100%!important;flex-shrink:0!important;-webkit-overflow-scrolling:touch;">
                    <button class="pd-tab active" data-pd-tab="akte">
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"/></svg>
                        {% if is_trainer ?? false %}Trainingsakte{% else %}Akte{% endif %}
                    </button>
                    {% if features.homework ?? false %}
                    <button class="pd-tab" data-pd-tab="hausaufgaben" >
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" d="M9 11l3 3L22 4"/><path stroke="currentColor" stroke-width="2" d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
                        {% if is_trainer ?? false %}Trainingsaufgaben{% else %}Hausaufgaben{% endif %}
                    </button>
                    {% endif %}
                    {% if features.befunde ?? false %}
                    <button class="pd-tab" data-pd-tab="befunde" id="pd-tab-btn-befunde" >
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"/></svg>
                        Befundbögen
                        <span class="pd-tab-badge" id="pd-befunde-count" style="display: none;">0</span>
                    </button>
                    {% endif %}
                    {% if features.befunde ?? false %}
                    <button class="pd-tab" data-pd-tab="schmerzanalyse" id="pd-tab-btn-3d">
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 8v4l3 3"/></svg>
                        Schmerzanalyse
                    </button>
                    {% endif %}
                    {% if features.vet_report ?? false %}
                    <button class="pd-tab" data-pd-tab="therapiebericht" id="pd-tab-btn-vr" >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><ellipse cx="6" cy="5.5" rx="2" ry="2.5"/><ellipse cx="12" cy="4" rx="2" ry="2.5"/><ellipse cx="18" cy="5.5" rx="2" ry="2.5"/><path d="M12 9c-3.5 0-7 2.5-7 5.5 0 2 1.2 3.5 3 4 .8.2 1.6.5 2.5.5h3c.9 0 1.7-.3 2.5-.5 1.8-.5 3-2 3-4C19 11.5 15.5 9 12 9z"/></svg>
                        Tierarztbericht
                        <span class="pd-tab-badge" id="pd-vr-count" style="display: none;">0</span>
                    </button>
                    {% endif %}
                    {% if features.therapy_care ?? false %}
                    <button class="pd-tab" data-pd-tab="fortschritt" id="pd-tab-btn-tcp" >
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><polyline stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        Fortschritt
                    </button>
                    {% endif %}
                    {% if features.patient_portal ?? false %}
                    <button class="pd-tab" data-pd-tab="portal" id="pd-tab-btn-portal" >
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Portal
                        <span class="pd-tab-badge" id="pd-portal-count" style="display: none;">0</span>
                    </button>
                    {% endif %}
                </div>

                {# ── Scrollable panel container ── #}
                <div style="flex: 1; overflow-y: auto; overflow-x: hidden; min-height: 0;">
                    <div style="padding: 1.25rem;">

                        {# Patient Info Card — shown in all tabs #}
                        <div class="pd-info-card">
                            <div id="pd-photo-full" class="pd-info-photo">
                                <svg width="36" height="36" fill="none" viewBox="0 0 24 24" style="opacity: 0.2;"><path stroke="currentColor" stroke-width="1.5" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                            </div>
                            <div class="pd-info-divider"></div>
                            <div class="pd-info-col">
                                <div class="pd-info-col-label">{% if is_trainer ?? false %}Hund{% else %}Patient{% endif %}</div>
                                <div id="pd-details" class="pd-info-grid"></div>
                            </div>
                            <div class="pd-info-divider"></div>
                            <div class="pd-info-col">
                                <div class="pd-info-col-label">{% if is_trainer ?? false %}Halter{% else %}Besitzer{% endif %}</div>
                                <div id="pd-owner"></div>
                            </div>
                        </div>

                        {# ══════════════════════════════════════════════
                           TAB: AKTE
                        ══════════════════════════════════════════════ #}
                        <div class="pd-tab-panel active" id="pd-panel-akte">

                            {# Neuer Eintrag — im Hundeschul-Modus heißt die Akte
                               „Trainingsakte" und der Eintrag „Trainings-Eintrag". Die
                               dahinterliegenden Typ-/Feld-Keys bleiben identisch damit
                               Repository, Timeline-Rendering und JavaScript unverändert
                               funktionieren. #}
                            <div class="pd-entry-section">
                                <div class="pd-section-label">{% if is_trainer ?? false %}Neuer Trainings-Eintrag{% else %}Neuer Akteneintrag{% endif %}</div>
                                <form id="pd-timeline-form" method="POST" enctype="multipart/form-data" class="pd-entry-form">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                                    <div class="pd-form-grid4">
                                        <div class="pd-field">
                                            <label class="pd-label">Typ</label>
                                            <select name="type" class="pd-select form-select form-select-sm" data-no-cs>
                                                <option value="note">📝 Notiz</option>
                                                {% if is_trainer ?? false %}
                                                <option value="treatment">🎾 Training</option>
                                                {% else %}
                                                <option value="treatment">💊 Behandlung</option>
                                                {% endif %}
                                                <option value="photo">📷 Foto</option>
                                                <option value="document">📄 Dokument</option>
                                                <option value="other">📌 Sonstiges</option>
                                            </select>
                                        </div>
                                        {# Behandlungsart nur für Praxis-Tenants — die Option-Liste
                                           wird per Fetch aus treatment_types geladen (siehe Modal-JS).
                                           Für Trainer-Tenants wird das Feld samt verstecktem Submit-Default
                                           ausgeblendet, damit das Raster 3-spaltig bleibt statt 4-spaltig.
                                           Der Backend-Handler akzeptiert fehlendes treatment_type_id. #}
                                        {% if not (is_trainer ?? false) %}
                                        <div class="pd-field">
                                            <label class="pd-label">Behandlungsart</label>
                                            <select name="treatment_type_id" id="pd-treatment-type" class="pd-select form-select form-select-sm" data-no-cs>
                                                <option value="">— keine —</option>
                                            </select>
                                        </div>
                                        {% else %}
                                        {# Versteckter Container — JS-Selector #pd-treatment-type bleibt
                                           auflösbar (verhindert null-Zugriffe in Modal-Init). #}
                                        <select id="pd-treatment-type" name="treatment_type_id" style="display:none;" data-no-cs>
                                            <option value="">— keine —</option>
                                        </select>
                                        {% endif %}
                                        <div class="pd-field">
                                            <label class="pd-label">Datum</label>
                                            <input type="datetime-local" name="entry_date" class="pd-input form-control form-control-sm" value="{{ 'now'|date('Y-m-d\\TH:i') }}">
                                        </div>
                                        <div class="pd-field">
                                            <label class="pd-label">Status</label>
                                            <select name="status_badge" class="pd-select form-select form-select-sm" data-no-cs>
                                                <option value="">— kein —</option>
                                                {% if is_trainer ?? false %}
                                                <option value="Im Training">Im Training</option>
                                                <option value="Pause">Pause</option>
                                                <option value="Prüfung bestanden">Prüfung bestanden</option>
                                                <option value="Prüfung nicht bestanden">Prüfung nicht bestanden</option>
                                                <option value="Kurs abgeschlossen">Kurs abgeschlossen</option>
                                                <option value="Kurs abgebrochen">Kurs abgebrochen</option>
                                                {% else %}
                                                <option value="Schmerzfrei">Schmerzfrei</option>
                                                <option value="In Behandlung">In Behandlung</option>
                                                <option value="Kontrolltermin">Kontrolltermin</option>
                                                <option value="Notfall">Notfall</option>
                                                <option value="Gebessert">Gebessert</option>
                                                <option value="Entlassen">Entlassen</option>
                                                {% endif %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="pd-field">
                                        <label class="pd-label">Titel</label>
                                        <input type="text" name="title" class="pd-input form-control form-control-sm" placeholder="Kurzer Titel...">
                                    </div>
                                    <div class="pd-field">
                                        <label class="pd-label">Inhalt</label>
                                        <div id="pd-quill-editor"></div>
                                        <input type="hidden" name="content" id="pd-content-input">
                                    </div>
                                    <div class="pd-form-footer">
                                        <div class="pd-field" style="flex: 1; min-width: 0;">
                                            <label class="pd-label">Anhang</label>
                                            <input type="file" name="attachment" id="pd-attachment" class="pd-file form-control form-control-sm" accept="image/*,video/*,application/pdf,.doc,.docx" multiple>
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-sm pd-submit-btn">
                                            <svg width="13" height="13" fill="none" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                            Speichern
                                        </button>
                                    </div>
                                </form>
                            </div>

                            {# Termine #}
                            <div id="pd-appointments-section" style="display: none; margin-bottom: 1.25rem;">
                                <div style="border-top: 1px solid var(--bs-border-color); padding-top: 1rem;"></div>
                                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem;">
                                    <div class="pd-section-label" style="margin: 0;">Termine</div>
                                    <a href="/kalender" style="font-size: 0.72rem; color: var(--bs-primary); text-decoration: none;">Alle im Kalender →</a>
                                </div>
                                <div id="pd-appointments-list" style="display: flex; flex-direction: column; gap: 0.4rem;"></div>
                            </div>

                            {# Timeline Suche #}
                            <div style="border-top: 1px solid var(--bs-border-color); padding-top: 1rem; margin-bottom: 0.75rem;">
                                <div style="position: relative;">
                                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" style="position: absolute; left: 0.6rem; top: 50%; transform: translateY(-50%); color: var(--bs-secondary-color); pointer-events: none;"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                    <input id="pd-timeline-search" type="text" class="form-control form-control-sm" placeholder="Timeline durchsuchen..." style="padding-left: 2rem; font-size: 0.83rem;">
                                </div>
                            </div>

                            {# Timeline — Verlauf ist für beide Modi semantisch korrekt #}
                            <div class="pd-section-label">{% if is_trainer ?? false %}Trainings-Verlauf{% else %}Verlauf{% endif %}</div>
                            <div id="pd-timeline" class="timeline"></div>
                        </div>

                        {# ══════════════════════════════════════════════
                           TAB: HAUSAUFGABEN
                        ══════════════════════════════════════════════ #}
                        <div class="pd-tab-panel" id="pd-panel-hausaufgaben">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
                                <div class="pd-section-label" style="margin: 0;">{% if is_trainer ?? false %}Trainingsaufgaben-Pläne{% else %}Hausaufgabenpläne{% endif %}</div>
                                <button type="button" class="btn btn-primary btn-sm" onclick="openHomeworkModal()">
                                    <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                    Neuer Plan
                                </button>
                            </div>
                            <div id="pd-hw-plans-list">
                                <div style="text-align: center; padding: 2rem; color: var(--bs-secondary-color);">
                                    <div class="pd-spinner" style="margin: 0 auto 1rem;"></div>
                                    {% if is_trainer ?? false %}Lade Trainingsaufgaben-Pläne…{% else %}Lade Hausaufgabenpläne…{% endif %}
                                </div>
                            </div>
                        </div>

                        {# ══════════════════════════════════════════════
                           TAB: BEFUNDBÖGEN
                        ══════════════════════════════════════════════ #}
                        <div class="pd-tab-panel" id="pd-panel-befunde">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
                                <div class="pd-section-label" style="margin: 0;">Befundbögen</div>
                                <button type="button" id="pd-befunde-new-link" class="btn btn-primary btn-sm">
                                    <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                    Befundung starten
                                </button>
                            </div>
                            <div id="pd-befunde-list">
                                <div style="text-align: center; padding: 2rem; color: var(--bs-secondary-color);">
                                    <div class="pd-spinner" style="margin: 0 auto 1rem;"></div>
                                    Lade Befundbögen…
                                </div>
                            </div>
                        </div>

                        {# ══════════════════════════════════════════════
                           TAB: 3D SCHMERZANALYSE
                        ══════════════════════════════════════════════ #}
                        <div class="pd-tab-panel" id="pd-panel-schmerzanalyse">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;flex-wrap:wrap;gap:0.5rem;">
                                <div class="pd-section-label" style="margin:0;">3D Schmerzanalyse</div>
                                <span style="font-size:.72rem;color:var(--bs-secondary-color);">Klicke auf eine Körperregion um Schmerzen zu erfassen</span>
                            </div>
                            {# 3D-Viewer Container — wird beim Tab-Wechsel initialisiert #}
                            <div id="pd-3d-viewer-wrap" style="width:100%;height:clamp(320px,60vh,600px);border-radius:12px;overflow:hidden;background:#0a0f1a;"></div>
                        </div>

                        {# ══════════════════════════════════════════════
                           TAB: THERAPIEBERICHT / TIERARZTBERICHT
                        ══════════════════════════════════════════════ #}
                        <div class="pd-tab-panel" id="pd-panel-therapiebericht">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
                                <div class="pd-section-label" style="margin: 0;">Tierarztberichte</div>
                                <button type="button" class="btn btn-primary btn-sm" onclick="openVetReportChoiceModal(null)">
                                    <svg width="12" height="12" fill="none" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                    Neuer Bericht
                                </button>
                            </div>
                            <div id="pd-vr-list">
                                <div style="text-align: center; padding: 2rem; color: var(--bs-secondary-color);">
                                    <div class="pd-spinner" style="margin: 0 auto 1rem;"></div>
                                    Lade Tierarztberichte…
                                </div>
                            </div>
                        </div>

                        {# ══════════════════════════════════════════════
                           TAB: FORTSCHRITT (TCP)
                        ══════════════════════════════════════════════ #}
                        <div class="pd-tab-panel" id="pd-panel-fortschritt">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
                                <div class="pd-section-label" style="margin: 0;" id="pd-tcp-heading">
                                    {% if is_trainer ?? false %}Trainings-Fortschritt{% else %}Therapiefortschritt{% endif %}
                                </div>
                                <div style="display:flex;gap:0.35rem;flex-wrap:wrap;">
                                    {# Story-Button — Sichtbarkeit per JS (abh. von media.length). Öffnet Story in neuem Tab. #}
                                    <a id="pd-tcp-story-btn" href="#" target="_blank" rel="noopener"
                                       class="btn btn-primary btn-sm" style="font-size:0.75rem;display:none;">
                                        <svg width="11" height="11" fill="none" viewBox="0 0 24 24" style="vertical-align:-1px;"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><polyline stroke="currentColor" stroke-width="2" points="12 6 12 12 16 14"/></svg>
                                        <span id="pd-tcp-story-btn-label">
                                            {% if is_trainer ?? false %}Trainings-Story{% else %}Therapie-Story{% endif %}
                                        </span>
                                    </a>
                                    <button type="button" class="btn btn-secondary btn-sm" style="font-size:0.75rem;" onclick="openTcpFullView('progress')">Vollansicht →</button>
                                </div>
                            </div>
                            {# Verlaufsgrafik #}
                            <div id="pd-tcp-chart-wrap" style="display:none;border-radius:10px;border:1px solid var(--bs-border-color);padding:0.75rem;margin-bottom:1rem;">
                                <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--bs-secondary-color);margin-bottom:0.5rem;">Verlaufsgrafik</div>
                                <div style="position:relative;height:160px;"><canvas id="pd-tcp-chart"></canvas></div>
                            </div>
                            <div id="pd-fortschritt-list">
                                <div style="text-align: center; padding: 2rem; color: var(--bs-secondary-color); font-size: 0.85rem;">
                                    Keine Fortschrittsdaten vorhanden.
                                </div>
                            </div>
                            {# Naturheilkunde #}
                            <div id="pd-natural-section" style="display: none; margin-top: 1.5rem;">
                                <div style="border-top: 1px solid var(--bs-border-color); padding-top: 1rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                    <div class="pd-section-label" style="margin: 0;">Naturheilkunde</div>
                                    <button type="button" class="btn btn-secondary btn-sm" style="font-size:0.75rem;" onclick="openTcpFullView('natural')">Vollansicht →</button>
                                </div>
                                <div id="pd-natural-list" style="display: flex; flex-direction: column; gap: 0.4rem;"></div>
                            </div>
                            {# TCP Berichte #}
                            <div id="pd-tcp-reports-section" style="display: none; margin-top: 1.5rem;">
                                <div style="border-top: 1px solid var(--bs-border-color); padding-top: 1rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                    <div class="pd-section-label" style="margin: 0;">Therapieberichte</div>
                                    <button type="button" class="btn btn-secondary btn-sm" style="font-size:0.75rem;" onclick="openTcpFullView('reports')">Alle Berichte →</button>
                                </div>
                                <div id="pd-tcp-reports-list" style="display: flex; flex-direction: column; gap: 0.4rem;"></div>
                            </div>

                            {# ═══════════════════════════════════════════════
                               VORHER / NACHHER MEDIEN (Sprint A · L1.1)
                               Wird per JS in loadTcpData() befüllt — Upload,
                               Galerie und Story-Button werden dort gesteuert.
                               Struktur bleibt im DOM, damit CSS-Transitionen
                               sauber greifen.
                            ═══════════════════════════════════════════════ #}
                            <div id="pd-tcp-media-section" style="margin-top: 1.5rem;">
                                <div style="border-top: 1px solid var(--bs-border-color); padding-top: 1rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap:wrap; gap:.4rem;">
                                    <div class="pd-section-label" style="margin: 0; display:flex; align-items:center; gap:.35rem;">
                                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" style="vertical-align:-1px;"><rect stroke="currentColor" stroke-width="2" x="3" y="3" width="18" height="18" rx="2"/><circle stroke="currentColor" stroke-width="2" cx="8.5" cy="8.5" r="1.5"/><polyline stroke="currentColor" stroke-width="2" points="21 15 16 10 5 21"/></svg>
                                        Vorher / Nachher Medien
                                    </div>
                                    <span id="pd-tcp-media-count" style="font-size:.68rem;color:var(--bs-secondary-color);">0 Dateien</span>
                                </div>

                                {# Upload-Form — action wird per JS auf den gewählten Eintrag gesetzt. #}
                                <form id="pd-tcp-media-form" method="POST" enctype="multipart/form-data" action="#"
                                      style="display:grid;grid-template-columns:1fr 1fr auto;gap:.4rem;margin-bottom:.6rem;">
                                    <input type="hidden" name="_csrf_token" id="pd-tcp-media-csrf" value="">
                                    <select name="_entry_id" id="pd-tcp-media-entry-sel" class="form-select form-select-sm" required
                                            style="grid-column:1 / -1;">
                                        <option value="">— Eintrag zur Zuordnung wählen —</option>
                                    </select>
                                    <select name="phase_label" class="form-select form-select-sm">
                                        <option value="vorher">Vorher</option>
                                        <option value="nachher">Nachher</option>
                                        <option value="verlauf" selected>Verlauf</option>
                                    </select>
                                    <input type="file" name="media[]" class="form-control form-control-sm"
                                           accept="image/*,video/*,audio/*" multiple required>
                                    <button type="submit" class="btn btn-primary btn-sm" style="white-space:nowrap;">
                                        <svg width="11" height="11" fill="none" viewBox="0 0 24 24" style="vertical-align:-1px;"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                        Upload
                                    </button>
                                    <div style="grid-column:1 / -1;font-size:.65rem;color:var(--bs-secondary-color);">
                                        Max. 25 MB pro Datei · Bilder, Videos, Audio · Mehrfach möglich
                                    </div>
                                </form>

                                {# Galerie — gruppiert pro Eintrag, von JS befüllt. #}
                                <div id="pd-tcp-media-gallery" style="max-height:280px;overflow-y:auto;"></div>
                                <div id="pd-tcp-media-empty" style="text-align:center;padding:1rem;color:var(--bs-secondary-color);font-size:.78rem;">
                                    Noch keine Medien hochgeladen.
                                </div>
                            </div>
                        </div>

                        {# ══════════════════════════════════════════════
                           TAB: PORTAL-CHECKLISTE
                        ══════════════════════════════════════════════ #}
                        <div class="pd-tab-panel" id="pd-panel-portal">
                            <div class="pd-section-label">Vom Besitzer abgehakte Aufgaben</div>
                            <div id="pd-portal-list">
                                <div style="text-align: center; padding: 2rem; color: var(--bs-secondary-color); font-size: 0.85rem;">
                                    Noch keine abgehakten Aufgaben.
                                </div>
                            </div>
                        </div>

                    </div>{# end inner padding div #}
                </div>{# end scrollable container #}

            </div>{# end pd-body #}

        </div>{# end modal-content #}
    </div>
</div>

{# ── Upload-Progress ─────────────────────────────────── #}
<div id="pd-upload-progress" style="display:none;position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;background:var(--bs-body-bg);border:1px solid var(--bs-border-color);border-radius:10px;padding:0.85rem 1.1rem;min-width:260px;box-shadow:0 8px 24px rgba(0,0,0,0.35);">
    <div style="font-size:0.78rem;color:var(--bs-secondary-color);margin-bottom:0.5rem;" id="pd-upload-label">Video wird hochgeladen…</div>
    <div style="background:var(--bs-tertiary-bg);border-radius:999px;height:6px;overflow:hidden;">
        <div id="pd-upload-bar" style="height:100%;width:0%;background:var(--bs-primary);border-radius:999px;transition:width 0.2s;"></div>
    </div>
</div>

{# ── Timeline-Eintrag bearbeiten Modal ────────────────── #}
<div class="modal fade" id="modal-timeline-edit" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title">Eintrag bearbeiten</h3>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="te-csrf" value="{{ csrf_token }}">
            <input type="hidden" id="te-entry-id" value="">
            <input type="hidden" id="te-patient-id" value="">
            <div class="pd-form-grid4" style="margin-bottom: 0.65rem;">
                <div class="pd-field">
                    <label class="pd-label">Typ</label>
                    <select id="te-type" class="form-select form-select-sm">
                        <option value="note">📝 Notiz</option>
                        <option value="treatment">💊 Behandlung</option>
                        <option value="photo">📷 Foto</option>
                        <option value="document">📄 Dokument</option>
                        <option value="other">📌 Sonstiges</option>
                    </select>
                </div>
                <div class="pd-field">
                    <label class="pd-label">Behandlungsart</label>
                    <select id="te-treatment-type" class="form-select form-select-sm">
                        <option value="">— keine —</option>
                    </select>
                </div>
                <div class="pd-field">
                    <label class="pd-label">Datum</label>
                    <input type="datetime-local" id="te-date" class="form-control form-control-sm">
                </div>
                <div class="pd-field">
                    <label class="pd-label">Status</label>
                    <select id="te-status" class="form-select form-select-sm">
                        <option value="">— kein —</option>
                        <option value="Schmerzfrei">Schmerzfrei</option>
                        <option value="In Behandlung">In Behandlung</option>
                        <option value="Kontrolltermin">Kontrolltermin</option>
                        <option value="Notfall">Notfall</option>
                        <option value="Gebessert">Gebessert</option>
                        <option value="Entlassen">Entlassen</option>
                    </select>
                </div>
            </div>
            <div class="pd-field" style="margin-bottom: 0.65rem;">
                <label class="pd-label">Titel</label>
                <input type="text" id="te-title" class="form-control form-control-sm" placeholder="Kurzer Titel...">
            </div>
            <div class="pd-field">
                <label class="pd-label">Inhalt</label>
                <div id="te-quill-editor"></div>
                <input type="hidden" id="te-content" value="">
            </div>
