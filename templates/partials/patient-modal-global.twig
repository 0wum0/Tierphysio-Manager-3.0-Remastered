   TIMELINE EDIT MODAL
═══════════════════════════════════════════════════════ */
function initTeQuill() {
    loadQuill(function() {
        if (teQuill) return;
        var el = document.getElementById('te-quill-editor');
        if (!el) return;
        teQuill = new Quill(el, { theme:'snow', placeholder:'Inhalt…', modules:{toolbar:[['bold','italic','underline','strike'],[{list:'ordered'},{list:'bullet'}],['blockquote'],[{color:[]}],['clean']]} });
    });
}

function openTimelineEditModal(entry, patientId) {
    initTeQuill();
    setTimeout(function() {
        document.getElementById('te-entry-id').value   = entry.id;
        document.getElementById('te-patient-id').value = patientId || (currentPatientData ? currentPatientData.patient.id : '');
        var tySel=document.getElementById('te-type'); for(var i=0;i<tySel.options.length;i++) tySel.options[i].selected=tySel.options[i].value===(entry.type||'note');
        var ttSel=document.getElementById('te-treatment-type'); ttSel.innerHTML='<option value="">— keine —</option>';
        if (currentPatientData && currentPatientData.treatment_types) {
            currentPatientData.treatment_types.forEach(function(tt){ var o=document.createElement('option'); o.value=tt.id; o.textContent=tt.name; o.selected=parseInt(entry.treatment_type_id)===parseInt(tt.id); ttSel.appendChild(o); });
        }
        if (entry.entry_date) {
            var d=new Date(entry.entry_date.replace(' ','T'));
            var pad=function(n){return String(n).padStart(2,'0');};
            document.getElementById('te-date').value=d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes());
        }
        var stSel=document.getElementById('te-status'); for(var i=0;i<stSel.options.length;i++) stSel.options[i].selected=stSel.options[i].value===(entry.status_badge||'');
        document.getElementById('te-title').value=entry.title||'';
        if (teQuill) { if(entry.content) teQuill.clipboard.dangerouslyPasteHTML(entry.content); else teQuill.setContents([]); }
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-timeline-edit')).show();
    },100);
}

var teSaveBtn = document.getElementById('te-save-btn');
if (teSaveBtn) {
    teSaveBtn.addEventListener('click', function() {
        var entryId   = document.getElementById('te-entry-id').value;
        var patientId = document.getElementById('te-patient-id').value;
        var csrf      = document.getElementById('te-csrf').value;
        if (!entryId || !patientId) return;
        if (teQuill) document.getElementById('te-content').value = teQuill.root.innerHTML;
        var fd=new FormData();
        fd.append('_csrf_token',csrf);
        fd.append('type',document.getElementById('te-type').value);
        fd.append('treatment_type_id',document.getElementById('te-treatment-type').value);
        fd.append('title',document.getElementById('te-title').value);
        fd.append('content',document.getElementById('te-content').value);
        fd.append('status_badge',document.getElementById('te-status').value);
        fd.append('entry_date',document.getElementById('te-date').value);
        teSaveBtn.disabled=true; teSaveBtn.textContent='Speichern…';
        fetch('/patienten/'+patientId+'/timeline/'+entryId+'/update-json',{method:'POST',body:fd})
            .then(function(r){return r.json();})
            .then(function(data){ if(data.ok){ bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-timeline-edit')).hide(); renderTimeline(data.timeline,patientId); _hwShowToast('✓ Eintrag aktualisiert','success'); } else { _hwShowToast('Fehler beim Speichern.','error'); } })
            .catch(function(){ _hwShowToast('Netzwerkfehler.','error'); })
            .finally(function(){ teSaveBtn.disabled=false; teSaveBtn.textContent='Speichern'; });
    });
}

/* ═══════════════════════════════════════════════════════
   EDIT PATIENT
═══════════════════════════════════════════════════════ */
var pdEditBtn = document.getElementById('pd-edit-btn');
if (pdEditBtn) {
    pdEditBtn.addEventListener('click', function() {
        if (!currentPatientData) return;
        var p=currentPatientData.patient, o=currentPatientData.owner;
        var form=document.getElementById('edit-patient-form');
        form.action='/patienten/'+p.id;
        document.getElementById('edit-modal-title').textContent=(p.name||'Patient')+' bearbeiten';
        document.getElementById('edit-name').value    = p.name||'';
        document.getElementById('edit-species').value = p.species||'';
        document.getElementById('edit-breed').value   = p.breed||'';
        document.getElementById('edit-birth').value   = p.birth_date ? p.birth_date.slice(0,10) : '';
        document.getElementById('edit-color').value   = p.color||'';
        document.getElementById('edit-chip').value      = p.chip_number||'';
        document.getElementById('edit-vet-name').value  = p.vet_name||'';
        document.getElementById('edit-vet-phone').value = p.vet_phone||'';
        document.getElementById('edit-vet-address').value = p.vet_address||'';
        document.getElementById('edit-notes').value     = p.notes||'';
        var gSel=document.getElementById('edit-gender'); for(var i=0;i<gSel.options.length;i++) gSel.options[i].selected=gSel.options[i].value===(p.gender||'unbekannt');
        var sSel=document.getElementById('edit-status'); for(var i=0;i<sSel.options.length;i++) sSel.options[i].selected=sSel.options[i].value===(p.status||'aktiv');
        var oSel=document.getElementById('edit-owner');
        oSel.innerHTML='<option value="">— wird geladen… —</option>';
        var currentOwnerId=parseInt(p.owner_id||(o&&o.id)||0);
        fetch('/api/tierhalter/suche?q=').then(function(r){return r.json();}).then(function(owners){
            oSel.innerHTML='<option value="">— wählen —</option>';
            owners.forEach(function(owner){ var opt=document.createElement('option'); opt.value=owner.id; opt.textContent=owner.last_name+', '+owner.first_name; if(parseInt(owner.id)===currentOwnerId) opt.selected=true; oSel.appendChild(opt); });
        }).catch(function(){ oSel.innerHTML='<option value="">— Fehler beim Laden —</option>'; });
        var prev=document.getElementById('edit-photo-preview');
        if (p.photo) prev.innerHTML='<img src="/patienten/'+p.id+'/foto/'+encodeURIComponent(p.photo)+'" style="width:100%;height:100%;object-fit:cover;">';
        else prev.innerHTML='<svg width="28" height="28" fill="none" viewBox="0 0 24 24" style="opacity:0.3;"><path stroke="currentColor" stroke-width="1.5" d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/></svg>';

        /* ── Stacked-Modal-Fix ─────────────────────────────────
           Bootstrap 5 unterstützt nativ keine gestapelten Modals.
           Backdrop des zweiten Modals liegt sonst über dem ersten
           Modal-Content → das Edit-Modal erscheint ausgegraut /
           nicht klickbar. Wir schließen deshalb das Detail-Modal
           zuerst und merken uns, dass es nach dem Schließen des
           Edit-Modals wieder geöffnet werden soll. */
        var detailEl = document.getElementById('modal-patient-detail');
        var editEl   = document.getElementById('modal-edit-patient-inline');
        if (!editEl) return;

        if (detailEl && detailEl.classList.contains('show')) {
            editEl.dataset.pdReopenDetail = '1';
            bootstrap.Modal.getOrCreateInstance(detailEl).hide();
            /* Erst nach vollständigem Fade-Out des Detail-Modals öffnen,
               damit die body.modal-open-Klasse + Backdrop sauber
               entfernt werden (sonst verliert das Edit-Modal seinen
               Scroll/Focus-Kontext). */
            detailEl.addEventListener('hidden.bs.modal', function onceHidden() {
                detailEl.removeEventListener('hidden.bs.modal', onceHidden);
                bootstrap.Modal.getOrCreateInstance(editEl).show();
            });
        } else {
            bootstrap.Modal.getOrCreateInstance(editEl).show();
        }
    });
}

/* ── Edit-Modal geschlossen (Abbruch oder X) → Detail-Modal
