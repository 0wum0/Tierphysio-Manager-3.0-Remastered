        });
    });

    /* ── SVG JS laden (einmalig) ── */
    if (window.befundAnatomyInit) {
        /* nichts — wird on-demand beim Tab-Klick aufgerufen */
    } else if (!document.querySelector('script[data-befund-anatomy]')) {
        var scr = document.createElement('script');
        scr.src = '/assets/js/befund-anatomy.js';
        scr.setAttribute('data-befund-anatomy', '1');
        document.head.appendChild(scr);
    }

    /* ── Speichern ── */
    var saveBtn = document.getElementById('pd-befund-inline-save');
    if (saveBtn) saveBtn.addEventListener('click', function() { saveBefundInline(patientId); });

    /* ── Abbrechen → zurück zur Liste ── */
    var cancelBtn = document.getElementById('pd-befund-inline-cancel');
    if (cancelBtn) cancelBtn.addEventListener('click', function() {
        _befundeLoaded = false;
        loadBefundboegen(patientId);
    });
}

function saveBefundInline(patientId) {
    var form = document.getElementById('pd-befund-inline-form');
    if (!form) return;

    var sendNow = (document.getElementById('pd-befund-send-now') || {}).checked || false;

    var btn = document.getElementById('pd-befund-inline-save');
    if (btn) { btn.disabled = true; btn.textContent = sendNow ? 'Speichern & Senden\u2026' : 'Speichern\u2026'; }

    var csrfToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';

    /* Alle benannten Felder im Formular sammeln */
    var fields = [
        'datum','status','naechster_termin','notizen',
        'hauptbeschwerde','seit_wann','vorerkrankungen','medikamente','allergien',
        'ernaehrung','bewegung','haltung','bisherige_therapien',
        'allgemeinbefinden','ernaehrungszustand','temperament','koerpertemperatur',
        'koerperhaltung','gangbild','lahmheitsgrad',
        'betroffene_regionen','muskeltonus','triggerpunkte','gelenke_befund',
        'neurologischer_status',
        'konstitutionstyp','energetischer_eindruck','bachblueten_auswahl',
        'bachblueten_dosierung','homoeopathie_mittel','homoeopathie_potenz',
        'homoeopathie_dauer','phytotherapie','schuesslersalze','weitere_naturheilmittel',
        'pt_methoden','therapieziele','hausaufgaben','therapiefrequenz',
        'therapiedauer','kontrolltermin','verlauf_notizen',
        'anatomy_species','anatomy_markers','anatomy_drawings','schmerz_nrs',
    ];

    var params = new URLSearchParams({ _csrf_token: csrfToken });
    fields.forEach(function(name) {
        var el = form.querySelector('[name="' + name + '"]');
        if (el && el.value.trim() !== '') params.append(name, el.value);
    });
    console.log('[saveBefund] params:', params.toString().substring(0, 500));

    fetch('/patienten/' + patientId + '/befunde/speichern', {
        method:  'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
        body:    params.toString(),
    })
    .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function(data) {
        if (data.success) {
            if (sendNow) {
                /* Checkbox war gesetzt → sofort senden, dann Erfolgsmeldung */
                var csrfToken2 = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
                fetch('/patienten/' + patientId + '/befunde/' + data.id + '/senden', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                    body:    new URLSearchParams({ _csrf_token: csrfToken2 }).toString(),
                })
                .then(function(r) { return r.json().catch(function(){ return {}; }); })
                .then(function(sendData) {
                    var container = document.getElementById('pd-befunde-list');
                    if (!container) return;
                    if (sendData.success !== false) {
                        container.innerHTML =
                            '<div style="border:1px solid #22c55e44;border-radius:10px;padding:1rem;background:rgba(34,197,94,.08);">' +
                            '<div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem;">' +
                            '<svg width="20" height="20" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="#22c55e" stroke-width="2"/><path stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M8 12l3 3 5-5"/></svg>' +
                            '<span style="font-weight:700;color:#22c55e;">Befundbogen gespeichert &amp; versendet!</span>' +
                            '</div>' +
                            '<div style="font-size:.82rem;color:var(--bs-secondary-color);margin-bottom:.75rem;">📧 E-Mail wurde an den Tierhalter gesendet.</div>' +
                            '<div style="display:flex;gap:.5rem;flex-wrap:wrap;">' +
                            '<a href="' + escapeHtmlPd(data.url || '/patienten/'+patientId+'/befunde/'+data.id) + '" target="_blank" class="btn btn-sm btn-outline-secondary" style="font-size:.8rem;">Befund ansehen ↗</a>' +
                            '<button type="button" class="btn btn-sm btn-link" style="font-size:.8rem;" onclick="(function(){_befundeLoaded=false;loadBefundboegen('+patientId+')}())">Zur Liste</button>' +
                            '</div></div>';
                    } else {
                        container.innerHTML =
                            '<div style="border:1px solid #22c55e44;border-radius:10px;padding:1rem;background:rgba(34,197,94,.08);margin-bottom:.5rem;">' +
                            '<span style="font-weight:700;color:#22c55e;">✓ Gespeichert</span></div>' +
                            '<div style="border:1px solid #ef444444;border-radius:10px;padding:.75rem;background:rgba(239,68,68,.08);font-size:.82rem;">' +
                            '⚠️ E-Mail konnte nicht gesendet werden: ' + escapeHtmlPd(sendData.error || 'Unbekannter Fehler') +
                            '<div style="margin-top:.5rem;"><button type="button" class="btn btn-sm btn-primary" style="font-size:.8rem;" onclick="sendBefundFromModal('+patientId+','+data.id+',this)">📧 Erneut senden</button></div></div>';
                    }
                })
                .catch(function() {
                    /* Senden fehlgeschlagen, aber gespeichert */
                    var container = document.getElementById('pd-befunde-list');
                    if (container) container.innerHTML =
                        '<div style="border:1px solid #22c55e44;border-radius:10px;padding:1rem;background:rgba(34,197,94,.08);">' +
                        '<span style="font-weight:700;color:#22c55e;">✓ Gespeichert</span><br>' +
                        '<span style="font-size:.82rem;color:var(--bs-danger-rgb);">E-Mail-Versand fehlgeschlagen.</span>' +
                        '<div style="margin-top:.5rem;"><button type="button" class="btn btn-sm btn-primary btn-sm" onclick="sendBefundFromModal('+patientId+','+data.id+',this)">📧 Erneut senden</button></div></div>';
                });
            } else {
                /* Checkbox nicht gesetzt → Erfolgspanel mit manuellem Sende-Button */
                var container = document.getElementById('pd-befunde-list');
                if (container) {
                    container.innerHTML =
                        '<div style="border:1px solid #22c55e44;border-radius:10px;padding:1rem;background:rgba(34,197,94,.08);">' +
                        '<div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem;">' +
                        '<svg width="20" height="20" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="#22c55e" stroke-width="2"/><path stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M8 12l3 3 5-5"/></svg>' +
                        '<span style="font-weight:700;color:#22c55e;">Befundbogen gespeichert!</span>' +
                        '</div>' +
                        '<div style="display:flex;gap:.5rem;flex-wrap:wrap;">' +
                        '<a href="' + escapeHtmlPd(data.url || '/patienten/'+patientId+'/befunde/'+data.id) + '" target="_blank" class="btn btn-sm btn-outline-secondary" style="font-size:.8rem;">Befund ansehen ↗</a>' +
                        '<button type="button" class="btn btn-sm btn-primary" style="font-size:.8rem;" onclick="sendBefundFromModal(' + patientId + ',' + data.id + ',this)">📧 Per E-Mail senden</button>' +
                        '<button type="button" class="btn btn-sm btn-link" style="font-size:.8rem;" onclick="(function(){_befundeLoaded=false;loadBefundboegen('+patientId+')}())">Zur Liste</button>' +
                        '</div>' +
                        '</div>';
                }
            }
        } else {
            throw new Error(data.error || 'Fehler');
        }
    })
    .catch(function(e) {
        console.error('[Befund inline save]', e);
        if (btn) { btn.disabled = false; btn.textContent = 'Befund speichern'; }
        alert('Befund konnte nicht gespeichert werden: ' + e.message);
    });
}

window.sendBefundFromModal = function sendBefundFromModal(patientId, befundId, triggerBtn) {
    if (!confirm('Befundbogen per E-Mail an den Tierhalter senden?')) return;
    if (triggerBtn) { triggerBtn.disabled = true; triggerBtn.textContent = 'Senden…'; }

    var csrfToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
    fetch('/patienten/' + patientId + '/befunde/' + befundId + '/senden', {
        method:  'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
        body:    new URLSearchParams({ _csrf_token: csrfToken }).toString(),
    })
    .then(function(r) { return r.json().catch(function(){ return {}; }); })
    .then(function(data) {
        if (triggerBtn) {
            if (data.success !== false) {
                triggerBtn.textContent = '✓ Versendet';
                triggerBtn.classList.replace('btn-primary', 'btn-success');
            } else {
                triggerBtn.disabled = false;
                triggerBtn.textContent = '📧 Per E-Mail senden';
                alert('Fehler: ' + (data.error || 'E-Mail konnte nicht gesendet werden.'));
            }
        }
    })
    .catch(function(e) {
        console.error('[Befund send]', e);
        if (triggerBtn) { triggerBtn.disabled = false; triggerBtn.textContent = '📧 Per E-Mail senden'; }
        alert('E-Mail konnte nicht gesendet werden.');
    });
}

function resolveSpeciesSuggestion(raw) {
    var s = String(raw || '').toLowerCase();
    if (!s) return 'dog';
    if (/katz|cat/.test(s))                    return 'cat';
    if (/pferd|horse|pony|equin/.test(s))      return 'horse';
    if (/hund|dog|canin/.test(s))              return 'dog';
    return 'dog';
}

function escapeHtmlPd(s) {
    return String(s).replace(/[&<>"']/g, function(c) {
        return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
}

/* ═══════════════════════════════════════════════════════
   3D SCHMERZANALYSE VIEWER
═══════════════════════════════════════════════════════ */
var _3dScriptAppended = false;
var _3dInitPending   = false;

function init3DViewer(patientId) {
    if (_3dViewerLoaded) return;
    _3dViewerLoaded = true;
    _3dInitPending   = true;

    var wrap = document.getElementById('pd-3d-viewer-wrap');
    if (!wrap) return;

    var species = 'dog';
    if (currentPatientData && currentPatientData.patient) {
        species = resolveSpeciesSuggestion(currentPatientData.patient.species || '');
    }

    var csrfToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';

    /* Show spinner */
    wrap.innerHTML = '<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#0a0f1a;border-radius:12px;">' +
        '<div style="text-align:center;">' +
        '<div style="width:36px;height:36px;border:3px solid rgba(255,255,255,.12);border-top-color:#4f7cff;border-radius:50%;animation:a3d-spin .8s linear infinite;margin:0 auto 12px;"></div>' +
        '<div style="color:#64748b;font-size:.8rem;">3D-Viewer wird geladen…</div></div></div>';

    /* If module already loaded (cached from previous open), init directly */
    if (window.Anatomy3D) {
        _doInit3D(patientId, species, csrfToken);
        return;
    }

    /* Append script tag only once per page load */
    if (!_3dScriptAppended) {
        _3dScriptAppended = true;
        var s = document.createElement('script');
        s.type = 'module';
        s.src  = '/assets/js/anatomy-3d-viewer.js?v=20260616c';
        s.onerror = function() {
            _3dInitPending = false;
            var w = document.getElementById('pd-3d-viewer-wrap');
            if (w) w.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#ef4444;font-size:.85rem;padding:1rem;text-align:center;">3D-Viewer konnte nicht geladen werden.</div>';
        };
        document.body.appendChild(s);
    }

    /* Poll until window.Anatomy3D is set by the module — fires exactly once */
    _waitForViewer(function() { _doInit3D(patientId, species, csrfToken); });
}

function _waitForViewer(cb) {
    if (window.Anatomy3D) { cb(); return; }
    var attempts = 0;
    var t = setInterval(function() {
        attempts++;
        if (window.Anatomy3D) { clearInterval(t); cb(); return; }
        if (attempts > 150) { /* 12s timeout */
            clearInterval(t);
            var wrap = document.getElementById('pd-3d-viewer-wrap');
            if (wrap) wrap.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#ef4444;font-size:.85rem;">3D-Viewer konnte nicht geladen werden.<br>Bitte Seite neu laden.</div>';
        }
    }, 80);
}

function _doInit3D(patientId, species, csrfToken) {
    if (!_3dInitPending) return; /* guard against double calls */
    _3dInitPending = false;
    if (!window.Anatomy3D) return;
    var wrap = document.getElementById('pd-3d-viewer-wrap');
    if (!wrap) return;
    wrap.innerHTML = '';
    window.Anatomy3D.init('pd-3d-viewer-wrap', patientId, species, csrfToken);
}

})();
</script>
