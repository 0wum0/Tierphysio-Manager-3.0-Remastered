window._gsOpenPatient   = openPatientModal;
window.showPatientModal = openPatientModal;

// Vet Report Choice & Logic
window._vrChoicePatientId = null;

window.openVetReportChoiceModal = function(pid) {
    window._vrChoicePatientId = pid || window.pdAktPatientId || (typeof patientId !== 'undefined' ? patientId : null);
    if (!window._vrChoicePatientId) return;
    var el = document.getElementById('modal-vet-report-choice');
    var m = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el, {backdrop: false});
    m.show();
};

window.handleVetReportChoice = function(type) {
    var pid = window._vrChoicePatientId;
    var choiceInst = bootstrap.Modal.getInstance(document.getElementById('modal-vet-report-choice'));
    if (choiceInst) choiceInst.hide();
    
    if (type === 'auto') {
        window.open('/patienten/' + pid + '/tierarztbericht', '_blank');
    } else {
        openPdCustomVetReportModal();
    }
};

window.openPdCustomVetReportModal = function() {
    var pid = window._vrChoicePatientId || window.pdAktPatientId || (typeof patientId !== 'undefined' ? patientId : null);
    if (!pid) return;
    var form = document.getElementById('custom-vet-report-form');
    if (form) form.reset();
    /* Reset to create mode */
    document.getElementById('cvr-edit-mode').value      = '';
    document.getElementById('cvr-edit-report-id').value = '';
    var titleEl = document.getElementById('cvr-modal-title');
    if (titleEl) titleEl.textContent = 'Tierarztbericht manuell verfassen';
    var lblEl = document.getElementById('cvr-save-btn-label');
    if (lblEl) lblEl.innerHTML = 'PDF generieren &amp; speichern';
    var nameEl = document.getElementById('cvr-patient-name');
    if (nameEl) {
        if (currentPatientData && currentPatientData.patient) {
            var p = currentPatientData.patient;
            var o = currentPatientData.owner;
            var info = p.name || '';
            if (p.species) info += ' \u00b7 ' + p.species;
            if (p.breed) info += ' (' + p.breed + ')';
            if (o) info += ' \u2014 ' + esc((o.first_name||'') + ' ' + (o.last_name||''));
            nameEl.textContent = info;

            /* Pre-fill recipient with patient's vet info if available */
            var recipEl = document.getElementById('cvr-recipient');
            if (recipEl && !recipEl.value && p.vet_name) {
                var vetInfo = p.vet_name;
                if (p.vet_address) vetInfo += ', ' + p.vet_address.replace(/\n/g, ', ');
                if (p.vet_phone) vetInfo += ' · Tel: ' + p.vet_phone;
                recipEl.value = vetInfo;
            }
        } else { nameEl.textContent = ''; }
    }
    var dateEl = document.getElementById('cvr-date-display');
    if (dateEl) {
        var now = new Date();
        dateEl.textContent = now.toLocaleDateString('de-DE', {day:'2-digit',month:'2-digit',year:'numeric'});
    }
    var el = document.getElementById('modal-custom-vet-report');
    var m = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el, {backdrop: false});
    m.show();
    /* init Quill rich-text editor for custom vet report */
    loadQuill(function() {
        if (!window.cvrQuill) {
            var editorEl = document.getElementById('cvr-quill-editor');
            if (!editorEl) return;
            window.cvrQuill = new Quill(editorEl, {
                theme: 'snow',
                placeholder: 'Sehr geehrte Kollegin, sehr geehrter Kollege,\n\nich berichte Ihnen über den Patienten…',
                modules: {
                    toolbar: [
                        [{ header: [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ color: [] }, { background: [] }],
                        [{ list: 'ordered' }, { list: 'bullet' }, { indent: '-1' }, { indent: '+1' }],
                        ['blockquote', 'code-block'],
                        [{ align: [] }],
                        ['link'],
                        ['clean']
                    ]
                }
            });
        } else {
            window.cvrQuill.setContents([]);
        }
        document.getElementById('cvr-editor-empty-warn').style.display = 'none';
    });
};

window.openEditVetReportModal = function(patientId, reportId) {
    if (!patientId || !reportId) return;
    /* Store patient id so submit handler can use it */
    window._vrChoicePatientId = patientId;

    /* Show modal immediately with loading state */
    var form = document.getElementById('custom-vet-report-form');
    if (form) form.reset();

    document.getElementById('cvr-edit-mode').value      = '1';
    document.getElementById('cvr-edit-report-id').value = String(reportId);

    var titleEl = document.getElementById('cvr-modal-title');
    if (titleEl) titleEl.textContent = 'Tierarztbericht bearbeiten';
    var lblEl = document.getElementById('cvr-save-btn-label');
    if (lblEl) lblEl.innerHTML = 'PDF aktualisieren &amp; speichern';

    /* Fill patient name from cached data */
    var nameEl = document.getElementById('cvr-patient-name');
    if (nameEl && currentPatientData && currentPatientData.patient) {
        var p = currentPatientData.patient;
        var o = currentPatientData.owner;
        var info = p.name || '';
        if (p.species) info += ' \u00b7 ' + p.species;
        if (p.breed) info += ' (' + p.breed + ')';
        if (o) info += ' \u2014 ' + esc((o.first_name||'') + ' ' + (o.last_name||''));
        nameEl.textContent = info;
    }
    var dateEl = document.getElementById('cvr-date-display');
    if (dateEl) {
        dateEl.textContent = new Date().toLocaleDateString('de-DE', {day:'2-digit',month:'2-digit',year:'numeric'});
    }

    var el = document.getElementById('modal-custom-vet-report');
    var m = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el, {backdrop: false});
    m.show();

    /* Show loading indicator in editor area */
    var editorEl = document.getElementById('cvr-quill-editor');
    if (editorEl) editorEl.style.opacity = '0.4';
    document.getElementById('btn-save-custom-vet-report').disabled = true;

    /* Load Quill, then fetch the report content */
    loadQuill(function() {
        if (!window.cvrQuill) {
            window.cvrQuill = new Quill(document.getElementById('cvr-quill-editor'), {
                theme: 'snow',
                placeholder: '',
                modules: {
                    toolbar: [
                        [{ header: [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ color: [] }, { background: [] }],
                        [{ list: 'ordered' }, { list: 'bullet' }, { indent: '-1' }, { indent: '+1' }],
                        ['blockquote', 'code-block'],
                        [{ align: [] }],
                        ['link'],
                        ['clean']
                    ]
                }
            });
        } else {
            /* Clear previous content before loading */
            window.cvrQuill.setContents([]);
        }

        fetch('/patienten/' + patientId + '/tierarztbericht/' + reportId + '/load')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.ok) {
                    alert('Fehler: ' + (data.error || 'Bericht konnte nicht geladen werden.'));
                    bootstrap.Modal.getInstance(document.getElementById('modal-custom-vet-report'))?.hide();
                    return;
                }
                /* Pre-fill recipient */
                var recipEl = document.getElementById('cvr-recipient');
                if (recipEl) recipEl.value = data.recipient || '';

                /* Pre-fill editor — plain text gets wrapped, HTML is pasted directly */
                var content = data.content || '';
                if (content) {
                    var looksHtml = /<\/?(?:p|br|ul|ol|li|h[1-6]|strong|em|b|i|u|s|blockquote)[>\s\/]/i.test(content);
                    if (looksHtml) {
                        window.cvrQuill.clipboard.dangerouslyPasteHTML(content);
                    } else {
                        /* Plain-text legacy: insert as plain text preserving line breaks */
                        window.cvrQuill.setText(content);
                    }
                } else {
                    window.cvrQuill.setContents([]);
                }

                document.getElementById('cvr-editor-empty-warn').style.display = 'none';
            })
            .catch(function(err) {
                alert('Netzwerkfehler: ' + err.message);
                bootstrap.Modal.getInstance(document.getElementById('modal-custom-vet-report'))?.hide();
            })
            .finally(function() {
                if (editorEl) editorEl.style.opacity = '';
                document.getElementById('btn-save-custom-vet-report').disabled = false;
            });
    });
};

document.getElementById('custom-vet-report-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    var pid = window._vrChoicePatientId || window.pdAktPatientId || (typeof patientId !== 'undefined' ? patientId : null) || window.customVetReportPatientId;
    if (!pid) return;

    /* Sync Quill HTML into hidden input */
    var warnEl = document.getElementById('cvr-editor-empty-warn');
    if (window.cvrQuill) {
        var html = window.cvrQuill.root.innerHTML;
        var isEmpty = !html || html === '<p><br></p>' || window.cvrQuill.getText().trim() === '';
        if (isEmpty) {
            if (warnEl) warnEl.style.display = '';
            return;
        }
        if (warnEl) warnEl.style.display = 'none';
        document.getElementById('cvr-content').value = html;
    }

    var isEditMode = document.getElementById('cvr-edit-mode').value === '1';
    var editReportId = document.getElementById('cvr-edit-report-id').value;
    var url = isEditMode
        ? '/patienten/' + pid + '/tierarztbericht/' + editReportId + '/update'
        : '/patienten/' + pid + '/tierarztbericht/custom';

    var btn = document.getElementById('btn-save-custom-vet-report');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>' + (isEditMode ? 'Aktualisiere...' : 'Generiere...');
    
    var fd = new FormData(this);
    try {
        var res = await fetch(url, {
            method: 'POST',
            body: fd
        });
        if (res.ok) {
            var rdata = await res.json().catch(function(){ return {ok:true}; });
            if (rdata.ok === false) {
                alert('Fehler: ' + (rdata.error || 'Unbekannter Fehler'));
            } else {
                bootstrap.Modal.getInstance(document.getElementById('modal-custom-vet-report'))?.hide();
                if (typeof _hwShowToast !== 'undefined') {
                    _hwShowToast(isEditMode ? 'Bericht aktualisiert.' : 'Bericht erstellt.', 'success');
                }
                if (window.pdAktPatientId && typeof loadVetReports !== 'undefined') {
                    document.getElementById('pd-vr-list').innerHTML = '<div style="text-align:center;padding:2rem;"><div class="pd-spinner"></div></div>';
                    _vrLoaded = false;
                    loadVetReports(pid);
                } else {
                    location.reload();
                }
            }
        } else {
            var errData = await res.json().catch(function(){ return {}; });
            alert('Fehler beim Speichern: ' + (errData.error || res.status));
        }
    } catch (err) {
        console.error(err);
        alert('Fehler: ' + err.message);
    } finally {
        btn.disabled = false;
        var svgIcon = '<svg width="14" height="14" fill="none" viewBox="0 0 24 24" style="vertical-align:middle;margin-right:0.4rem;margin-top:-2px;"><path stroke="currentColor" stroke-width="2" d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline stroke="currentColor" stroke-width="2" points="14 2 14 8 20 8"/></svg>';
        var lblEl2 = document.getElementById('cvr-save-btn-label');
        if (lblEl2) {
            btn.innerHTML = svgIcon + '<span id="cvr-save-btn-label">' + (isEditMode ? 'PDF aktualisieren &amp; speichern' : 'PDF generieren &amp; speichern') + '</span>';
        } else {
            btn.innerHTML = svgIcon + 'PDF generieren &amp; speichern';
        }
    }
});

window.sendVetReportEmail = function(patientId, reportId, btn) {
    if (!confirm('Tierarztbericht per E-Mail an den Tierhalter senden?')) return;
    var origText = btn ? btn.innerHTML : '';
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:10px;height:10px;"></span>'; }
    var fd = new FormData();
    fd.append('_csrf_token', '{{ csrf_token }}');
    fetch('/patienten/' + patientId + '/tierarztbericht/' + reportId + '/email', {
        method: 'POST',
        headers: {'X-Requested-With': 'XMLHttpRequest'},
        body: fd
    })
    .then(function(r){ return r.json(); })
    .then(function(data) {
        if (btn) { btn.disabled = false; btn.innerHTML = origText; }
        if (data.ok) {
            _hwShowToast('E-Mail erfolgreich an ' + (data.email || 'Tierhalter') + ' gesendet!', 'success');
        } else {
            alert('Fehler: ' + (data.error || 'E-Mail konnte nicht gesendet werden.'));
        }
    })
    .catch(function() {
        if (btn) { btn.disabled = false; btn.innerHTML = origText; }
        alert('Netzwerkfehler beim Senden.');
    });
};

window.deleteVetReport = function(patientId, reportId, btn) {
    if (!confirm('Diesen Tierarztbericht wirklich löschen?')) return;
    var card = btn ? btn.closest('[style*="border-radius:10px"]') : null;
    fetch('/patienten/' + patientId + '/tierarztbericht/' + reportId, {
        method: 'DELETE',
        headers: {'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': '{{ csrf_token }}'}
    })
    .then(function(r){ return r.json(); })
    .then(function(data) {
        if (data.ok) {
            if (card) card.remove();
            else { _vrLoaded = false; loadVetReports(patientId); }
        } else {
            alert('Fehler: ' + (data.error || 'Löschen fehlgeschlagen.'));
        }
    })
    .catch(function() { alert('Netzwerkfehler.'); });
};

