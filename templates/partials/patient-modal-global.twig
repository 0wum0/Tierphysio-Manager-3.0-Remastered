document.addEventListener('click', function(ev) {
    var btn = ev.target.closest('.cvr-tpl-btn');
    if (!btn) return;
    var tpl = btn.dataset.tpl;
    if (!tpl || !_cvrTemplates[tpl]) return;
    if (!window.cvrQuill) return;
    var isEmpty = window.cvrQuill.getText().trim() === '';
    if (!isEmpty && !confirm('Aktuellen Inhalt mit Vorlage überschreiben?')) return;
    window.cvrQuill.clipboard.dangerouslyPasteHTML(_cvrTemplates[tpl]);
    setTimeout(function(){ window.cvrQuill.focus(); }, 50);
});

/* ═══════════════════════════════════════════════════════
   BEFUND-TIERAUSWAHL — öffnet sich beim Klick auf
   "Befundung starten" im Patienten-Modal.
   Self-Heal: fällt zurück auf direkte Navigation falls
   Bootstrap-Modal nicht verfügbar ist.
═══════════════════════════════════════════════════════ */
document.addEventListener('click', function(ev) {
    var btn = ev.target.closest('#pd-befunde-new-link');
    if (!btn) return;
    ev.preventDefault();

    var patientId      = btn.dataset.patientId      || '';
    var patientSpecies = btn.dataset.patientSpecies || '';
    var patientName    = btn.dataset.patientName    || '';

    if (!patientId) {
        console.warn('[pd-befund-species] kein patientId — abort');
        return;
    }

    var modalEl = document.getElementById('modal-pd-befund-species');
    if (!modalEl || typeof bootstrap === 'undefined' || !bootstrap.Modal) {
        // Fallback: direkt navigieren
        window.location.href = '/patienten/' + patientId + '/befunde/neu';
        return;
    }

    // Subtitle
    var sub = document.getElementById('pd-bs-subtitle');
    if (sub) {
        sub.innerHTML = 'Patient: <strong>' + escapeHtmlPd(patientName || '–') + '</strong>'
                      + (patientSpecies ? ' · ' + escapeHtmlPd(patientSpecies) : '');
    }

    // Empfehlung berechnen
    var suggested = resolveSpeciesSuggestion(patientSpecies);

    // Alle Kacheln konfigurieren
    modalEl.querySelectorAll('.befund-species-card').forEach(function(card) {
        var sp = card.getAttribute('data-species');
        card.setAttribute('href', '/patienten/' + patientId + '/befunde/neu?species=' + encodeURIComponent(sp));
        card.classList.toggle('is-suggested', sp === suggested);
    });

    try {
        bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop: true }).show();
    } catch (e) {
        console.error('[pd-befund-species] Modal konnte nicht geöffnet werden:', e);
        window.location.href = '/patienten/' + patientId + '/befunde/neu';
    }
});

/* ═══════════════════════════════════════════════════════
   BEFUND SPECIES CARD — öffnet vollständiges Befundformular
   INLINE im Modal. Kein Seitenwechsel.
═══════════════════════════════════════════════════════ */
document.addEventListener('click', function(ev) {
    var card = ev.target.closest('.befund-species-card');
    if (!card) return;
    ev.preventDefault();
    ev.stopPropagation();

    var species   = card.getAttribute('data-species') || 'dog';
    var patientId = window.pdAktPatientId || '';
    if (!patientId) return;

    var speciesModal = document.getElementById('modal-pd-befund-species');
    if (speciesModal) {
        try { var m = bootstrap.Modal.getInstance(speciesModal); if (m) m.hide(); } catch (e) {}
    }

    openBefundInlineForm(patientId, species);
});

