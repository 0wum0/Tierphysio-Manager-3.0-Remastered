/* --- TCP Fortschritt --- */
function loadTcpData(patientId) {
    if (_tcpLoaded) return;
    _tcpLoaded = true;
    var listEl      = document.getElementById('pd-fortschritt-list');
    var naturalSec  = document.getElementById('pd-natural-section');
    var naturalList = document.getElementById('pd-natural-list');
    var tcpRepSec   = document.getElementById('pd-tcp-reports-section');
    var tcpRepList  = document.getElementById('pd-tcp-reports-list');

    fetch('/api/tcp/patienten/'+patientId+'/modal-data', {headers:{'X-Requested-With':'XMLHttpRequest'}})
        .then(function(r){return r.json();})
        .then(function(data) {
            if (!data.ok) { listEl.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--bs-secondary-color);font-size:0.85rem;">TherapyCare Pro nicht aktiv.</div>'; return; }
            var cats   = data.categories || [];
            var latest = data.latest     || [];
            if (!cats.length) { listEl.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--bs-secondary-color);font-size:0.85rem;">Keine Kategorien konfiguriert.</div>'; return; }

            var html = '';
            /* Current values */
            if (latest.length) {
                html += '<div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--bs-secondary-color);margin-bottom:0.35rem;">Aktuelle Werte</div>';
                latest.forEach(function(e) {
                    var color = esc(e.category_color || '#4f7cff');
                    var pct = Math.max(0,Math.min(100,Math.round(((+e.score-(+e.scale_min||1))/((+e.scale_max||10)-(+e.scale_min||1)))*100)));
                    var date = e.entry_date ? e.entry_date.substring(0,10).split('-').reverse().join('.') : '';
                    html += '<div style="display:flex;align-items:center;gap:0.45rem;padding:0.35rem 0.6rem;border-radius:9px;background:var(--bs-secondary-bg);border:1px solid var(--bs-border-color);margin-bottom:0.32rem;">';
                    html += '<div style="width:8px;height:8px;border-radius:50%;flex-shrink:0;background:'+color+';"></div>';
                    html += '<div style="flex:1;min-width:0;"><div style="font-size:0.75rem;font-weight:600;">'+esc(e.category_name||'')+'</div><div class="tcp-progress-bar" style="margin-top:0.1rem;"><div class="tcp-progress-bar-fill" style="width:'+pct+'%;background:'+color+';"></div></div></div>';
                    html += '<div style="text-align:right;flex-shrink:0;"><div style="font-size:0.78rem;font-weight:700;color:'+color+';">'+esc(String(e.score))+'</div><div style="font-size:0.6rem;color:var(--bs-secondary-color);">'+esc(date)+'</div></div>';
                    html += '</div>';
                });
                html += '<div style="border-top:1px solid var(--bs-border-color);margin:0.6rem 0;"></div>';
            }
            /* Slider form */
            html += '<div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--bs-secondary-color);margin-bottom:0.4rem;">Neue Werte erfassen</div>';
            html += _tcpBuildSliders(cats, patientId, true);
            listEl.innerHTML = html;

            /* Naturheilkunde */
            var natural = data.natural || [];
            if (natural.length && naturalSec && naturalList) {
                naturalSec.style.display = '';
                var hn = '';
                natural.slice(0,4).forEach(function(e) {
                    var date2 = e.entry_date ? e.entry_date.substring(0,10).split('-').reverse().join('.') : '';
                    hn += '<div style="display:flex;align-items:center;gap:0.5rem;padding:0.4rem 0.6rem;border-radius:7px;background:var(--bs-secondary-bg);border:1px solid var(--bs-border-color);margin-bottom:0.3rem;">';
                    hn += '<svg width="12" height="12" fill="none" viewBox="0 0 24 24" style="flex-shrink:0;opacity:0.5;"><path stroke="currentColor" stroke-width="2" d="M12 2a10 10 0 010 20M12 2C6.5 2 2 6.5 2 12"/></svg>';
                    hn += '<div style="flex:1;min-width:0;font-size:0.78rem;font-weight:600;">'+esc(e.type_name||e.custom_type||'')+'</div>';
                    hn += '<span style="font-size:0.68rem;color:var(--bs-secondary-color);">'+esc(date2)+'</span>';
                    hn += '</div>';
                });
                naturalList.innerHTML = hn;
            }
            /* Verlaufsgrafik */
            var chartData = data.chart || null;
            var chartWrap = document.getElementById('pd-tcp-chart-wrap');
            if (chartData && chartData.datasets && chartData.datasets.length && chartWrap) {
                chartWrap.style.display = '';
                function _drawTcpModalChart() {
                    var ctx = document.getElementById('pd-tcp-chart');
                    if (!ctx) return;
                    if (ctx._ci) { ctx._ci.destroy(); }
                    var isDark = document.documentElement.getAttribute('data-bs-theme') !== 'light';
                    var gc = isDark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
                    var tc = isDark ? 'rgba(255,255,255,0.6)'  : 'rgba(0,0,0,0.55)';
                    ctx._ci = new Chart(ctx, {
                        type: 'line', data: chartData,
                        options: {
                            responsive: true, maintainAspectRatio: false,
                            interaction: { mode: 'index', intersect: false },
                            plugins: { legend: { display: true, labels: { color: tc, usePointStyle: true, pointStyle: 'circle', padding: 10, font: { size: 10 } } } },
                            scales: {
                                x: { grid: { color: gc }, ticks: { color: tc, font: { size: 10 } } },
                                y: { min: 1, max: 10, grid: { color: gc }, ticks: { color: tc, font: { size: 10 }, stepSize: 1 } }
                            }
                        }
                    });
                }
                if (typeof Chart === 'undefined') {
                    var _cs = document.createElement('script');
                    _cs.src = 'https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js';
                    _cs.onload = _drawTcpModalChart;
                    document.head.appendChild(_cs);
                } else { _drawTcpModalChart(); }
            }

            /* ─── VORHER / NACHHER MEDIEN (Sprint A · L1.1) ─────────
               Rendert Upload-Form-Select, Galerie und Story-Button.
               Alle IDs sind in patient-modal-global.twig hartkodiert;
               deshalb keine Rerender-Listen nötig. */
            _tcpRenderMedia(patientId, data);

            /* TCP Berichte */
            var reports = data.reports || [];
            if (reports.length && tcpRepSec && tcpRepList) {
                tcpRepSec.style.display = '';
                var hr = '';
                reports.slice(0,4).forEach(function(r) {
                    var date3 = r.created_at ? r.created_at.substring(0,10).split('-').reverse().join('.') : '';
                    hr += '<div style="display:flex;align-items:center;gap:0.5rem;padding:0.4rem 0.6rem;border-radius:7px;background:var(--bs-secondary-bg);border:1px solid var(--bs-border-color);margin-bottom:0.3rem;">';
                    hr += '<svg width="12" height="12" fill="none" viewBox="0 0 24 24" style="flex-shrink:0;opacity:0.5;"><path stroke="currentColor" stroke-width="2" d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline stroke="currentColor" stroke-width="2" points="14 2 14 8 20 8"/></svg>';
                    hr += '<div style="flex:1;min-width:0;font-size:0.78rem;font-weight:600;">'+esc(r.title||'Therapiebericht')+' <span style="font-size:0.68rem;color:var(--bs-secondary-color);">'+esc(date3)+'</span></div>';
                    hr += '<a href="/patienten/'+patientId+'/berichte/'+r.id+'/download" target="_blank" class="btn btn-sm btn-outline-secondary" style="font-size:0.7rem;">Öffnen</a>';
                    hr += '</div>';
                });
                tcpRepList.innerHTML = hr;
            }
        })
        .catch(function() { /* TCP Plugin nicht aktiv */ });
}

/* ═════════════════════════════════════════════════════════════════
   TCP MEDIEN (Vorher/Nachher) – Modal-Akte (Sprint A · L1.1)
   ───────────────────────────────────────────────────────────────
   Rendert Galerie + Upload-Form im Patienten-Modal, ohne die
   bestehende Vollansicht zu verlassen. Komplett vanilla — keine
   neuen Abhängigkeiten.
   ═════════════════════════════════════════════════════════════════ */
function _tcpRenderMedia(patientId, data) {
    var section   = document.getElementById('pd-tcp-media-section');
    if (!section) return;

    var entrySel  = document.getElementById('pd-tcp-media-entry-sel');
    var gallery   = document.getElementById('pd-tcp-media-gallery');
    var emptyEl   = document.getElementById('pd-tcp-media-empty');
    var countEl   = document.getElementById('pd-tcp-media-count');
    var csrfInput = document.getElementById('pd-tcp-media-csrf');
    var storyBtn  = document.getElementById('pd-tcp-story-btn');
    var form      = document.getElementById('pd-tcp-media-form');

    var entries = data.entries_brief || [];
    var media   = data.media          || [];
    var base    = data.media_url_base || ('/patienten/'+patientId+'/fortschritt/media');
    var story   = data.story_url      || ('/patienten/'+patientId+'/fortschritt/story');
    var csrf    = data.csrf_token     || '';

    if (csrfInput) csrfInput.value = csrf;

    /* Eintrags-Dropdown befüllen (chron. absteigend) */
    if (entrySel) {
        entrySel.innerHTML = '<option value="">— Eintrag zur Zuordnung wählen —</option>';
        entries.slice().reverse().forEach(function(e) {
            var d = (e.entry_date || '').substring(0,10).split('-').reverse().join('.');
            var opt = document.createElement('option');
            opt.value = e.id;
            opt.textContent = d + ' · ' + (e.category_name||'') + ' (' + e.score + '/' + e.scale_max + ')';
            entrySel.appendChild(opt);
        });
        /* onchange → setzt form.action auf entsprechenden /media Endpoint */
        entrySel.onchange = function() {
            form.action = '/patienten/' + patientId + '/fortschritt/' + (this.value || 0) + '/media';
        };
    }

    /* Story-Button: nur sichtbar wenn Medien existieren */
    if (storyBtn) {
        storyBtn.href = story;
        storyBtn.style.display = media.length > 0 ? '' : 'none';
    }

    /* Galerie — gruppiert pro Eintrag */
    if (countEl) countEl.textContent = media.length + ' Datei' + (media.length === 1 ? '' : 'en');

    if (!media.length) {
        if (gallery) gallery.innerHTML = '';
        if (emptyEl) emptyEl.style.display = '';
        return;
    }
    if (emptyEl) emptyEl.style.display = 'none';

    /* Gruppierung: progress_entry_id → [m,...] */
    var byEntry = {};
    media.forEach(function(m) {
        var k = String(m.progress_entry_id);
        (byEntry[k] = byEntry[k] || []).push(m);
    });

    var html = '';
    entries.slice().reverse().forEach(function(e) {
        var list = byEntry[String(e.id)] || [];
        if (!list.length) return;
        var d = (e.entry_date || '').substring(0,10).split('-').reverse().join('.');
        html += '<div style="border:1px solid var(--bs-border-color);border-radius:8px;padding:.45rem;margin-bottom:.45rem;background:var(--bs-secondary-bg);">';
        html += '<div style="display:flex;align-items:center;gap:.35rem;margin-bottom:.35rem;font-size:.72rem;">';
        html += '<span style="width:7px;height:7px;border-radius:50%;background:'+esc(e.category_color||'#4f7cff')+';"></span>';
        html += '<strong>'+esc(d)+'</strong>';
        html += '<span style="color:var(--bs-secondary-color);">· '+esc(e.category_name||'')+' · '+e.score+'/'+e.scale_max+'</span>';
        html += '<span style="margin-left:auto;color:var(--bs-secondary-color);font-size:.65rem;">'+list.length+'×</span>';
        html += '</div>';
        html += '<div style="display:flex;flex-wrap:wrap;gap:.3rem;">';
        list.forEach(function(m) {
            var phase = (m.phase_label || 'verlauf').toString();
            var phaseColor = phase === 'vorher' ? '#f59e0b'
                           : (phase === 'nachher' ? '#16a34a' : '#6c757d');
            html += '<div style="position:relative;width:64px;">';
            html += '<a href="'+esc(base+'/'+m.id)+'" target="_blank" rel="noopener" style="display:block;aspect-ratio:1/1;background:#000;border-radius:6px;overflow:hidden;border:1px solid var(--bs-border-color);">';
            if (m.media_type === 'image') {
                html += '<img src="'+esc(base+'/'+m.id)+'" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;">';
            } else if (m.media_type === 'video') {
                html += '<div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;background:#222;color:#fff;"><svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><polygon points="6 4 20 12 6 20 6 4"/></svg></div>';
            } else {
                html += '<div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;background:#444;color:#fff;font-size:.55rem;">AUDIO</div>';
            }
            html += '</a>';
            html += '<span style="position:absolute;top:2px;left:2px;background:'+phaseColor+';color:#fff;font-size:.5rem;font-weight:700;padding:1px 4px;border-radius:99px;line-height:1;">'+phase.substring(0,1).toUpperCase()+'</span>';
            html += '<button type="button" data-pd-tcp-media-del="'+m.id+'" style="position:absolute;top:2px;right:2px;background:#dc3545;color:#fff;border:0;border-radius:50%;width:14px;height:14px;font-size:9px;line-height:1;padding:0;cursor:pointer;">×</button>';
            html += '</div>';
        });
        html += '</div></div>';
    });

    if (gallery) {
        gallery.innerHTML = html;
        /* Delete-Handler wire-up */
        gallery.querySelectorAll('[data-pd-tcp-media-del]').forEach(function(btn) {
            btn.addEventListener('click', function() {
                if (!confirm('Datei wirklich löschen?')) return;
                var mid = btn.getAttribute('data-pd-tcp-media-del');
                var fd = new FormData();
                fd.append('_csrf_token', csrf);
                fetch('/patienten/'+patientId+'/fortschritt/media/'+mid+'/loeschen', {
                    method: 'POST',
                    headers: {'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},
                    body: fd
                }).then(function(){
                    /* Cache invalidieren und Modal-Daten neu holen. */
                    _tcpLoaded = false;
                    loadTcpData(patientId);
                    _hwShowToast('Datei gelöscht.', 'success');
                }).catch(function(){ _hwShowToast('Fehler beim Löschen.','danger'); });
            });
        });
    }

    /* Upload-Handler (nur einmal binden — Form lebt im DOM) */
    if (form && !form._tcpBound) {
        form._tcpBound = true;
        form.addEventListener('submit', function(ev) {
            ev.preventDefault();
            var entryId = entrySel ? entrySel.value : '';
            if (!entryId) { _hwShowToast('Bitte Eintrag wählen.','warning'); return; }
            var btn = form.querySelector('button[type="submit"]');
            var orig = btn ? btn.innerHTML : '';
            if (btn) { btn.disabled = true; btn.textContent = 'Lade…'; }
            var fd = new FormData(form);
            fetch('/patienten/'+patientId+'/fortschritt/'+entryId+'/media', {
                method: 'POST',
                headers: {'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},
                body: fd
            }).then(function(r){ return r.text(); })
              .then(function(){
                  if (btn) { btn.disabled = false; btn.innerHTML = orig; }
                  form.reset();
                  _tcpLoaded = false;
                  loadTcpData(patientId);
                  _hwShowToast('Hochgeladen.','success');
              }).catch(function(){
                  if (btn) { btn.disabled = false; btn.innerHTML = orig; }
                  _hwShowToast('Upload fehlgeschlagen.','danger');
              });
        });
    }
}
window._tcpRenderMedia = _tcpRenderMedia;

/* ─── TCP SLIDER BUILDER ───────────────────────────────────────── */
function _tcpBuildSliders(cats, patientId, compact) {
    var today = new Date().toISOString().slice(0,10);
    var sfx   = compact ? 'c' : 'f';
    var formId = 'tcp-sf-'+(compact?'c':'f')+'-'+patientId;
    var html  = '<form id="'+formId+'">';
    html += '<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">';
    if (!compact) {
        html += '<div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.75rem;">';
        html += '<label style="font-size:0.78rem;font-weight:600;flex-shrink:0;margin:0;">Datum</label>';
        html += '<input type="date" name="entry_date" class="form-control form-control-sm" value="'+today+'" style="max-width:165px;">';
        html += '</div>';
    } else {
        html += '<input type="hidden" name="entry_date" value="'+today+'">';
    }
    html += '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax('+(compact?'240px':'320px')+',1fr));gap:'+(compact?'0.45rem':'0.6rem')+';">';
    cats.forEach(function(cat) {
        var mid = Math.round((+cat.scale_max + +cat.scale_min) / 2);
        var c   = esc(cat.color || '#4f7cff');
        var uid = 'tcs-'+cat.id+'-'+sfx;
        html += '<div style="padding:'+(compact?'0.45rem 0.55rem':'0.6rem 0.7rem')+';border:1px solid var(--bs-border-color);border-radius:10px;background:var(--bs-body-bg);">';
        html += '<div style="display:flex;align-items:center;gap:0.45rem;margin-bottom:0.25rem;">';
        html += '<div style="width:8px;height:8px;border-radius:50%;background:'+c+';flex-shrink:0;"></div>';
        html += '<span style="font-size:0.8rem;font-weight:600;">'+esc(cat.name)+'</span>';
        html += '<span style="font-size:0.66rem;color:var(--bs-secondary-color);">('+cat.scale_min+'\u2013'+cat.scale_max+')</span>';
        html += '<span style="font-size:0.82rem;font-weight:700;color:'+c+';margin-left:auto;" id="'+uid+'">'+mid+'</span>';
        html += '</div>';
        html += '<input type="range" class="form-range" name="entries['+cat.id+']" min="'+cat.scale_min+'" max="'+cat.scale_max+'" value="'+mid+'" style="margin:0;" oninput="document.getElementById(\''+uid+'\').textContent=this.value">';
        html += '<div style="display:flex;justify-content:space-between;font-size:0.65rem;color:var(--bs-secondary-color);margin-top:0.08rem;"><span>'+esc(cat.scale_label_min||'')+'</span><span>'+esc(cat.scale_label_max||'')+'</span></div>';
        if (!compact) {
            html += '<input type="text" name="notes_'+cat.id+'" class="form-control form-control-sm mt-1" placeholder="Notiz (optional)" style="font-size:0.76rem;height:30px;">';
        }
        html += '</div>';
    });
    html += '</div>';
    html += '<button type="button" class="btn btn-primary btn-sm w-100" style="margin-top:0.25rem;" onclick="_saveTcpProgress(event,'+patientId+',document.getElementById(\''+formId+'\'),'+compact+')">Werte speichern</button>';
    html += '</form>';
    return html;
}

function _saveTcpProgress(event, patientId, form, compact) {
    if (event && event.preventDefault) event.preventDefault();
    var btn = form ? form.querySelector('[type="button"].btn-primary') : null;
    var orig = btn ? btn.textContent : 'Werte speichern';
    if (btn) { btn.disabled = true; btn.textContent = 'Speichern\u2026'; }
    /* Update hidden date for compact form to today */
    var hiddenDate = form.querySelector('input[type="hidden"][name="entry_date"]');
    if (hiddenDate) hiddenDate.value = new Date().toISOString().slice(0,10);
    fetch('/patienten/'+patientId+'/fortschritt', {
        method: 'POST',
        headers: {'X-Requested-With': 'XMLHttpRequest'},
        body: new FormData(form)
    })
    .then(function(r){ return r.json(); })
    .then(function(data) {
        if (btn) { btn.disabled = false; btn.textContent = orig; }
        if (data.ok) {
            _tcpCache = null;
            _hwShowToast(data.saved + ' Werte gespeichert.', 'success');
            /* Reset sliders to midpoint */
            form.querySelectorAll('input[type="range"]').forEach(function(s) {
                s.value = Math.round((+s.max + +s.min) / 2);
                s.dispatchEvent(new Event('input'));
            });
            form.querySelectorAll('input[type="text"]').forEach(function(i){ i.value = ''; });
            /* Reload full view history if open */
            if (!compact) {
                var fvEl = document.getElementById('modal-tcp-fullview');
                if (fvEl && fvEl.classList.contains('show')) {
                    fetch('/api/tcp/patienten/'+patientId+'/fortschritt', {headers:{'X-Requested-With':'XMLHttpRequest'}})
                        .then(function(r){return r.json();})
                        .then(function(pd) {
                            if (_tcpCache === null) _tcpCache = {entries:[],natural:[],reports:[],cats:[]};
                            _tcpCache.entries = pd.entries || [];
                            /* Preserve other panels, only re-render progress */
                            var cache = _tcpCache;
                            fetch('/api/tcp/patienten/'+patientId+'/modal-data', {headers:{'X-Requested-With':'XMLHttpRequest'}})
                                .then(function(r){return r.json();})
                                .then(function(md) {
                                    _tcpCache = {entries: pd.entries||[], natural: md.natural||[], reports: md.reports||[], cats: md.categories||[]};
                                    _tcpfvRender(_tcpCache, patientId);
                                });
                        });
                }
            }
        } else {
            if (btn) { btn.disabled = false; btn.textContent = orig; }
            alert('Fehler beim Speichern: ' + (data.error || 'Unbekannter Fehler'));
        }
    })
    .catch(function(err) { if (btn) { btn.disabled = false; btn.textContent = orig; } alert('Netzwerkfehler: ' + err); });
}

/* ─── TCP FULL VIEW MODAL ──────────────────────────────────────── */
var _tcpCache = null;

function _tcpfvTab(tab) {
    ['progress','natural','reports'].forEach(function(t) {
        var btn = document.getElementById('tcpfv-tab-'+t);
        var pan = document.getElementById('tcpfv-panel-'+t);
        if (btn) btn.classList.toggle('active', t === tab);
        if (pan) pan.style.display = (t === tab) ? '' : 'none';
    });
}


/* make inline tcp handlers globally reachable for modal HTML onclick/data hooks */
window._tcpfvTab = _tcpfvTab;
window._saveTcpProgress = _saveTcpProgress;



document.querySelectorAll('[data-tcpfv-tab]').forEach(function(btn){
    btn.addEventListener('click', function(){ _tcpfvTab(btn.getAttribute('data-tcpfv-tab')); });
});

window.openTcpFullView = function(activeTab) {
    var patientId = window.pdAktPatientId || (currentPatientData && currentPatientData.patient ? currentPatientData.patient.id : null);
    if (!patientId) return;
    var p = currentPatientData && currentPatientData.patient;
    var subEl = document.getElementById('tcpfv-subtitle');
    if (subEl && p) subEl.textContent = (p.name||'') + (p.species ? ' \u00b7 ' + p.species : '');
    var modalEl = document.getElementById('modal-tcp-fullview');
    var m = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl, {backdrop: false});
    m.show();
    _tcpfvTab(activeTab || 'progress');
    if (_tcpCache) { _tcpfvRender(_tcpCache, patientId); return; }
    fetch('/api/tcp/patienten/'+patientId+'/modal-data', {headers:{'X-Requested-With':'XMLHttpRequest'}})
        .then(function(r){return r.json();})
        .then(function(md) {
            if (!md.ok) throw new Error('TCP nicht aktiv');
            return fetch('/api/tcp/patienten/'+patientId+'/fortschritt', {headers:{'X-Requested-With':'XMLHttpRequest'}})
                .then(function(r){return r.json();})
                .then(function(pd) {
                    _tcpCache = {entries: pd.entries||[], natural: md.natural||[], reports: md.reports||[], cats: md.categories||[]};
                    _tcpfvRender(_tcpCache, patientId);
                });
        })
        .catch(function() {
            ['progress','natural','reports'].forEach(function(t) {
                var el = document.getElementById('tcpfv-panel-'+t);
                if (el) el.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--bs-secondary-color);font-size:0.85rem;">Daten nicht verf\u00fcgbar \u2014 TherapyCare Pro Plugin pr\u00fcfen.</div>';
            });
        });
};

function _tcpfvRender(cache, patientId) {
    /* Fortschritt */
    var progEl = document.getElementById('tcpfv-panel-progress');
    if (progEl) {
        var html = '';
        /* Slider form at top of full view */
        if (cache.cats && cache.cats.length) {
            html += '<div style="border:1px solid var(--bs-border-color);border-radius:12px;padding:0.9rem 1rem;margin-bottom:1rem;background:linear-gradient(180deg,var(--bs-secondary-bg),var(--bs-body-bg));">';
            html += '<div style="font-weight:600;font-size:0.82rem;margin-bottom:0.75rem;color:var(--bs-primary);">Neue Werte erfassen</div>';
            html += _tcpBuildSliders(cache.cats, patientId, false);
            html += '</div>';
        }
        /* History */
        if (!cache.entries.length) {
            html += '<div style="text-align:center;padding:2rem;color:var(--bs-secondary-color);font-size:0.85rem;">Noch keine Fortschrittsdaten vorhanden.</div>';
        } else {
            var byCat = {};
            cache.entries.forEach(function(e) {
                var cid = e.category_id||0;
                if (!byCat[cid]) byCat[cid] = {name:e.category_name||'',color:e.category_color||'#4f7cff',sMin:+(e.scale_min||1),sMax:+(e.scale_max||10),entries:[]};
                byCat[cid].entries.push(e);
            });
            Object.values(byCat).forEach(function(cat) {
                var c = esc(cat.color);
                html += '<div style="margin-bottom:0.8rem;border:1px solid var(--bs-border-color);border-radius:10px;overflow:hidden;background:var(--bs-body-bg);">';
                html += '<div style="padding:0.6rem 0.85rem;background:var(--bs-secondary-bg);border-bottom:1px solid var(--bs-border-color);display:flex;align-items:center;gap:0.55rem;">';
                html += '<div style="width:10px;height:10px;border-radius:50%;background:'+c+';flex-shrink:0;"></div>';
                html += '<span style="font-weight:600;font-size:0.85rem;">'+esc(cat.name)+'</span>';
                html += '<span style="font-size:0.68rem;color:var(--bs-secondary-color);margin-left:auto;">Skala '+cat.sMin+'\u2013'+cat.sMax+'</span>';
                html += '</div>';
                cat.entries.forEach(function(e) {
                    var pct = Math.max(0,Math.min(100,Math.round(((+e.score-cat.sMin)/(cat.sMax-cat.sMin))*100)));
                    var date = e.entry_date ? e.entry_date.substring(0,10).split('-').reverse().join('.') : '';
                    html += '<div style="padding:0.45rem 0.85rem;border-bottom:1px solid var(--bs-border-color);display:flex;align-items:center;gap:0.7rem;">';
                    html += '<div style="font-size:0.75rem;color:var(--bs-secondary-color);width:68px;flex-shrink:0;">'+esc(date)+'</div>';
                    html += '<div style="flex:1;"><div class="tcp-progress-bar"><div class="tcp-progress-bar-fill" style="width:'+pct+'%;background:'+c+';"></div></div></div>';
                    html += '<div style="font-size:0.85rem;font-weight:700;color:'+c+';width:28px;text-align:right;flex-shrink:0;">'+esc(String(e.score))+'</div>';
                    html += '</div>';
                    if (e.notes) { html += '<div style="padding:0.2rem 0.85rem 0.4rem;font-size:0.72rem;color:var(--bs-secondary-color);border-bottom:1px solid var(--bs-border-color);">'+esc(e.notes)+'</div>'; }
                });
                html += '</div>';
            });
        }
        progEl.innerHTML = html;
    }
    /* Naturheilkunde */
    var natEl = document.getElementById('tcpfv-panel-natural');
    if (natEl) {
        if (!cache.natural.length) {
            natEl.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--bs-secondary-color);font-size:0.85rem;">Noch keine Naturheilkunde-Eintr\u00e4ge vorhanden.</div>';
        } else {
            var hn = '';
            cache.natural.forEach(function(e) {
                var date = e.entry_date ? e.entry_date.substring(0,10).split('-').reverse().join('.') : '';
                hn += '<div style="padding:0.65rem 0.85rem;border:1px solid var(--bs-border-color);border-radius:8px;margin-bottom:0.45rem;">';
                hn += '<div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;flex-wrap:wrap;">';
                hn += '<span style="font-size:0.85rem;font-weight:600;">\ud83c\udf3f '+esc(e.type_name||e.custom_type||'Naturheilkunde')+'</span>';
                hn += '<span style="font-size:0.72rem;color:var(--bs-secondary-color);">'+esc(date)+(e.recorded_by_name?' \u00b7 '+esc(e.recorded_by_name):'')+'</span>';
                hn += '</div>';
                if (e.dosage||e.frequency) {
                    hn += '<div style="font-size:0.75rem;color:var(--bs-secondary-color);margin-top:0.2rem;">';
                    if (e.dosage) hn += 'Dosierung: <strong>'+esc(e.dosage)+'</strong> ';
                    if (e.frequency) hn += '\u00b7 Frequenz: <strong>'+esc(e.frequency)+'</strong>';
                    hn += '</div>';
                }
                if (e.notes) hn += '<div style="font-size:0.78rem;margin-top:0.3rem;">'+esc(e.notes)+'</div>';
                hn += '</div>';
            });
            natEl.innerHTML = hn;
        }
    }
    /* Therapieberichte */
    var repEl = document.getElementById('tcpfv-panel-reports');
    if (repEl) {
        if (!cache.reports.length) {
            repEl.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--bs-secondary-color);font-size:0.85rem;">Noch keine Therapieberichte vorhanden.</div>';
        } else {
            var hr = '';
            cache.reports.forEach(function(r) {
                var date = r.created_at ? r.created_at.substring(0,10).split('-').reverse().join('.') : '';
                hr += '<div style="padding:0.6rem 0.85rem;border:1px solid var(--bs-border-color);border-radius:8px;margin-bottom:0.45rem;display:flex;align-items:center;gap:0.75rem;">';
                hr += '<svg width="16" height="16" fill="none" viewBox="0 0 24 24" style="flex-shrink:0;opacity:0.45;"><path stroke="currentColor" stroke-width="2" d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline stroke="currentColor" stroke-width="2" points="14 2 14 8 20 8"/></svg>';
                hr += '<div style="flex:1;min-width:0;"><div style="font-size:0.85rem;font-weight:600;">'+esc(r.title||'Therapiebericht')+'</div>';
                hr += '<div style="font-size:0.72rem;color:var(--bs-secondary-color);">'+esc(date)+(r.created_by_name?' \u00b7 '+esc(r.created_by_name):'')+'</div></div>';
                hr += '<a href="/patienten/'+patientId+'/berichte/'+r.id+'/download" target="_blank" class="btn btn-sm btn-outline-secondary" style="font-size:0.72rem;white-space:nowrap;">Herunterladen</a>';
                hr += '</div>';
            });
            repEl.innerHTML = hr;
        }
    }
}

/* --- Portal Checks --- */
function loadPortalChecks(patientId) {
    if (_portalLoaded) return;
    _portalLoaded = true;
    var container = document.getElementById('pd-portal-list');
    var countEl   = document.getElementById('pd-portal-count');
    fetch('/api/patienten/'+patientId+'/portal-checks', {headers:{'Accept':'application/json'}})
        .then(function(r){return r.json();})
        .then(function(data) {
            var items = data.items || [];
            if (countEl && items.length) { countEl.textContent = items.length; countEl.style.display = ''; }
            if (!items.length) { container.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--bs-secondary-color);font-size:0.85rem;">Noch keine abgehakten Aufgaben im Besitzerportal.</div>'; return; }
            var html = '';
            items.forEach(function(n) {
                var color = n.type === 'homework' ? '#22c55e' : '#4f7cff';
                var bgc   = n.type === 'homework' ? 'rgba(34,197,94,0.1)' : 'rgba(79,124,255,0.1)';
                html += '<div style="display:flex;align-items:center;gap:0.65rem;padding:0.55rem 0.75rem;border-radius:8px;background:var(--bs-secondary-bg);border:1px solid var(--bs-border-color);margin-bottom:0.4rem;">';
                html += '<div style="width:26px;height:26px;border-radius:7px;background:'+bgc+';display:flex;align-items:center;justify-content:center;flex-shrink:0;">';
                html += n.type==='homework' ? '<svg width="13" height="13" fill="none" viewBox="0 0 24 24"><path stroke="'+color+'" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>' : '<svg width="13" height="13" fill="none" viewBox="0 0 24 24"><path stroke="'+color+'" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>';
                html += '</div>';
                html += '<div style="flex:1;min-width:0;"><div style="font-size:0.82rem;font-weight:600;">'+esc(n.task_title)+'</div><div style="font-size:0.72rem;color:var(--bs-secondary-color);">'+esc(n.owner_name)+' · '+(n.type==='homework'?'Hausaufgabe':'Übung')+' · '+esc(n.created_at ? new Date(n.created_at).toLocaleDateString('de-DE') : '')+'</div></div>';
                html += '<span style="font-size:0.68rem;padding:2px 8px;border-radius:6px;background:rgba(34,197,94,0.1);color:#22c55e;border:1px solid rgba(34,197,94,0.2);white-space:nowrap;">✓ Abgehakt</span>';
                html += '</div>';
            });
            container.innerHTML = html;
        })
        .catch(function() { container.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--bs-secondary-color);font-size:0.85rem;">Portal-Daten nicht verfügbar.</div>'; });
}

/* --- Hausaufgabenpläne --- */
var _hwTemplates = [];
function loadHwPlans(patientId) {
    if (_hwLoaded) return;
    _hwLoaded = true;
    var container = document.getElementById('pd-hw-plans-list');
    fetch('/api/patients/'+patientId+'/plans', {headers:{'Accept':'application/json'}})
        .then(function(r){return r.json().then(function(d){return {ok:r.ok,d:d};});})
        .then(function(res) {
            if (!res.ok || !Array.isArray(res.d)) { container.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--bs-secondary-color);font-size:0.85rem;">'+(res.ok?'Noch keine Hausaufgabenpläne vorhanden.<br><br><button class="btn btn-primary btn-sm" onclick="openCreatePlanModal()">Ersten Plan erstellen</button>':'Fehler beim Laden der Pläne.')+'</div>'; return; }
            var plans = res.d;
            if (!plans.length) { container.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--bs-secondary-color);font-size:0.85rem;">Noch keine Hausaufgabenpläne vorhanden.<br><br><button class="btn btn-primary btn-sm" onclick="openCreatePlanModal()">Ersten Plan erstellen</button></div>'; return; }
            var html = '';
            plans.forEach(function(plan) {
                var badge = plan.status==='active' ? '<span class="badge text-bg-success ms-2" style="font-size:0.68rem;">Aktiv</span>' : '<span class="badge text-bg-secondary ms-2" style="font-size:0.68rem;">Archiviert</span>';
                var taskRows = (plan.tasks||[]).map(function(t) {
                    return '<div style="font-size:0.78rem;padding:0.3rem 0.5rem;border-bottom:1px solid var(--bs-border-color);">📋 '+esc(t.title)+(t.frequency?' — '+esc(t.frequency):'')+(t.duration?' ('+esc(t.duration)+')':"")+'</div>';
                }).join('');
                html += '<div style="border:1px solid var(--bs-border-color);border-radius:10px;margin-bottom:0.75rem;overflow:hidden;">';
                html += '<div style="padding:0.65rem 0.85rem;background:var(--bs-secondary-bg);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.35rem;">';
                html += '<div><span class="fw-600" style="font-size:0.85rem;">📅 Plan vom '+(plan.plan_date ? new Date(plan.plan_date).toLocaleDateString('de-DE') : '—')+'</span>'+badge+(plan.therapist_name?'<span class="text-muted ms-2" style="font-size:0.75rem;">· '+esc(plan.therapist_name)+'</span>':'')+'</div>';
                html += '<div class="d-flex gap-1"><a href="/portal-admin/hausaufgaben/'+plan.id+'/pdf" target="_blank" class="btn btn-sm btn-outline-secondary" style="font-size:0.72rem;">PDF</a><button class="btn btn-sm btn-outline-danger" style="font-size:0.72rem;" onclick="_deletePlan('+plan.id+')">Löschen</button></div>';
                html += '</div>';
                if (taskRows) html += '<div>'+taskRows+'</div>';
                if (plan.general_notes) html += '<div style="padding:0.4rem 0.85rem;font-size:0.78rem;color:var(--bs-secondary-color);">📝 '+esc(plan.general_notes)+'</div>';
                html += '</div>';
            });
            container.innerHTML = html;
        })
        .catch(function() { container.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--bs-secondary-color);font-size:0.85rem;">Pläne konnten nicht geladen werden.</div>'; });
}

/* ═══════════════════════════════════════════════════════
   OPEN PATIENT MODAL (main entry point)
═══════════════════════════════════════════════════════ */
function openPatientModal(patientId) {
    window.pdAktPatientId = patientId;
    resetModal();
    bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-patient-detail')).show();
    initQuill();

    fetch('/patienten/'+patientId+'/json')
        .then(function(r){return r.json();})
        .then(function(data) {
            var p = data.patient;
            var o = data.owner;

            /* Header */
            document.getElementById('pd-name').textContent = p.name || '';
            if (p.status) {
                var badge = document.getElementById('pd-badge');
                badge.textContent  = p.status;
                badge.className    = 'badge badge-'+(p.status||'').toLowerCase().replace(/ /g,'_');
                badge.style.display = '';
            }
            document.getElementById('pd-species').textContent = [p.species,p.breed].filter(Boolean).join(' · ');

            /* Photo */
            if (p.photo) {
                var _pawSrc = '/assets/img/placeholder-paw.svg';
                var _fotoSrc = '/patienten/'+patientId+'/foto/'+p.photo;
                var imgH = document.createElement('img');
                imgH.style.cssText = 'width:100%;height:100%;object-fit:cover;';
                imgH.onerror = function() { if (this.src !== _pawSrc) { this.src = _pawSrc; this.style.objectFit = 'contain'; } };
                imgH.src = _fotoSrc;
                var ph = document.getElementById('pd-photo');
                ph.innerHTML = ''; ph.appendChild(imgH);
                var imgF = document.createElement('img');
                imgF.alt = p.name||'';
                imgF.onerror = function() { if (this.src !== _pawSrc) { this.src = _pawSrc; this.style.objectFit = 'contain'; } };
                imgF.src = _fotoSrc;
                var pf = document.getElementById('pd-photo-full');
                pf.innerHTML = ''; pf.appendChild(imgF);
            }

            /* Info grid */
            function detail(label, value) { return value ? '<div><span>'+esc(label)+'</span><div>'+esc(value)+'</div></div>' : ''; }
            document.getElementById('pd-details').innerHTML =
                detail('Tierart', p.species) + detail('Rasse', p.breed) +
                detail('Geschlecht', p.gender) + detail('Geb.', p.birth_date ? fmtDate(p.birth_date) : null) +
                detail('Farbe', p.color) + detail('Chip-Nr.', p.chip_number) +
                (p.notes ? '<div style="grid-column:1/-1;border-top:1px solid var(--bs-border-color);padding-top:0.4rem;margin-top:0.1rem;"><span>Notizen</span><div style="font-size:0.78rem;line-height:1.5;color:var(--bs-secondary-color);">'+esc(p.notes)+'</div></div>' : '') +
                (p.vet_name ? '<div style="grid-column:1/-1;border-top:1px solid var(--bs-border-color);padding-top:0.5rem;margin-top:0.2rem;"><div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--bs-secondary-color);margin-bottom:0.3rem;">🩺 Haustierarzt</div><div style="font-size:0.82rem;font-weight:600;">'+esc(p.vet_name)+'</div>'+(p.vet_phone?'<div style="font-size:0.78rem;color:var(--bs-secondary-color);">'+esc(p.vet_phone)+'</div>':'')+(p.vet_address?'<div style="font-size:0.75rem;color:var(--bs-secondary-color);white-space:pre-line;">'+esc(p.vet_address)+'</div>':'')+'</div>' : '');

            /* Owner */
            if (o) {
                var knr = 'Kunden-Nr. '+String(o.id).padStart(4,'0');
                document.getElementById('pd-owner').innerHTML =
                    '<a href="/tierhalter/'+o.id+'" class="pd-owner-link">'
                    +'<div class="pd-owner-avatar">'+esc((o.first_name||'').charAt(0)+(o.last_name||'').charAt(0))+'</div>'
                    +'<div><div class="pd-owner-name">'+esc(o.first_name+' '+o.last_name)+' <span style="font-size:0.68rem;color:var(--bs-primary);background:rgba(79,124,255,0.1);padding:1px 6px;border-radius:999px;">'+esc(knr)+'</span></div>'
                    +(o.phone?'<div class="pd-owner-meta">'+esc(o.phone)+'</div>':'')
                    +(o.email?'<div class="pd-owner-meta">'+esc(o.email)+'</div>':'')
                    +'</div></a>';
            } else {
                document.getElementById('pd-owner').innerHTML = '<span style="color:var(--bs-secondary-color);font-size:0.82rem;">Kein Besitzer</span>';
            }

            /* Treatment types for entry form */
            var ttSel = document.getElementById('pd-treatment-type');
            if (ttSel && data.treatment_types) {
                ttSel.innerHTML = '<option value="">— keine —</option>';
                data.treatment_types.forEach(function(tt) {
                    var opt = document.createElement('option');
                    opt.value = tt.id; opt.textContent = tt.name; opt.dataset.color = tt.color;
                    ttSel.appendChild(opt);
                });
            }

            /* Timeline form action */
            var pdForm = document.getElementById('pd-timeline-form');
            if (pdForm) { pdForm.action='/patienten/'+patientId+'/timeline'; pdForm.dataset.patientId=patientId; }

            /* Befund new button → öffnet Tierauswahl-Modal */
            var bfnl = document.getElementById('pd-befunde-new-link');
            if (bfnl) {
                bfnl.dataset.patientId      = patientId;
                bfnl.dataset.patientSpecies = (data.patient && data.patient.species) ? data.patient.species : '';
                bfnl.dataset.patientName    = (data.patient && data.patient.name)    ? data.patient.name    : '';
            }

            /* Vet report links */
            var vrl = document.getElementById('pd-vet-report-btn');
            if (vrl) vrl.href = '/patienten/'+patientId+'/tierarztbericht';
            var vrn = document.getElementById('pd-vr-new-link');
            if (vrn) vrn.href = '/patienten/'+patientId+'/tierarztbericht';
            var vrnM = document.getElementById('pd-vr-new-link-menu');
            if (vrnM) vrnM.href = '/patienten/'+patientId+'/tierarztbericht';

            /* Rechnungs-Badge */
            var existBadge = document.getElementById('pd-invoice-badge');
            if (existBadge) existBadge.remove();
            if (data.invoice_stats && (data.invoice_stats.open_count > 0 || data.invoice_stats.paid_count > 0)) {
                var ib = document.createElement('span');
                ib.id = 'pd-invoice-badge';
                ib.style.cssText = 'flex-shrink:0;padding:0.15rem 0.45rem;border-radius:5px;font-size:0.65rem;font-weight:700;cursor:pointer;white-space:nowrap;';
                if (data.invoice_stats.open_count > 0) {
                    ib.style.background='rgba(220,53,69,0.18)'; ib.style.color='#ff6b6b'; ib.style.border='1.5px solid #dc3545';
                    ib.textContent = data.invoice_stats.open_count+' offen';
                } else {
                    ib.style.background='rgba(25,135,84,0.15)'; ib.style.color='#2dbe6c'; ib.style.border='1.5px solid #198754';
                    ib.textContent = '✓ Bezahlt';
                }
                var nameEl = document.getElementById('pd-name');
                if (nameEl && nameEl.parentNode) nameEl.parentNode.insertBefore(ib, document.getElementById('pd-badge').nextSibling);
            }

            currentPatientData = data;

            /* Render initial tab data */
            renderTimeline(data.timeline, patientId);
            renderAppointments(data.appointments || [], data.patient);

            /* Show body */
            document.getElementById('pd-loading').style.display = 'none';
            document.getElementById('pd-body').style.display    = 'flex';
        })
        .catch(function() {
            document.getElementById('pd-loading').innerHTML = '<div style="color:var(--bs-secondary-color);font-size:0.85rem;">Fehler beim Laden der Patientendaten.</div>';
        });
}

