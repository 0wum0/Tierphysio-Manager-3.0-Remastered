/* ═══════════════════════════════════════════════════════
   TIMELINE FORM SUBMIT (AJAX)
═══════════════════════════════════════════════════════ */
function initQuill() {
    loadQuill(function() {
        if (quillEditor) return;
        var el = document.getElementById('pd-quill-editor');
        if (!el || el.children.length > 1) return; // already initialized
        quillEditor = new Quill(el, {
            theme: 'snow',
            placeholder: 'Notizen, Befunde, Behandlungsschritte...',
            modules: { toolbar: [['bold','italic','underline','strike'],[{list:'ordered'},{list:'bullet'}],['blockquote'],[{color:[]}],['clean']] }
        });
    });
}

document.addEventListener('submit', function(e) {
    var form = e.target;
    if (form.id !== 'pd-timeline-form') return;
    e.preventDefault();
    var hidden = document.getElementById('pd-content-input');
    if (hidden && quillEditor) hidden.value = quillEditor.root.innerHTML;
    var patientId = form.dataset.patientId;
    if (!patientId) return;
    var btn = form.querySelector('[type=submit]');
    var origHtml = btn ? btn.innerHTML : '';
    var fileInput = document.getElementById('pd-attachment');
    var files = fileInput && fileInput.files ? Array.from(fileInput.files) : [];

    var progressWrap = document.getElementById('pd-upload-progress');
    var uploadBar   = document.getElementById('pd-upload-bar');
    var uploadLabel = document.getElementById('pd-upload-label');
    function setProgress(pct, label) { progressWrap.style.display=''; uploadBar.style.width=pct+'%'; if(label && uploadLabel) uploadLabel.textContent=label; }
    function hideProgress() { progressWrap.style.display='none'; uploadBar.style.width='0%'; }

    if (btn) { btn.disabled=true; btn.innerHTML='<span class="pd-spinner" style="width:13px;height:13px;border-width:2px;display:inline-block;vertical-align:middle;"></span> Speichern…'; }

    var csrfToken = form.querySelector('[name="_csrf_token"]').value;

    function submitEntry(uploadedFilenames) {
        var fd = new FormData(form);
        fd.delete('attachment');
        if (uploadedFilenames && uploadedFilenames.length > 0) {
            uploadedFilenames.forEach(function(fn) { fd.append('uploaded_filenames[]', fn); });
        }
        fetch('/patienten/'+patientId+'/timeline-json', {method:'POST',body:fd})
            .then(function(r){return r.json();})
            .then(function(data) {
                if (data.ok) {
                    renderTimeline(data.timeline, patientId);
                    form.reset(); if(quillEditor) quillEditor.setContents([]);
                    hideProgress(); _hwShowToast('✓ Eintrag gespeichert','success');
                } else { _hwShowToast('Fehler beim Speichern.','error'); }
            })
            .catch(function(){ _hwShowToast('Netzwerkfehler.','error'); })
            .finally(function(){ if(btn){btn.disabled=false;btn.innerHTML=origHtml;} });
    }

    if (files.length === 0) {
        submitEntry([]);
        return;
    }

    /* Alle Dateien sequenziell hochladen, Filenames sammeln */
    (async function() {
        var uploadedFilenames = [];
        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            var uploadFile = file;
            var isVideo = file.type.startsWith('video/');
            var baseProgress = Math.round(i / files.length * 100);
            var nextProgress = Math.round((i + 1) / files.length * 100);

            try {
                if (isVideo && window.MediaCompressor && window.MediaCompressor.shouldCompress(file)) {
                    setProgress(baseProgress, 'Video ' + (i+1) + '/' + files.length + ' komprimieren…');
                    uploadFile = await window.MediaCompressor.compress(file, function(p){
                        setProgress(Math.round(baseProgress + p * (nextProgress - baseProgress) * 0.5), 'Komprimieren ' + Math.round(p*100) + '%');
                    });
                }
            } catch (compErr) {
                console.warn('[Timeline] compression fallback:', compErr);
                uploadFile = file;
            }

            setProgress(Math.round(baseProgress + (nextProgress - baseProgress) * 0.5),
                'Hochladen ' + (i+1) + ' von ' + files.length + '…');

            try {
                var filename = await new Promise(function(resolve, reject) {
                    var xhr = new XMLHttpRequest();
                    xhr.open('POST', '/patienten/'+patientId+'/attachment-upload', true);
                    xhr.upload.addEventListener('progress', function(ev){
                        if (ev.lengthComputable) {
                            var pct = Math.round(baseProgress + (nextProgress - baseProgress) * 0.5
                                      + ev.loaded/ev.total * (nextProgress - baseProgress) * 0.5);
                            setProgress(pct, 'Upload ' + (i+1) + '/' + files.length);
                        }
                    });
                    xhr.addEventListener('load', function(){
                        if (xhr.status === 200) {
                            try { var resp = JSON.parse(xhr.responseText); if (resp.ok) { resolve(resp.filename); return; } } catch(ex) {}
                        }
                        reject(new Error('Upload-Fehler (HTTP ' + xhr.status + ')'));
                    });
                    xhr.addEventListener('error', function(){ reject(new Error('Netzwerkfehler')); });
                    var fd2 = new FormData();
                    fd2.append('_csrf_token', csrfToken);
                    fd2.append('attachment', uploadFile, file.name);
                    xhr.send(fd2);
                });
                uploadedFilenames.push(filename);
            } catch (uploadErr) {
                hideProgress();
                if (btn) { btn.disabled=false; btn.innerHTML=origHtml; }
                _hwShowToast('Upload fehlgeschlagen: ' + file.name, 'error');
                return;
            }
        }

        setProgress(100, 'Speichern…');
        submitEntry(uploadedFilenames);
    })();
},true);

